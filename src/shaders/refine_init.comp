#version 460
#extension GL_GOOGLE_include_directive : require
#include "refine_common.glsl"

layout(local_size_x = 64) in;

// The fallback's list of blocks (refine_flag.comp), emptied here for the field's fallback
layout(std430, set = 0, binding = 15) buffer Flagged { uint dispatchX; uint dispatchY; uint dispatchZ; uint flagged[]; };

// Every seed of every block: its SAD, kept for the passes, and the seed of the lowest cost (its SAD
// with its penalty, SeedPenalty) as the block's starting vector, ties to the earlier seed, by one
// minimum over the group. kGroupBlocks blocks per workgroup in a row, kGroupLanes lanes per block, lane i of each 8
// measuring seeds i, i + 8, ... (kSplit). Dispatched as ((nbx + kGroupBlocks - 1) / kGroupBlocks,
// nby) workgroups.
void main() {
    if (gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u && gl_LocalInvocationIndex == 0u) {
        dispatchX = 0u;
        dispatchY = 1u;
        dispatchZ = 1u;
    }
    uint lane = WorkgroupLane();
    int group = int(lane) / kGroupLanes, sub = int(lane & 7u), inGroup = int(lane) & (kGroupLanes - 1);
    gHalf = inGroup >> 3;
    int by = int(gl_WorkGroupID.y), bx = int(gl_WorkGroupID.x) * kGroupBlocks + group;
    bool live = bx < pc.nbx;
    bx = min(bx, pc.nbx - 1);
    int b = by * pc.nbx + bx;
    LoadBlock(group, inGroup, kGroupLanes, bx, by, live);
    barrier();

    int count = live ? seedCount[b] : 0;
    uint64_t mine = kNoKey;
    ivec2 myV = ivec2(0);
    uint myS = 0u;
    for (int k = sub; k < count; k += 8) {
        ivec2 v = seeds[b * pc.maxSeeds + k];
        uint s = LaneSad(v);
        if (gHalf == 0)
            seedSad[b * pc.maxSeeds + k] = s;
        uint64_t key = CandidateKey(int64_t(s) + Penalty(s, SeedPenalty(k)), k);
        if (key < mine) {
            mine = key;
            myV = v;
            myS = s;
        }
    }
    uint64_t win = subgroupClusteredMin(mine, 8u);
    int owner = KeyLane(win);
    ivec2 best = ivec2(FromLane(myV.x, owner, 8), FromLane(myV.y, owner, 8));
    uint bestSad = uint(FromLane(int(myS), owner, 8));
    if (win == kNoKey) {
        best = ivec2(0);
        bestSad = 0xFFFFFFFFu;
    }
    if (live && inGroup == 0) {
        vecA[b] = best;
        sadA[b] = bestSad;
        lastChange[b] = 0;
        lastEval[b] = -1;
    }
}
