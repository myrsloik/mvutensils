#version 460
#extension GL_GOOGLE_include_directive : require
#include "refine_common.glsl"

layout(local_size_x = 64) in;

// The fallback's list of blocks (refine_flag.comp), emptied here for the field's fallback
layout(std430, set = 0, binding = 15) buffer Flagged { uint dispatchX; uint dispatchY; uint dispatchZ; uint flagged[]; };

// Every seed of every block: its SAD, kept for the passes, and the lowest as the block's starting
// vector, ties to the earlier seed, by one minimum over the group (the SAD in CandidateKey's cost
// place). 8 blocks per workgroup in a row, 8 lanes per block, lane i measuring seeds i, i + 8, ...
// Dispatched as ((nbx + 7) / 8, nby) workgroups.
void main() {
    if (gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u && gl_LocalInvocationIndex == 0u) {
        dispatchX = 0u;
        dispatchY = 1u;
        dispatchZ = 1u;
    }
    uint lane = WorkgroupLane();
    int group = int(lane >> 3u), sub = int(lane & 7u);
    int by = int(gl_WorkGroupID.y), bx = int(gl_WorkGroupID.x) * 8 + group;
    bool live = bx < pc.nbx;
    bx = min(bx, pc.nbx - 1);
    int b = by * pc.nbx + bx;
    LoadBlock(group, sub, 8, bx, by, live);
    barrier();

    int count = live ? seedCount[b] : 0;
    uint64_t mine = kNoKey;
    ivec2 myV = ivec2(0);
    int myS = 0;
    for (int k = sub; k < count; k += 8) {
        ivec2 v = seeds[b * pc.maxSeeds + k];
        int s = LaneSad(v);
        seedSad[b * pc.maxSeeds + k] = s;
        uint64_t key = CandidateKey(int64_t(s), k);
        if (key < mine) {
            mine = key;
            myV = v;
            myS = s;
        }
    }
    uint64_t win = subgroupClusteredMin(mine, 8u);
    int owner = KeyLane(win);
    ivec2 best = ivec2(FromLane(myV.x, owner, 8), FromLane(myV.y, owner, 8));
    int bestSad = FromLane(myS, owner, 8);
    if (win == kNoKey) {
        best = ivec2(0);
        bestSad = 0x7FFFFFFF;
    }
    if (live && sub == 0) {
        vecA[b] = best;
        sadA[b] = bestSad;
        lastChange[b] = 0;
        lastEval[b] = -1;
    }
}
