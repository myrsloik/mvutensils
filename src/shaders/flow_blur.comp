#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "flow_common.glsl"

layout(local_size_x = 64) in;

// mvu.FlowBlur's pixel of the plane (FlowBlur.cpp's FlowBlur_scalar): the frame's own super, bound as
// src, sampled along the pixel's forward (F, bound as vecF) and backward (B, as vecB) vectors scaled by
// blur256 (pc.time256), (largest component / prec) >> 8 samples each way, prec being pc.time4096FX, and
// averaged with the pixel itself; or the clip's pixel where either vector frame is at a scene change
// (counts[0] or counts[1] above the limit). Integer sums are exact as mvu's int64 ones; float sums in
// double, as mvu's, exact for ordinary sample values, so that their order doesn't matter (a device
// without doubles sums floats in float). Dispatched as ((width + 63) / 64, height) workgroups per plane.

// C++'s a / b for b > 0, truncated toward zero
int DivT(int a, int b) {
    return a >= 0 ? a / b : -(-a / b);
}

void main() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_WorkGroupID.y);
    if (x >= pc.width)
        return;
    uint at = uint(y * pc.outStride + x);
    uint limit = uint(pc.scdLimit);
    if (counts[0] > limit || counts[1] > limit) {
        uint c = uint(y * pc.clipStride + x);
        if (kFloat)
            outPxF[at] = clipSrcF[c];
        else if (kWide)
            outPx16[at] = clipSrc16[c];
        else
            outPx[at] = clipSrc[c];
        return;
    }
    Weights(x, y);
    ivec2 vF = VectorAt(0), vB = VectorAt(1);
    int blur = pc.time256, prec = pc.time4096FX;
    int vxF0 = vF.x * blur, vyF0 = vF.y * blur, vxB0 = vB.x * blur, vyB0 = vB.y * blur;
    int mF = (max(abs(vxF0), abs(vyF0)) / prec) >> 8, mB = (max(abs(vxB0), abs(vyB0)) / prec) >> 8;
    int xBase = x * kPel, yBase = y * kPel;
    // Each way's steps: the scaled vector divided by its count, truncated as C++ divides
    int dxF = mF > 0 ? DivT(vxF0, mF) : 0, dyF = mF > 0 ? DivT(vyF0, mF) : 0;
    int dxB = mB > 0 ? DivT(vxB0, mB) : 0, dyB = mB > 0 ? DivT(vyB0, mB) : 0;
    uint n = uint(mF + mB + 1);
    if (kFloat) {
#if MVGPU_FLOAT64
        double sum = double(SampleF(false, xBase, yBase));
#else
        float sum = SampleF(false, xBase, yBase);
#endif
        int vx = dxF, vy = dyF;
        for (int i = 0; i < mF; ++i) {
            sum += SampleF(false, (vx >> 8) + xBase, (vy >> 8) + yBase);
            vx += dxF;
            vy += dyF;
        }
        vx = dxB;
        vy = dyB;
        for (int i = 0; i < mB; ++i) {
            sum += SampleF(false, (vx >> 8) + xBase, (vy >> 8) + yBase);
            vx += dxB;
            vy += dyB;
        }
#if MVGPU_FLOAT64
        outPxF[at] = float(sum / double(n));
#else
        outPxF[at] = sum / float(n);
#endif
        return;
    }
    uint64_t sum = uint64_t(Sample(false, xBase, yBase));
    int vx = dxF, vy = dyF;
    for (int i = 0; i < mF; ++i) {
        sum += uint64_t(Sample(false, (vx >> 8) + xBase, (vy >> 8) + yBase));
        vx += dxF;
        vy += dyF;
    }
    vx = dxB;
    vy = dyB;
    for (int i = 0; i < mB; ++i) {
        sum += uint64_t(Sample(false, (vx >> 8) + xBase, (vy >> 8) + yBase));
        vx += dxB;
        vy += dyB;
    }
    uint result = sum <= uint64_t(0xFFFFFFFFu) ? uint(sum) / n : uint(sum / uint64_t(n));
    if (kWide)
        outPx16[at] = uint16_t(result);
    else
        outPx[at] = uint8_t(result);
}
