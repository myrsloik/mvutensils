#version 460
#extension GL_GOOGLE_include_directive : require
#include "refine_common.glsl"

layout(local_size_x = 64) in;

// The field's output: the vector frame mvgpu.Analyse attaches, a record (x, y, SAD, 0) per
// block, rows pc.recStride records apart
layout(std430, set = 0, binding = 26) writeonly buffer OutRec { ivec4 outRec[]; };

// pel 4: MVUtensils' SAD of the lane's block at quarter-pel vector v. Every luma sample is computed
// from the super's half-pel planes as mvu.Super's quarter planes hold it: the sample of the half-pel
// grid where the position is on it, else the rounded average of its two neighbours on the grid, or
// of the two vertical averages where both coordinates fall between. Every lane reads the four runs
// of its position's neighbours, the two of a coordinate on the grid being the same run: the 8
// positions around a vector all differ in phase, so reading only what each needs would only make
// the lanes diverge (probe/qpel_bench.cpp measured it slower). Chroma comes from its quarter-pel
// image, unless the SAD is luma's alone.
int LaneSadQuarter(ivec2 v) {
    int cur = gGroup * kBlockWords;
    uint sa = 0u, sm = 0u;
    int X = 4 * (gX + pc.pad) + v.x, Y = 4 * (gY + pc.pad) + v.y;
    int Xa = X >> 1, Xb = Xa + (X & 1), Ya = Y >> 1, Yb = Ya + (Y & 1);
    uint plane = uint(pc.wp * pc.hp);
    uint aa = HalfAddr(Xa, Ya, plane, pc.wp), ab = HalfAddr(Xa, Yb, plane, pc.wp), ba = HalfAddr(Xb, Ya, plane, pc.wp), bb = HalfAddr(Xb, Yb, plane, pc.wp);
    for (int j = 0; j < pc.blockRows; ++j) {
        uint o = uint(j * pc.wp), r0[kRowWords], r1[kRowWords], r2[kRowWords], r3[kRowWords];
        RunY(aa + o, r0);
        RunY(ab + o, r1);
        RunY(ba + o, r2);
        RunY(bb + o, r3);
        [[unroll]] for (int i = 0; i < kRowWords; ++i)
            PackedStep(Avg(Avg(r0[i], r1[i]), Avg(r2[i], r3[i])), cur + j * kRowWords + i, sa, sm);
    }
    if (!kChroma)
        return int(sa + gSumCur - 2u * sm);
    int Xc = 4 * (gX / 2 + pc.padc) + ChromaComponent(v.x), Yc = 4 * (gY / 2 + pc.padc) + ChromaComponent(v.y);
    uint ac = ChromaAddr(Xc, Yc);
    int curU = cur + kLumaWords;
    for (int j = 0; j < pc.blockRows / 2; ++j) {
        [[unroll]] for (int p = 0; p < 2; ++p) {
            uint r[kRowWordsC];
            RunC(ac + uint(p) * ChromaV() + uint(j * ChromaRow()), r);
            int at = curU + p * kChromaWords + j * kRowWordsC;
            [[unroll]] for (int i = 0; i < kRowWordsC; ++i)
                PackedStep(r[i], at + i, sa, sm);
        }
    }
    return int(sa + gSumCur - 2u * sm);
}

// pel 4: the 8 quarter-pel positions around each block's vector, against its neighbours as the
// half-pel step left them: Analyse.cpp binds the half-pel step's field (B) as field A here. Like
// refine_halfpel.comp, 8 blocks per workgroup in a row, lane i of a block's group measuring position
// i, the best by one minimum of CandidateKey over the group, anywhere in the range
// ValidateVectors accepts; writes the output. Dispatched as ((nbx + 7) / 8, nby) workgroups.
void main() {
    uint lane = WorkgroupLane();
    int group = int(lane >> 3u), sub = int(lane & 7u);
    int by = int(gl_WorkGroupID.y), bx = int(gl_WorkGroupID.x) * 8 + group;
    bool live = bx < pc.nbx;
    bx = min(bx, pc.nbx - 1);
    int b = by * pc.nbx + bx;
    LoadBlock(group, sub, 8, bx, by, live);
    barrier();

    ivec2 p;
    int64_t lambda;
    Context(b, p, lambda);
    ivec2 c0 = vecA[b];
    ivec2 best = c0;
    int bestSad = sadA[b];
    int64_t bestCost = Cost(bestSad, best, p, lambda);
    ivec2 v = ClampVec(c0 + Around(sub, 1));
    int s = live ? LaneSadQuarter(v) : 0;
    uint64_t win = subgroupClusteredMin(live && v != c0 ? CandidateKey(Cost(s, v, p, lambda), sub) : kNoKey, 8u);
    int owner = KeyLane(win);
    ivec2 wv = ivec2(FromLane(v.x, owner, 8), FromLane(v.y, owner, 8));
    int ws = FromLane(s, owner, 8);
    if (win != kNoKey && KeyCost(win) < bestCost) {
        best = wv;
        bestSad = ws;
    }
    if (live && sub == 0)
        outRec[by * pc.recStride + bx] = ivec4(best, bestSad, 0);
}
