#version 460
#extension GL_GOOGLE_include_directive : require
#define NO_BLOCK_CACHE
#define SUPER_BUILD
#include "refine_common.glsl"

layout(local_size_x = 64) in;

// The frame as it arrives, 8-bit 4:2:0: its Y, U and V planes, rows pc.srcStrideY and
// pc.srcStrideC bytes apart
layout(std430, set = 0, binding = 29) readonly buffer RawY { uint8_t rawY[]; };
layout(std430, set = 0, binding = 30) readonly buffer RawU { uint8_t rawU[]; };
layout(std430, set = 0, binding = 31) readonly buffer RawV { uint8_t rawV[]; };

// A frame's level-0 super planes built on the GPU, exactly as mvu.Super builds them at pel 2 with
// sharp=2 (SuperPyramid.cpp's CopyAndPadPlane and GeneratePelPlanes, the CPU reference's MakePlane):
// the frame extended to the block-aligned size the grid covers and padded by pad on every side,
// edges repeated, then the x + 1/2, y + 1/2 and diagonal planes by the Wiener filter over the
// padded plane, averages near its edges. Written in the layout the kernels read: per plane (Y at
// binding 0, U then V at binding 2) the full-pel plane and the three half-pel planes, rows pc.wp
// or pc.wc bytes apart, pc.hp or pc.hc rows. Step pc.level: 0 the full-pel planes from the raw
// frame; 1 the x + 1/2 and y + 1/2 planes from them; 2 the diagonal plane from the y + 1/2 plane.
// Each lane makes 4 pixels of a row, read and written as whole words (rows start on whole words;
// the last word of a row may run into the row's padding, which nothing reads), 256 pixels of a row
// per workgroup, the plane (Y, U, V) in z; dispatched as ((W + 255) / 256, H, 3) with W x H the
// padded luma size.

int gW, gH;               // the plane's padded size
int gStride, gPlaneBytes; // its rows apart, and its sub-planes apart, in bytes
int gBase;                // where its full-pel plane starts in its buffer

uint Word(int i, int x, int y) { // the word holding pixels x .. x + 3 of row y of sub-plane i, x a multiple of 4
    int at = (gBase + i * gPlaneBytes + y * gStride + x) >> 2;
    return gl_WorkGroupID.z == 0u ? curYW[at] : curCW[at];
}

void PutWord(int i, int x, int y, uint v) {
    int at = (gBase + i * gPlaneBytes + y * gStride + x) >> 2;
    if (gl_WorkGroupID.z == 0u)
        curYW[at] = v;
    else
        curCW[at] = v;
}

uint Byte(uint w, int k) {
    return bitfieldExtract(w, 8 * k, 8);
}

uint Avg(uint a, uint b) {
    return (a + b + 1u) >> 1u;
}

uint Wiener(uint m0, uint m1, uint m2, uint m3, uint m4, uint m5) {
    int m = ((int(m2 + m3) * 4 - int(m1 + m4)) * 5 + int(m0 + m5) + 16) >> 5;
    return uint(clamp(m, 0, 255));
}

// SuperPyramid.cpp's HorizontalWiener of sub-plane i at pixels x .. x + 3 of row y, packed. s[j]
// holds pixel x - 4 + j of the row; the words past either end of a row are read but not used.
uint HorizontalWiener4(int i, int x, int y) {
    uint w0 = x >= 4 ? Word(i, x - 4, y) : 0u, w1 = Word(i, x, y), w2 = Word(i, x + 4, y);
    uint s[12];
    [[unroll]] for (int k = 0; k < 4; ++k) {
        s[k] = Byte(w0, k);
        s[4 + k] = Byte(w1, k);
        s[8 + k] = Byte(w2, k);
    }
    uint word = 0u;
    [[unroll]] for (int k = 0; k < 4; ++k) {
        int xo = x + k, j = 4 + k;
        uint v;
        if (xo < 2 || (xo >= gW - 4 && xo < gW - 1))
            v = Avg(s[j], s[j + 1]);
        else if (xo == gW - 1)
            v = s[j];
        else
            v = Wiener(s[j - 2], s[j - 1], s[j], s[j + 1], s[j + 2], s[j + 3]);
        word |= v << (8 * k);
    }
    return word;
}

// And its VerticalWiener, from the words of rows y - 2 .. y + 3 holding the same 4 columns
uint VerticalWiener4(int i, int x, int y) {
    uint r[6];
    [[unroll]] for (int k = 0; k < 6; ++k)
        r[k] = Word(i, x, clamp(y - 2 + k, 0, gH - 1));
    uint word = 0u;
    [[unroll]] for (int k = 0; k < 4; ++k) {
        uint v;
        if (y < 2 || (y >= gH - 4 && y < gH - 1))
            v = Avg(Byte(r[2], k), Byte(r[3], k));
        else if (y == gH - 1)
            v = Byte(r[2], k);
        else
            v = Wiener(Byte(r[0], k), Byte(r[1], k), Byte(r[2], k), Byte(r[3], k), Byte(r[4], k), Byte(r[5], k));
        word |= v << (8 * k);
    }
    return word;
}

void main() {
    int z = int(gl_WorkGroupID.z);
    int aw = (pc.nbx - 1) * pc.step + kBlk, ah = (pc.nby - 1) * pc.step + kBlk;
    int pad, w, h;
    if (z == 0) {
        gW = aw + 2 * pc.pad;
        gH = ah + 2 * pc.pad;
        gStride = pc.wp;
        gPlaneBytes = pc.wp * pc.hp;
        gBase = 0;
        pad = pc.pad;
        w = pc.w;
        h = pc.h;
    } else {
        gW = aw / 2 + 2 * pc.padc;
        gH = ah / 2 + 2 * pc.padc;
        gStride = pc.wc;
        gPlaneBytes = pc.wc * pc.hc;
        gBase = (z - 1) * 4 * gPlaneBytes;
        pad = pc.padc;
        w = pc.w / 2;
        h = pc.h / 2;
    }
    int x = 4 * int(gl_GlobalInvocationID.x), y = int(gl_WorkGroupID.y);
    if (x >= gW || y >= gH)
        return;
    if (pc.level == 0) {
        int sy = clamp(y - pad, 0, h - 1);
        uint word = 0u;
        [[unroll]] for (int k = 0; k < 4; ++k) {
            int sx = clamp(x + k - pad, 0, w - 1);
            uint v = z == 0 ? uint(rawY[sy * pc.srcStrideY + sx]) : z == 1 ? uint(rawU[sy * pc.srcStrideC + sx]) : uint(rawV[sy * pc.srcStrideC + sx]);
            word |= v << (8 * k);
        }
        PutWord(0, x, y, word);
    } else if (pc.level == 1) {
        PutWord(1, x, y, HorizontalWiener4(0, x, y));
        PutWord(2, x, y, VerticalWiener4(0, x, y));
    } else {
        PutWord(3, x, y, HorizontalWiener4(2, x, y));
    }
}
