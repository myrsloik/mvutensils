#version 460
#extension GL_GOOGLE_include_directive : require
#include "super_common.glsl"

layout(local_size_x = 64) in;

// A frame's level-0 super planes built on the GPU exactly as mvu.Super builds them
// (SuperPyramid.cpp's CopyAndPadPlane, GeneratePelPlanes and SetExternalPelPlanes), in the layout
// SuperLayout.h gives: per plane (Y at binding 0, U then V at binding 2) its sub-pel planes, rows
// pc.wp or pc.wc samples apart, pc.hp or pc.hc rows each. Step pc.step:
//
// 0: the full-pel planes from the frame: extended to the block-aligned size the grid covers, then
//    padded, edges repeated, the rows below the frame copies of its last row;
// 1: the x + 1/2 and y + 1/2 planes from them by the sharp filter (bilinear, bicubic or Wiener)
//    over the padded plane, averages and copies near its edges;
// 2: the diagonal plane: the bilinear one from the full-pel plane, the others with the horizontal
//    filter across the y + 1/2 plane;
// 3: with a pelclip (pel 2 only, Super.cpp), the three half-pel planes from it instead, its
//    frame's area extended and padded the same way (SetExtPel2, PadPlaneData).
//
// At pel 4 luma keeps its four planes, its quarter samples computed where they're read, and so does
// 4:4:4 chroma; subsampled chroma's quarter-pel image super_qpel.comp makes whole, from the frame,
// and Super.cpp dispatches luma alone here. Each lane makes 4 samples of a row, read and written as
// groups of four (super_common.glsl; rows start on groups, the last group of a row may run into the
// row's alignment, which nothing reads, and the frames' spare row takes the reads past the last
// one), 256 samples of a row per workgroup, the plane (Y, U, V) in z; dispatched as
// ((W + 255) / 256, H, planes) with W x H the padded luma size.

int gBuf;           // the plane's storage: kLuma or kChroma
int gW, gH;         // the padded plane
int gStride;        // rows apart, samples
uint gPlaneSize;    // sub-pel planes apart
uint gBase;         // where its first sub-pel plane starts
int gPadX, gPadY;   // its padding
int gRealW, gRealH; // the frame's plane
int gRaw, gPelBuf;  // the frame's and the pelclip's plane, as buffers
int gRawStride, gPelStride;

// The group of samples x .. x + 3 of row y of sub-pel plane slot (0 full-pel, 1 x + 1/2,
// 2 y + 1/2, 3 both), x a multiple of 4
uint Group(int slot, int x, int y) {
    return (gBase + uint(slot) * gPlaneSize + uint(y * gStride + x)) >> 2u;
}

// Sample j of the 12 a, b, c hold, x - 4 .. x + 7 (j a constant once unrolled)
int WI(ivec4 a, ivec4 b, ivec4 c, int j) {
    return j < 4 ? a[j] : j < 8 ? b[j - 4] : c[j - 8];
}
float WF(vec4 a, vec4 b, vec4 c, int j) {
    return j < 4 ? a[j] : j < 8 ? b[j - 4] : c[j - 8];
}

// The horizontal filter of sub-pel plane src's row y at samples x .. x + 3, into plane dst
void Horizontal(int src, int dst, int x, int y) {
    if (kFloat) {
        vec4 a = x >= 4 ? Get4F(gBuf, Group(src, x - 4, y)) : vec4(0.0), b = Get4F(gBuf, Group(src, x, y)), c = Get4F(gBuf, Group(src, x + 4, y));
        vec4 r;
        [[unroll]] for (int k = 0; k < 4; ++k) {
            int j = 4 + k, mode = Mode(x + k, gW);
            if (mode == 0)
                r[k] = WF(a, b, c, j);
            else if (mode == 1)
                r[k] = AvgF(WF(a, b, c, j), WF(a, b, c, j + 1));
            else if (pc.sharp == 1)
                r[k] = BicubicF(WF(a, b, c, j - 1), WF(a, b, c, j), WF(a, b, c, j + 1), WF(a, b, c, j + 2));
            else
                r[k] = WienerF(WF(a, b, c, j - 2), WF(a, b, c, j - 1), WF(a, b, c, j), WF(a, b, c, j + 1), WF(a, b, c, j + 2), WF(a, b, c, j + 3));
        }
        Put4F(gBuf, Group(dst, x, y), r);
    } else {
        ivec4 a = x >= 4 ? Get4I(gBuf, Group(src, x - 4, y)) : ivec4(0), b = Get4I(gBuf, Group(src, x, y)), c = Get4I(gBuf, Group(src, x + 4, y));
        ivec4 r;
        [[unroll]] for (int k = 0; k < 4; ++k) {
            int j = 4 + k, mode = Mode(x + k, gW);
            if (mode == 0)
                r[k] = WI(a, b, c, j);
            else if (mode == 1)
                r[k] = AvgI(WI(a, b, c, j), WI(a, b, c, j + 1));
            else if (pc.sharp == 1)
                r[k] = BicubicI(WI(a, b, c, j - 1), WI(a, b, c, j), WI(a, b, c, j + 1), WI(a, b, c, j + 2));
            else
                r[k] = WienerI(WI(a, b, c, j - 2), WI(a, b, c, j - 1), WI(a, b, c, j), WI(a, b, c, j + 1), WI(a, b, c, j + 2), WI(a, b, c, j + 3));
        }
        Put4I(gBuf, Group(dst, x, y), r);
    }
}

// And the vertical one, from the groups of rows y - 2 .. y + 3 holding the same 4 columns
void Vertical(int src, int dst, int x, int y) {
    int mode = Mode(y, gH);
    if (kFloat) {
        vec4 r[6];
        [[unroll]] for (int i = 0; i < 6; ++i)
            r[i] = Get4F(gBuf, Group(src, x, clamp(y - 2 + i, 0, gH - 1)));
        vec4 o;
        [[unroll]] for (int k = 0; k < 4; ++k) {
            if (mode == 0)
                o[k] = r[2][k];
            else if (mode == 1)
                o[k] = AvgF(r[2][k], r[3][k]);
            else if (pc.sharp == 1)
                o[k] = BicubicF(r[1][k], r[2][k], r[3][k], r[4][k]);
            else
                o[k] = WienerF(r[0][k], r[1][k], r[2][k], r[3][k], r[4][k], r[5][k]);
        }
        Put4F(gBuf, Group(dst, x, y), o);
    } else {
        ivec4 r[6];
        [[unroll]] for (int i = 0; i < 6; ++i)
            r[i] = Get4I(gBuf, Group(src, x, clamp(y - 2 + i, 0, gH - 1)));
        ivec4 o;
        [[unroll]] for (int k = 0; k < 4; ++k) {
            if (mode == 0)
                o[k] = r[2][k];
            else if (mode == 1)
                o[k] = AvgI(r[2][k], r[3][k]);
            else if (pc.sharp == 1)
                o[k] = BicubicI(r[1][k], r[2][k], r[3][k], r[4][k]);
            else
                o[k] = WienerI(r[0][k], r[1][k], r[2][k], r[3][k], r[4][k], r[5][k]);
        }
        Put4I(gBuf, Group(dst, x, y), o);
    }
}

// DiagonalBilinear at samples x .. x + 3: the average of four, of two along the last column and
// the last row, the last sample copied
void Diagonal(int dst, int x, int y) {
    int yn = min(y + 1, gH - 1);
    bool bottom = y == gH - 1;
    if (kFloat) {
        vec4 a0 = Get4F(gBuf, Group(0, x, y)), a1 = Get4F(gBuf, Group(0, x + 4, y)), b0 = Get4F(gBuf, Group(0, x, yn)), b1 = Get4F(gBuf, Group(0, x + 4, yn));
        vec4 o;
        [[unroll]] for (int k = 0; k < 4; ++k) {
            float s = a0[k], sx = k < 3 ? a0[k + 1] : a1[0], t = b0[k], tx = k < 3 ? b0[k + 1] : b1[0];
            bool right = x + k >= gW - 1;
            if (right && bottom)
                o[k] = s;
            else if (bottom)
                o[k] = AvgF(s, sx);
            else if (right)
                o[k] = AvgF(s, t);
            else
                o[k] = Avg4F(s, sx, t, tx);
        }
        Put4F(gBuf, Group(dst, x, y), o);
    } else {
        ivec4 a0 = Get4I(gBuf, Group(0, x, y)), a1 = Get4I(gBuf, Group(0, x + 4, y)), b0 = Get4I(gBuf, Group(0, x, yn)), b1 = Get4I(gBuf, Group(0, x + 4, yn));
        ivec4 o;
        [[unroll]] for (int k = 0; k < 4; ++k) {
            int s = a0[k], sx = k < 3 ? a0[k + 1] : a1[0], t = b0[k], tx = k < 3 ? b0[k + 1] : b1[0];
            bool right = x + k >= gW - 1;
            if (right && bottom)
                o[k] = s;
            else if (bottom)
                o[k] = AvgI(s, sx);
            else if (right)
                o[k] = AvgI(s, t);
            else
                o[k] = Avg4I(s, sx, t, tx);
        }
        Put4I(gBuf, Group(dst, x, y), o);
    }
}

void main() {
    int z = int(gl_WorkGroupID.z);
    if (z == 0) {
        gBuf = kLuma;
        gW = pc.aw + 2 * pc.padX;
        gH = pc.ah + 2 * pc.padY;
        gStride = pc.wp;
        gPlaneSize = uint(pc.wp * pc.hp);
        gBase = 0u;
        gPadX = pc.padX;
        gPadY = pc.padY;
        gRealW = pc.w;
        gRealH = pc.h;
        gRaw = kRawY;
        gPelBuf = kPelY;
        gRawStride = pc.srcStrideY;
        gPelStride = pc.pelStrideY;
    } else {
        gBuf = kChroma;
        gW = pc.aw / pc.xr + 2 * pc.padcX;
        gH = pc.ah / pc.yr + 2 * pc.padcY;
        gStride = pc.wc;
        gPlaneSize = uint(pc.wc * pc.hc);
        gBase = uint(z - 1) * uint(pc.chromaPlanes) * gPlaneSize;
        gPadX = pc.padcX;
        gPadY = pc.padcY;
        gRealW = pc.w / pc.xr;
        gRealH = pc.h / pc.yr;
        gRaw = z == 1 ? kRawU : kRawV;
        gPelBuf = z == 1 ? kPelU : kPelV;
        gRawStride = pc.srcStrideC;
        gPelStride = pc.pelStrideC;
    }
    int x = 4 * int(gl_GlobalInvocationID.x), y = int(gl_WorkGroupID.y);
    if (x >= gW || y >= gH)
        return;
    // The frame's row and samples these padded positions repeat
    int sy = clamp(y - gPadY, 0, gRealH - 1);
    ivec4 sx = clamp(ivec4(x) + ivec4(0, 1, 2, 3) - gPadX, 0, gRealW - 1);
    if (pc.step == 0) {
        if (kFloat) {
            vec4 v;
            [[unroll]] for (int k = 0; k < 4; ++k)
                v[k] = GetF(gRaw, uint(sy * gRawStride + sx[k]));
            Put4F(gBuf, Group(0, x, y), v);
        } else {
            ivec4 v;
            [[unroll]] for (int k = 0; k < 4; ++k)
                v[k] = GetI(gRaw, uint(sy * gRawStride + sx[k]));
            Put4I(gBuf, Group(0, x, y), v);
        }
    } else if (pc.step == 1) {
        Horizontal(0, 1, x, y);
        Vertical(0, 2, x, y);
    } else if (pc.step == 2) {
        if (pc.sharp == 0)
            Diagonal(3, x, y);
        else
            Horizontal(2, 3, x, y);
    } else {
        // Half-pel plane fx | (fy << 1) is pelclip sample (2 sx + fx, 2 sy + fy)
        for (int i = 1; i < 4; ++i) {
            int row = (2 * sy + (i >> 1)) * gPelStride + (i & 1);
            if (kFloat) {
                vec4 v;
                [[unroll]] for (int k = 0; k < 4; ++k)
                    v[k] = GetF(gPelBuf, uint(row + 2 * sx[k]));
                Put4F(gBuf, Group(i, x, y), v);
            } else {
                ivec4 v;
                [[unroll]] for (int k = 0; k < 4; ++k)
                    v[k] = GetI(gPelBuf, uint(row + 2 * sx[k]));
                Put4I(gBuf, Group(i, x, y), v);
            }
        }
    }
}
