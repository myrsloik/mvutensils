#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_control_flow_attributes : require

// mvgpu.Recalculate (Recalculate.cpp): every block of the super's grid gets the vector the old vectors
// interpolate to at its centre (or the nearest old block's), and where that vector's SAD is above
// thsad, mvu's search around it, exactly as mvu.Recalculate does it (MotionBlockPyramid.cpp's
// DoRecalculateMVs and the searches it calls: DiamondSearch, ExpandingSearch, Hex2Search, UMHSearch,
// the horizontal and vertical ones), which take the same candidates in the same order and keep the
// first of equal costs, so the vectors are mvu's given the same supers and old vectors. The blocks
// don't depend on each other: one subgroup takes a block, each lane a share of its pixels, every SAD
// the subgroup's sum, so that all lanes follow the search together. Float supers take mvu's float
// SADs, its float operations in the order its AVX-512 build takes them (sadf_common.glsl), every lane
// measuring the whole block alike. Dispatched as (nbx, nby) workgroups of one subgroup.

layout(local_size_x_id = 1) in;

layout(constant_id = 0) const int kSubgroup = 32;
layout(constant_id = 3) const int kBlkX = 16; // the grid's block width,
layout(constant_id = 7) const int kBlkY = 16; // and height
layout(constant_id = 5) const int kPel = 2;
// The variant (specialization constant 6): chroma's subsampling in bits 0 (horizontal) and 1
// (vertical); bit 2 16-bit samples, bit 3 float; bit 4 the SADs count chroma; bit 5 luma's SAD is its
// SATD (satd=True, TileSatd)
layout(constant_id = 6) const int kVariant = 3;
const int kLogX = kVariant & 1, kLogY = (kVariant >> 1) & 1;
const bool kWide = (kVariant & 4) != 0;
const bool kFloat = (kVariant & 8) != 0;
const bool kChromaSad = (kVariant & 16) != 0;
const bool kSatd = (kVariant & 32) != 0;
// Subsampled chroma at pel 4 is its quarter-pel image (SuperLayout.h). No && or || between
// specialization constants: the core's compiler makes them short-circuit code in the first function
// that uses them, which the others then can't see.
const bool kImage = (kPel == 4 ? kVariant & 3 : 0) != 0;
const int kBlkCX = kBlkX >> kLogX, kBlkCY = kBlkY >> kLogY;
const int kLumaPer = (kBlkX * kBlkY + kSubgroup - 1) / kSubgroup;  // luma pixels a lane holds
const int kChromaPer = (kBlkCX * kBlkCY + kSubgroup - 1) / kSubgroup; // and of each chroma plane
// Blocks with more than 32 pixels per lane (wider than 32x32) don't keep them in registers: Sads
// reads them from the super each time; nor do float blocks, whose SADs read every sample as it is
// (selects, as kImage)
const bool kKeep = (kFloat ? 0 : (kLumaPer <= 32 ? 1 : 0)) != 0;
// With kSatd the lanes take luma's 4x4 tiles, kTilesPer each, keeping their pixels where those are
// 32 or fewer (kKeepT)
const int kTilesX = kBlkX / 4, kTiles = kTilesX * (kBlkY / 4);
const int kTilesPer = (kTiles + kSubgroup - 1) / kSubgroup;
const bool kKeepT = (kFloat ? 0 : (kTilesPer <= 2 ? 1 : 0)) != 0;

// Matches RecalcParams in VulkanContext.h
layout(push_constant) uniform Params {
    int nbx, nby, step, recStride;              // the grid, the output's records per row
    int nbxOld, nbyOld, blkOld, stepOld;        // the old vectors' grid
    int recStrideOld, pad, padY, padc;          // their records per row; the supers' padding
    int padcY, wp, hp, wc;                      // the supers' storage strides and rows per plane
    int hc, aw, ah, lambda;                     // the block-aligned frame; lambda / pel^2
    int thsad, pnew, search, searchParam;       // the search's arguments (search: mvu's SearchType)
    int smoothing;                              // interpolate the old vectors (smooth), else take the nearest
    int oldPelShift;                            // log2 of the super's pel less log2 of the old vectors'
    int stepY, blkOldY, stepOldY;               // the grids vertically: the new one's step, the old one's block and step
    int thsadHi;                                // thsad's high 32 bits (Thsad)
} pc;

// The bindings: the supers' storage of the frame (src) and of its reference frame (ref), luma and
// chroma (U and V interleaved, sample by sample: SuperLayout.h), bytes, 16 bits each for 9 to 16-bit
// supers (kWide) or floats (read by SrcF and RefF); the old vectors and the new ones, a record
// (x, y, SAD, 0) per block
layout(std430, set = 0, binding = 0) readonly buffer SrcLuma { uint8_t srcY[]; };
layout(std430, set = 0, binding = 1) readonly buffer SrcChroma { uint8_t srcC[]; };
layout(std430, set = 0, binding = 2) readonly buffer RefLuma { uint8_t refY[]; };
layout(std430, set = 0, binding = 3) readonly buffer RefChroma { uint8_t refC[]; };
layout(std430, set = 0, binding = 0) readonly buffer SrcLuma16 { uint16_t srcY16[]; };
layout(std430, set = 0, binding = 1) readonly buffer SrcChroma16 { uint16_t srcC16[]; };
layout(std430, set = 0, binding = 2) readonly buffer RefLuma16 { uint16_t refY16[]; };
layout(std430, set = 0, binding = 3) readonly buffer RefChroma16 { uint16_t refC16[]; };
layout(std430, set = 0, binding = 0) readonly buffer SrcLumaF { float srcYF[]; };
layout(std430, set = 0, binding = 1) readonly buffer SrcChromaF { float srcCF[]; };
layout(std430, set = 0, binding = 2) readonly buffer RefLumaF { float refYF[]; };
layout(std430, set = 0, binding = 3) readonly buffer RefChromaF { float refCF[]; };
layout(std430, set = 0, binding = 4) readonly buffer OldVectors { ivec4 oldRec[]; };
layout(std430, set = 0, binding = 5) writeonly buffer NewVectors { ivec4 outRec[]; };

// thsad, unsigned and 64 bits wide: float SADs, each plane's up to 2^32 - 1, add up past 32 bits
uint64_t Thsad() {
    return uint64_t(uint(pc.thsad)) | (uint64_t(uint(pc.thsadHi)) << 32u);
}

// Integer samples (floats take SrcF and RefF)
uint LumaAt(bool ref, uint i) {
    if (kWide)
        return ref ? uint(refY16[i]) : uint(srcY16[i]);
    return ref ? uint(refY[i]) : uint(srcY[i]);
}

uint ChromaAt(bool ref, uint i) {
    if (kWide)
        return ref ? uint(refC16[i]) : uint(srcC16[i]);
    return ref ? uint(refC[i]) : uint(srcC[i]);
}

// The rounded average mvu.Super's quarter planes take of two samples
uint Avg(uint a, uint b) {
    return (a + b + 1u) >> 1u;
}

// The address of sample (Xh, Yh) of the half-pel grid of a plane with rows stride samples apart, its
// four half-pel planes rows rows each
uint HalfAddr(int Xh, int Yh, int stride, int rows) {
    return uint((Xh & 1) | ((Yh & 1) << 1)) * uint(stride * rows) + uint((Yh >> 1) * stride + (Xh >> 1));
}

// mvu's GetAbsolutePointerPel1/2/4: the reference's luma sample at (X, Y), 1 / pel pixels of the
// padded plane; the quarter samples computed from the half-pel ones as mvu.Super makes them
uint RefSample(int X, int Y) {
    if (kPel == 1)
        return LumaAt(true, uint(Y * pc.wp + X));
    if (kPel == 2)
        return LumaAt(true, HalfAddr(X, Y, pc.wp, pc.hp));
    int Xa = X >> 1, Xb = Xa + (X & 1), Ya = Y >> 1, Yb = Ya + (Y & 1);
    uint aa = HalfAddr(Xa, Ya, pc.wp, pc.hp), ab = HalfAddr(Xa, Yb, pc.wp, pc.hp);
    uint ba = HalfAddr(Xb, Ya, pc.wp, pc.hp), bb = HalfAddr(Xb, Yb, pc.wp, pc.hp);
    return Avg(Avg(LumaAt(true, aa), LumaAt(true, ab)), Avg(LumaAt(true, ba), LumaAt(true, bb)));
}

// And its chroma samples there, U's and V's, side by side in the interleaved planes (subsampled
// chroma's from its quarter-pel image)
uvec2 RefChromaUV(int X, int Y) {
    uint a = 0u;
    if (kImage)
        a = 2u * uint(Y * 4 * pc.wc + X);
    else if (kPel == 1)
        a = 2u * uint(Y * pc.wc + X);
    else if (kPel == 2)
        a = 2u * HalfAddr(X, Y, pc.wc, pc.hc);
    if (kPel != 4)
        return uvec2(ChromaAt(true, a), ChromaAt(true, a + 1u));
    if (kImage)
        return uvec2(ChromaAt(true, a), ChromaAt(true, a + 1u));
    int Xa = X >> 1, Xb = Xa + (X & 1), Ya = Y >> 1, Yb = Ya + (Y & 1);
    uint aa = 2u * HalfAddr(Xa, Ya, pc.wc, pc.hc), ab = 2u * HalfAddr(Xa, Yb, pc.wc, pc.hc);
    uint ba = 2u * HalfAddr(Xb, Ya, pc.wc, pc.hc), bb = 2u * HalfAddr(Xb, Yb, pc.wc, pc.hc);
    return uvec2(Avg(Avg(ChromaAt(true, aa), ChromaAt(true, ab)), Avg(ChromaAt(true, ba), ChromaAt(true, bb))),
                 Avg(Avg(ChromaAt(true, aa + 1u), ChromaAt(true, ab + 1u)), Avg(ChromaAt(true, ba + 1u), ChromaAt(true, bb + 1u))));
}

// The frame's own pixel (x, y) of the padded plane: its full-pel luma sample, and its chroma ones
uint SrcSample(int x, int y) {
    return LumaAt(false, uint(y * pc.wp + x));
}
uvec2 SrcChromaUV(int x, int y) {
    uint a = 2u * (kImage ? uint(16 * y * pc.wc + 4 * x) : uint(y * pc.wc + x));
    return uvec2(ChromaAt(false, a), ChromaAt(false, a + 1u));
}

// The block: its top left pixel in the padded planes, luma's and chroma's, and the pixels this lane
// holds (kKeep; with kSatd luma's tiles', kKeepT)
int gX, gY, gXc, gYc;

// Float supers: mvu's float SADs, its float operations in its order (sadf_common.glsl), spread over the
// subgroup (SadParF, SatdParF); the samples read as they are, the quarter ones as mvu.Super's float
// quarter planes hold them, (a + b) * 0.5 of two vertical averages. gSadV is the vector measured.
ivec2 gSadV;

float AvgF(float a, float b) {
    precise float s = (a + b) * 0.5;
    return s;
}

// Luma's samples: the frame's own at (x, y) of the padded plane, the reference's at (X, Y)
float SrcF(int x, int y) {
    return srcYF[y * pc.wp + x];
}
float RefF(int X, int Y) {
    if (kPel == 1)
        return refYF[Y * pc.wp + X];
    if (kPel == 2)
        return refYF[HalfAddr(X, Y, pc.wp, pc.hp)];
    int Xa = X >> 1, Xb = Xa + (X & 1), Ya = Y >> 1, Yb = Ya + (Y & 1);
    uint aa = HalfAddr(Xa, Ya, pc.wp, pc.hp), ab = HalfAddr(Xa, Yb, pc.wp, pc.hp);
    uint ba = HalfAddr(Xb, Ya, pc.wp, pc.hp), bb = HalfAddr(Xb, Yb, pc.wp, pc.hp);
    return AvgF(AvgF(refYF[aa], refYF[ab]), AvgF(refYF[ba], refYF[bb]));
}

// And chroma's, U's and V's, side by side in the interleaved planes, as SrcChromaUV and RefChromaUV
vec2 SrcUVF(int x, int y) {
    uint a = 2u * (kImage ? uint(16 * y * pc.wc + 4 * x) : uint(y * pc.wc + x));
    return vec2(srcCF[a], srcCF[a + 1u]);
}
vec2 RefUVF(int X, int Y) {
    uint a = 0u;
    if (kImage)
        a = 2u * uint(Y * 4 * pc.wc + X);
    else if (kPel == 1)
        a = 2u * uint(Y * pc.wc + X);
    else if (kPel == 2)
        a = 2u * HalfAddr(X, Y, pc.wc, pc.hc);
    if (kPel != 4)
        return vec2(refCF[a], refCF[a + 1u]);
    if (kImage)
        return vec2(refCF[a], refCF[a + 1u]);
    int Xa = X >> 1, Xb = Xa + (X & 1), Ya = Y >> 1, Yb = Ya + (Y & 1);
    uint aa = 2u * HalfAddr(Xa, Ya, pc.wc, pc.hc), ab = 2u * HalfAddr(Xa, Yb, pc.wc, pc.hc);
    uint ba = 2u * HalfAddr(Xb, Ya, pc.wc, pc.hc), bb = 2u * HalfAddr(Xb, Yb, pc.wc, pc.hc);
    return vec2(AvgF(AvgF(refCF[aa], refCF[ab]), AvgF(refCF[ba], refCF[bb])), AvgF(AvgF(refCF[aa + 1u], refCF[ab + 1u]), AvgF(refCF[ba + 1u], refCF[bb + 1u])));
}

// sadf_common.glsl's differences: luma's (p 0), and U's and V's at the vector divided by the subsampling,
// rounded toward zero
float DiffF(int p, int x, int y) {
    precise float d = SrcF(gX + x, gY + y) - RefF(gX * kPel + gSadV.x + x * kPel, gY * kPel + gSadV.y + y * kPel);
    return d;
}
vec2 DiffUV(int x, int y) {
    int cvx = (gSadV.x + (gSadV.x < 0 ? (1 << kLogX) - 1 : 0)) >> kLogX, cvy = (gSadV.y + (gSadV.y < 0 ? (1 << kLogY) - 1 : 0)) >> kLogY;
    precise vec2 d = SrcUVF(gXc + x, gYc + y) - RefUVF(gXc * kPel + cvx + x * kPel, gYc * kPel + cvy + y * kPel);
    return d;
}

#include "sadf_common.glsl"
uint gSrcY[kKeep ? kLumaPer : 1], gSrcU[kKeep ? kChromaPer : 1], gSrcV[kKeep ? kChromaPer : 1];
uint gSrcT[kSatd ? (kKeepT ? 16 * kTilesPer : 1) : 1];
int gLane;

// sadf_common.glsl's SadRawF, the raw float SAD of plane p's w x h block, spread over the subgroup and the
// same in every lane, which must all call it: the searches inline it wherever they check a vector, so it
// has to be small, and a lane measuring the whole block would leave the others idle. Blocks 8 or more
// wide: each lane takes whole chains of mvu's additions, the accumulator of the rows k modulo 4 of mvu's
// lane l (chain k L + l), the lanes then gather (a0 + a1) + (a2 + a3) in lane l, and halve as mvu's do.
// Blocks 4 or 2 wide: lane 8x + i takes row ColumnRow(i) of column x, and the lanes pair up as the rows
// and columns do.
float SadParF(int p, int w, int h) {
    if (w <= 4) {
        int x = gLane >> 3, i = gLane & 7;
        float v = x < w && i < h ? AbsDiffF(p, x, ColumnRow(i, h)) : 0.0;
        for (int n = 1; n < h; n <<= 1) {
            precise float s = v + subgroupShuffleXor(v, uint(n));
            v = s;
        }
        if (w == 2) {
            precise float s = v + subgroupShuffleXor(v, 8u);
            v = s;
        } else {
            precise float s = v + subgroupShuffleXor(v, 16u);
            precise float t = s + subgroupShuffleXor(s, 8u);
            v = t;
        }
        return subgroupShuffle(v, 0u);
    }
    int L = w == 8 ? 8 : 16, K = h < 4 ? 1 : 4, chains = L * K;
    float a[2] = float[2](0.0, 0.0);
    for (int m = 0; m * kSubgroup < chains; ++m) {
        int c = gLane + m * kSubgroup;
        precise float s = 0.0;
        if (c < chains) {
            int l = c % L, k = c / L;
            [[dont_unroll]] for (int y = k; y < h; y += K)
                for (int x = l; x < w; x += L)
                    s += AbsDiffF(p, x, y);
        }
        a[m] = s;
    }
    float ak[4];
    for (int k = 0; k < K; ++k) {
        int c = k * L + gLane % L;
        float v0 = subgroupShuffle(a[0], uint(c % kSubgroup)), v1 = subgroupShuffle(a[1], uint(c % kSubgroup));
        ak[k] = c < kSubgroup ? v0 : v1;
    }
    precise float t = ak[0];
    if (K == 4) {
        precise float s01 = ak[0] + ak[1];
        precise float s23 = ak[2] + ak[3];
        t = s01 + s23;
    }
    for (int n = L >> 1; n >= 1; n >>= 1) {
        precise float s = t + subgroupShuffleXor(t, uint(n));
        t = s;
    }
    return subgroupShuffle(t, 0u);
}

// SadParF for U and V at once: the same sums component by component (sadf_common.glsl's SadUV), one pass
// over their side-by-side samples
vec2 SadParUV(int w, int h) {
    if (w <= 4) {
        int x = gLane >> 3, i = gLane & 7;
        vec2 v = x < w && i < h ? AbsDiffUV(x, ColumnRow(i, h)) : vec2(0.0);
        for (int n = 1; n < h; n <<= 1) {
            precise vec2 s = v + subgroupShuffleXor(v, uint(n));
            v = s;
        }
        if (w == 2) {
            precise vec2 s = v + subgroupShuffleXor(v, 8u);
            v = s;
        } else {
            precise vec2 s = v + subgroupShuffleXor(v, 16u);
            precise vec2 t = s + subgroupShuffleXor(s, 8u);
            v = t;
        }
        return subgroupShuffle(v, 0u);
    }
    int L = w == 8 ? 8 : 16, K = h < 4 ? 1 : 4, chains = L * K;
    vec2 a[2] = vec2[2](vec2(0.0), vec2(0.0));
    for (int m = 0; m * kSubgroup < chains; ++m) {
        int c = gLane + m * kSubgroup;
        precise vec2 s = vec2(0.0);
        if (c < chains) {
            int l = c % L, k = c / L;
            [[dont_unroll]] for (int y = k; y < h; y += K)
                for (int x = l; x < w; x += L)
                    s += AbsDiffUV(x, y);
        }
        a[m] = s;
    }
    vec2 ak[4];
    for (int k = 0; k < K; ++k) {
        int c = k * L + gLane % L;
        vec2 v0 = subgroupShuffle(a[0], uint(c % kSubgroup)), v1 = subgroupShuffle(a[1], uint(c % kSubgroup));
        ak[k] = c < kSubgroup ? v0 : v1;
    }
    precise vec2 t = ak[0];
    if (K == 4) {
        precise vec2 s01 = ak[0] + ak[1];
        precise vec2 s23 = ak[2] + ak[3];
        t = s01 + s23;
    }
    for (int n = L >> 1; n >= 1; n >>= 1) {
        precise vec2 s = t + subgroupShuffleXor(t, uint(n));
        t = s;
    }
    return subgroupShuffle(t, 0u);
}

// sadf_common.glsl's SatdRawF, the raw float SATD of luma's w x h block, likewise: a row of tiles at a
// time, lane tx transforming tile tx (TileF); up to 8 wide the tiles' sums (T4F) added in order, wider
// lane m folding tiles m, m + 4, ... into its running sum as T16F does, from each tile's partial sums
// P1 .. P6: acc = P6 + (P5 + (P4 + (P3 + (P2 + (P1 + acc))))), lane 0's from the rows before
float SatdParF(int w, int h) {
    int nt = w / 4; // tiles in a row, at most 32
    precise float total = 0.0;
    [[dont_unroll]] for (int ty = 0; ty < h / 4; ++ty) {
        float c[16];
        for (int i = 0; i < 16; ++i)
            c[i] = 0.0;
        if (gLane < nt)
            TileF(gLane, ty, c);
        if (w <= 8) {
            float t4 = T4F(c);
            for (int tx = 0; tx < nt; ++tx) {
                precise float s = total + subgroupShuffle(t4, uint(tx));
                total = s;
            }
        } else {
            precise float p2 = c[2] + c[0];
            precise float q3 = c[5] + c[3];
            precise float p3 = c[4] + q3;
            precise float q4 = c[6] + c[7];
            precise float r4 = c[9] + q4;
            precise float p4 = c[8] + r4;
            precise float q5 = c[10] + c[11];
            precise float r5 = c[13] + q5;
            precise float s5 = c[12] + r5;
            precise float p5 = c[14] + s5;
            float part[6] = float[6](c[1], p2, p3, p4, p5, c[15]);
            precise float acc = gLane == 0 ? total : 0.0;
            for (int j = 0; j < nt / 4; ++j) {
                uint src = uint(4 * j + (gLane & 3));
                for (int k = 0; k < 6; ++k) {
                    precise float s = subgroupShuffle(part[k], src) + acc;
                    acc = s;
                }
            }
            precise float a = subgroupShuffle(acc, 0u) + subgroupShuffle(acc, 2u);
            precise float b = subgroupShuffle(acc, 1u) + subgroupShuffle(acc, 3u);
            total = a + b;
        }
    }
    return total;
}

uint AbsDiff(uint a, uint b) {
    return a > b ? a - b : b - a;
}

// mvu's SATD (SADFunctions.cpp's Satd_C) of a 4x4 tile from its rows of differences: the sum of the
// absolute values of its 4x4 Hadamard transform, halved, which is exact, the sum always being even.
// Each row transformed, then the first step of the columns'; the second step's absolute values come
// in pairs, |a + b| + |a - b| = 2 max(|a|, |b|), so the halved sum is the sum of those maxima.
ivec4 Hadamard4(ivec4 d) {
    int s0 = d.x + d.y, s1 = d.x - d.y, s2 = d.z + d.w, s3 = d.z - d.w;
    return ivec4(s0 + s2, s1 + s3, s0 - s2, s1 - s3);
}

uint TileSatd(ivec4 d0, ivec4 d1, ivec4 d2, ivec4 d3) {
    ivec4 h0 = Hadamard4(d0), h1 = Hadamard4(d1), h2 = Hadamard4(d2), h3 = Hadamard4(d3);
    ivec4 p0 = h0 + h1, p1 = h0 - h1, p2 = h2 + h3, p3 = h2 - h3;
    ivec4 m = max(abs(p0), abs(p2)) + max(abs(p1), abs(p3));
    return uint(m.x + m.y + m.z + m.w);
}

// The SATD of luma tile t (kTilesX to a row) at vector (X0, Y0) of the reference, its current pixels
// those kept at gSrcT[16 * k] (kKeepT) or read from the super
uint TileSatdAt(int t, int k, int X0, int Y0) {
    int tx = (t % kTilesX) * 4, ty = (t / kTilesX) * 4;
    ivec4 d[4];
    [[unroll]] for (int i = 0; i < 4; ++i)
        [[unroll]] for (int c = 0; c < 4; ++c) {
            uint cur = kKeepT ? gSrcT[16 * k + 4 * i + c] : SrcSample(gX + tx + c, gY + ty + i);
            d[i][c] = int(cur) - int(RefSample(X0 + (tx + c) * kPel, Y0 + (ty + i) * kPel));
        }
    return TileSatd(d[0], d[1], d[2], d[3]);
}

// The block's luma SAD (with kSatd its SATD) and chroma SAD (U's and V's together) at vector (vx, vy),
// 1 / pel pixels; chroma at the vector divided by the subsampling, rounded toward zero (mvu's
// GetRefBlockU). In 64 bits, as mvu adds them: float SADs, each plane's up to 2^32 - 1, pass 32 bits.
u64vec2 Sads(int vx, int vy) {
    if (kFloat) {
        // luma's SAD or SATD, and U's and V's added, each plane's scaled alone, as mvu adds them
        gSadV = ivec2(vx, vy);
        uint64_t c = 0ul;
        if (kChromaSad) {
            vec2 sc = SadParUV(kBlkCX, kBlkCY);
            c = uint64_t(ScaledF(sc.x, 65535.0)) + uint64_t(ScaledF(sc.y, 65535.0));
        }
        uint l = kSatd ? ScaledF(SatdParF(kBlkX, kBlkY), 32767.5) : ScaledF(SadParF(0, kBlkX, kBlkY), 65535.0);
        return u64vec2(uint64_t(l), c);
    }
    uint sl = 0u, sc = 0u;
    int X0 = gX * kPel + vx, Y0 = gY * kPel + vy;
    if (kSatd) {
        if (kKeepT) {
            [[unroll]] for (int k = 0; k < kTilesPer; ++k) {
                int t = gLane + k * kSubgroup;
                if (t < kTiles)
                    sl += TileSatdAt(t, k, X0, Y0);
            }
        } else {
            for (int t = gLane; t < kTiles; t += kSubgroup)
                sl += TileSatdAt(t, 0, X0, Y0);
        }
    } else if (kKeep) {
        [[unroll]] for (int k = 0; k < kLumaPer; ++k) {
            int i = gLane + k * kSubgroup;
            if (i < kBlkX * kBlkY)
                sl += AbsDiff(gSrcY[k], RefSample(X0 + (i % kBlkX) * kPel, Y0 + (i / kBlkX) * kPel));
        }
    } else {
        for (int i = gLane; i < kBlkX * kBlkY; i += kSubgroup)
            sl += AbsDiff(SrcSample(gX + i % kBlkX, gY + i / kBlkX), RefSample(X0 + (i % kBlkX) * kPel, Y0 + (i / kBlkX) * kPel));
    }
    if (kChromaSad) {
        int cvx = (vx + (vx < 0 ? (1 << kLogX) - 1 : 0)) >> kLogX, cvy = (vy + (vy < 0 ? (1 << kLogY) - 1 : 0)) >> kLogY;
        int Xc0 = gXc * kPel + cvx, Yc0 = gYc * kPel + cvy;
        if (kKeep) {
            [[unroll]] for (int k = 0; k < kChromaPer; ++k) {
                int i = gLane + k * kSubgroup;
                if (i < kBlkCX * kBlkCY) {
                    uvec2 r = RefChromaUV(Xc0 + (i % kBlkCX) * kPel, Yc0 + (i / kBlkCX) * kPel);
                    sc += AbsDiff(gSrcU[k], r.x) + AbsDiff(gSrcV[k], r.y);
                }
            }
        } else {
            for (int i = gLane; i < kBlkCX * kBlkCY; i += kSubgroup) {
                uvec2 c = SrcChromaUV(gXc + i % kBlkCX, gYc + i / kBlkCX), r = RefChromaUV(Xc0 + (i % kBlkCX) * kPel, Yc0 + (i / kBlkCX) * kPel);
                sc += AbsDiff(c.x, r.x) + AbsDiff(c.y, r.y);
            }
        }
    }
    return u64vec2(subgroupAdd(uvec2(sl, sc)));
}

// The search's state, the same in every lane: the best vector, its SAD and cost; the predictor and
// lambda the cost measures from; the vectors the planes hold the block for (mvu's nDxMin, nDyMin,
// nDxMax, nDyMax); CheckMV2's direction
ivec2 gBest;
uint64_t gBestSad;
int64_t gMinCost;
ivec2 gPred;
int64_t gLambda;
ivec4 gBounds;
int gDir;

bool VectorOK(int vx, int vy) {
    return vx >= gBounds.x && vy >= gBounds.y && vx < gBounds.z && vy < gBounds.w;
}

// mvu's CheckMV_Template flags: penaltyNew on the SADs, update the direction, update the best vector
const int kPenalty = 1, kUpdateDir = 2, kUpdateBest = 4;

// mvu's CheckMV_Template and CheckMV_Slow: the candidate replaces the best when its cost, the
// distortion from the predictor plus the SADs (with penaltyNew), is lower
void Check(int vx, int vy, int flags, int val) {
    if (!VectorOK(vx, vy))
        return;
    int64_t dx = int64_t(gPred.x - vx), dy = int64_t(gPred.y - vy);
    int64_t cost = (gLambda * (dx * dx + dy * dy)) >> 8;
    if (cost >= gMinCost)
        return;
    u64vec2 s = Sads(vx, vy);
    bool penalty = (flags & kPenalty) != 0;
    cost += int64_t(s.x) + (penalty ? (int64_t(pc.pnew) * int64_t(s.x)) >> 8 : 0l);
    if (cost >= gMinCost)
        return;
    if (kChromaSad) {
        cost += int64_t(s.y) + (penalty ? (int64_t(pc.pnew) * int64_t(s.y)) >> 8 : 0l);
        if (cost >= gMinCost)
            return;
    }
    if ((flags & kUpdateBest) != 0)
        gBest = ivec2(vx, vy);
    gMinCost = cost;
    gBestSad = s.x + s.y;
    if ((flags & kUpdateDir) != 0)
        gDir = val;
}

// mvu's searches (MotionBlockPyramid.cpp's DiamondSearch, ExpandingSearch, Hex2Search, UMHSearch and the
// horizontal and vertical lines), candidate for candidate in mvu's order, as one walk: a batch of
// candidates at a time, each batch's taken from the state the checks before it left (gBest, gDir), and
// every candidate checked at one place (main). The driver inlines Check, and the SAD in it, wherever it is
// called: called once per candidate of every search as mvu's code reads, it was compiled about 70 times,
// 40-60 s per kernel cold, and float SATD on 128x128 blocks didn't compile at all.
//
// The batches: Diamond, candidates in direction codes (1 right, 2 left, 4 down, 8 up, and their sums for the
// diagonals), packed four bits each in gCodes, gR apart from (gCX, gCY), CheckMV2's; Expand, the square of
// radius gR around (gCX, gCY), its sides without the corners and then the corners (ExpandingSearch's step
// 1, the only step Recalculate takes), CheckMV's; HexInit, the radius 2 hexagon around (gBmx, gBmy), and
// HexStep, the half hexagon ahead of direction gHexDir, CheckMVdir's; UmhCross, the cross around (gOmx,
// gOmy), its horizontal pairs and then its vertical ones, every second pixel, and UmhHex, the 16-point grid
// of scale gUmhScale around it, CheckMV's; Line, the horizontal or vertical pairs around (gCX, gCY), CheckMV's.
const int kWalkDone = 0, kWalkDiamondA = 1, kWalkDiamondB = 2, kWalkExpand = 3, kWalkHexInit = 4, kWalkHexStep = 5, kWalkUmhCross = 6, kWalkUmhHex = 7,
          kWalkLine = 8;
const int kMod6m1[8] = int[](5, 0, 1, 2, 3, 4, 5, 0);
const ivec2 kHex2[8] = ivec2[](ivec2(-1, -2), ivec2(-2, 0), ivec2(-1, 2), ivec2(1, 2), ivec2(2, 0), ivec2(1, -2), ivec2(-1, -2), ivec2(-2, 0));
const ivec2 kHex4[16] = ivec2[](ivec2(-4, 2), ivec2(-4, 1), ivec2(-4, 0), ivec2(-4, -1), ivec2(-4, -2), ivec2(4, -2), ivec2(4, -1), ivec2(4, 0), ivec2(4, 1),
                                ivec2(4, 2), ivec2(2, 3), ivec2(0, 4), ivec2(-2, 3), ivec2(-2, -3), ivec2(0, -4), ivec2(2, -3));
int gWalk, gCount;                       // the batch's kind and its candidates
int gCX, gCY, gR;                        // its centre and its distance (Diamond's length, Expand's radius)
uint gCodes;                             // Diamond: the directions
int gDirection, gLastDirection;          // DiamondSearch's
int gBmx, gBmy, gHexDir, gHexStep;       // Hex2Search's
int gOmx, gOmy, gUmhScale;               // UMHSearch's

// A direction code's offset, length apart: x right with 1, left with 2; y down with 4, up with 8
ivec2 DirectionOffset(int code, int length) {
    return length * ivec2((code & 1) != 0 ? 1 : ((code & 2) != 0 ? -1 : 0), (code & 4) != 0 ? 1 : ((code & 8) != 0 ? -1 : 0));
}

// Candidate k of the batch, with Check's flags and value
void WalkCandidate(int k, out ivec2 v, out int flags, out int val) {
    flags = kPenalty | kUpdateBest;
    val = 0;
    if (gWalk == kWalkDiamondA || gWalk == kWalkDiamondB) {
        int code = int((gCodes >> uint(4 * k)) & 15u);
        v = ivec2(gCX, gCY) + DirectionOffset(code, gR);
        flags = kPenalty | kUpdateDir | kUpdateBest;
        val = code;
    } else if (gWalk == kWalkExpand) {
        int side = 2 * gR - 1; // the positions of a side without its corners
        if (k < 2 * side)
            v = ivec2(gCX - gR + 1 + (k >> 1), gCY + ((k & 1) != 0 ? gR : -gR));
        else if (k < 4 * side)
            v = ivec2(gCX + (((k - 2 * side) & 1) != 0 ? gR : -gR), gCY - gR + 1 + ((k - 2 * side) >> 1));
        else
            v = ivec2(gCX + (k - 4 * side >= 2 ? gR : -gR), gCY + (((k - 4 * side) & 1) != 0 ? gR : -gR));
    } else if (gWalk == kWalkHexInit) {
        v = ivec2(gBmx, gBmy) + kHex2[k + 1];
        flags = kPenalty | kUpdateDir;
        val = k;
    } else if (gWalk == kWalkHexStep) {
        int odir = kMod6m1[gHexDir + 1];
        v = ivec2(gBmx, gBmy) + kHex2[odir + k];
        flags = kPenalty | kUpdateDir;
        val = odir - 1 + k;
    } else if (gWalk == kWalkUmhCross) {
        int n = 2 * (pc.searchParam / 2); // the horizontal candidates
        int i = 1 + 2 * ((k < n ? k : k - n) >> 1), sign = (k & 1) != 0 ? 1 : -1;
        v = k < n ? ivec2(gOmx + sign * i, gOmy) : ivec2(gOmx, gOmy + sign * i);
    } else if (gWalk == kWalkUmhHex) {
        v = ivec2(gOmx, gOmy) + kHex4[k] * gUmhScale;
    } else {
        int i = 1 + (k >> 1), d = (k & 1) != 0 ? i : -i;
        v = pc.search == 4 ? ivec2(gCX + d, gCY) : ivec2(gCX, gCY + d);
    }
}

// The batch of codes, their count
void DiamondBatch(int walk, uint codes, int count) {
    gWalk = walk;
    gCodes = codes;
    gCount = count;
}

// DiamondSearch's loop body, from the top: the directions of the last step, from the best vector
void DiamondIteration() {
    gCX = gBest.x;
    gCY = gBest.y;
    gLastDirection = gDirection;
    gDirection = 0;
    gDir = 0;
    uint codes = 0u;
    int count = 0;
    for (int b = 1; b <= 8; b <<= 1)
        if ((gLastDirection & b) != 0) {
            codes |= uint(b) << uint(4 * count);
            ++count;
        }
    DiamondBatch(kWalkDiamondA, codes, count);
}

void Expand(int r, int cx, int cy) {
    gWalk = kWalkExpand;
    gR = r;
    gCX = cx;
    gCY = cy;
    gCount = 8 * r;
}

// Hex2Search(range), from the best vector
void Hex2() {
    gBmx = gBest.x;
    gBmy = gBest.y;
    if (pc.searchParam > 1) {
        gDir = -2;
        gWalk = kWalkHexInit;
        gCount = 6;
    } else {
        Expand(1, gBmx, gBmy);
    }
}

// Hex2Search's end: the best vector where the hexagons went, then the square around it
void Hex2End() {
    gBest = ivec2(gBmx, gBmy);
    Expand(1, gBmx, gBmy);
}

// Hex2Search's loop: the next half hexagon while there are steps left and the centre is a vector the
// planes hold
void Hex2Loop() {
    if (gHexStep < pc.searchParam / 2 && VectorOK(gBmx, gBmy)) {
        gDir = -2;
        gWalk = kWalkHexStep;
        gCount = 3;
    } else {
        Hex2End();
    }
}

void StartWalk() {
    gWalk = kWalkDone;
    gCount = 0;
    if (pc.search == 0) {
        gR = pc.searchParam;
        if (gR > 0) {
            gDirection = 15;
            DiamondIteration();
        }
    } else if (pc.search == 1) {
        if (pc.searchParam >= 1)
            Expand(1, gBest.x, gBest.y);
    } else if (pc.search == 2) {
        Hex2();
    } else if (pc.search == 3) {
        gOmx = gBest.x;
        gOmy = gBest.y;
        gWalk = kWalkUmhCross;
        gCount = 4 * (pc.searchParam / 2);
    } else {
        gWalk = kWalkLine;
        gCX = gBest.x;
        gCY = gBest.y;
        gCount = 2 * max(pc.searchParam, 0);
    }
}

// The batch after the one just checked
void NextBatch() {
    if (gWalk == kWalkDiamondA) {
        gDirection = gDir;
        if (gDirection != 0) {
            // the two directions across the one taken, from where it went
            gLastDirection = gDirection;
            gCX = gBest.x;
            gCY = gBest.y;
            DiamondBatch(kWalkDiamondB, (gLastDirection & 3) != 0 ? 0x84u : 0x21u, 2);
        } else {
            // the diagonals beside the directions tried
            int l = gLastDirection;
            if (l == 1)
                DiamondBatch(kWalkDiamondB, 0x95u, 2);
            else if (l == 2)
                DiamondBatch(kWalkDiamondB, 0xA6u, 2);
            else if (l == 4)
                DiamondBatch(kWalkDiamondB, 0x65u, 2);
            else if (l == 8)
                DiamondBatch(kWalkDiamondB, 0xA9u, 2);
            else if (l == 5)
                DiamondBatch(kWalkDiamondB, 0x965u, 3);
            else if (l == 6)
                DiamondBatch(kWalkDiamondB, 0xA65u, 3);
            else if (l == 9)
                DiamondBatch(kWalkDiamondB, 0x9A5u, 3);
            else if (l == 10)
                DiamondBatch(kWalkDiamondB, 0x96Au, 3);
            else
                DiamondBatch(kWalkDiamondB, 0xA965u, 4);
        }
    } else if (gWalk == kWalkDiamondB) {
        gDirection = gDir;
        if (gDirection > 0) {
            DiamondIteration();
        } else {
            gR /= 2;
            if (gR > 0) {
                gDirection = 15;
                DiamondIteration();
            } else {
                gWalk = kWalkDone;
            }
        }
    } else if (gWalk == kWalkExpand) {
        // Exhaustive's next ring around the same centre; Hex2Search's closing square ends either search
        if (pc.search == 1 && gR < pc.searchParam)
            Expand(gR + 1, gCX, gCY);
        else
            gWalk = kWalkDone;
    } else if (gWalk == kWalkHexInit) {
        int dir = gDir;
        if (dir != -2) {
            gBmx += kHex2[dir + 1].x;
            gBmy += kHex2[dir + 1].y;
            gHexDir = dir;
            gHexStep = 1;
            Hex2Loop();
        } else {
            Hex2End();
        }
    } else if (gWalk == kWalkHexStep) {
        int dir = gDir;
        if (dir == -2) {
            Hex2End();
        } else {
            gBmx += kHex2[dir + 1].x;
            gBmy += kHex2[dir + 1].y;
            gHexDir = dir;
            ++gHexStep;
            Hex2Loop();
        }
    } else if (gWalk == kWalkUmhCross) {
        gWalk = kWalkUmhHex;
        gUmhScale = 1;
        gCount = 16;
    } else if (gWalk == kWalkUmhHex) {
        if (++gUmhScale <= pc.searchParam / 4)
            gCount = 16;
        else
            Hex2();
    } else {
        gWalk = kWalkDone;
    }
}

// C++'s a / b for b > 0, truncated toward zero
int DivT(int a, int b) {
    return a >= 0 ? a / b : -(-a / b);
}

int64_t DivT64(int64_t a, int64_t b) {
    return a >= 0 ? a / b : -(-a / b);
}

ivec4 Old(int bx, int by) {
    return oldRec[by * pc.recStrideOld + bx];
}

// mvu's RescaleToPel: an old vector's component in the super's pel, exact toward a finer pel, rounded
// to the nearest position alike for both signs toward a coarser one
int RescaleToPel(int v) {
    if (pc.oldPelShift >= 0)
        return v * (1 << pc.oldPelShift);
    int shift = -pc.oldPelShift, round = 1 << (shift - 1);
    return v >= 0 ? (v + round) >> shift : -((round - v) >> shift);
}

// mvu's predictor for block (bx, by): the old vectors interpolated at its centre (smooth), or the
// nearest old block's, in mvu's integer arithmetic, rescaled to the super's pel and clipped to the
// vectors the planes hold the block for
ivec2 Predictor(int bx, int by) {
    int centerX = kBlkX / 2 + pc.step * bx, centerY = kBlkY / 2 + pc.stepY * by;
    int bxOld = DivT(centerX - pc.blkOld / 2, pc.stepOld), byOld = DivT(centerY - pc.blkOldY / 2, pc.stepOldY);
    int deltaX = max(0, centerX - (pc.blkOld / 2 + pc.stepOld * bxOld)), deltaY = max(0, centerY - (pc.blkOldY / 2 + pc.stepOldY * byOld));
    int bx1 = min(pc.nbxOld - 1, max(0, bxOld)), bx2 = min(pc.nbxOld - 1, max(0, bxOld + 1));
    int by1 = min(pc.nbyOld - 1, max(0, byOld)), by2 = min(pc.nbyOld - 1, max(0, byOld + 1));
    ivec2 v;
    if (pc.smoothing != 0) {
        ivec2 v1 = Old(bx1, by1).xy, v2 = Old(bx2, by1).xy, v3 = Old(bx1, by2).xy, v4 = Old(bx2, by2).xy;
        ivec2 a = v1 * pc.stepOld + deltaX * (v2 - v1), b = v3 * pc.stepOld + deltaX * (v4 - v3);
        v = ivec2(DivT(a.x + DivT(deltaY * (b.x - a.x), pc.stepOldY), pc.stepOld), DivT(a.y + DivT(deltaY * (b.y - a.y), pc.stepOldY), pc.stepOld));
    } else {
        bool right = deltaX * 2 >= pc.stepOld, down = deltaY * 2 >= pc.stepOldY;
        v = Old(right ? bx2 : bx1, down ? by2 : by1).xy;
    }
    v = ivec2(RescaleToPel(v.x), RescaleToPel(v.y));
    return clamp(v, gBounds.xy, gBounds.zw - 1);
}

void main() {
    int bx = int(gl_WorkGroupID.x), by = int(gl_WorkGroupID.y);
    gLane = int(gl_SubgroupInvocationID);
    gX = pc.pad + bx * pc.step;
    gY = pc.padY + by * pc.stepY;
    gXc = pc.padc + bx * (pc.step >> kLogX);
    gYc = pc.padcY + by * (pc.stepY >> kLogY);
    if (kSatd) {
        if (kKeepT) {
            [[unroll]] for (int k = 0; k < kTilesPer; ++k) {
                int t = gLane + k * kSubgroup, tx = (t % kTilesX) * 4, ty = (t / kTilesX) * 4;
                [[unroll]] for (int i = 0; i < 16; ++i)
                    gSrcT[16 * k + i] = t < kTiles ? SrcSample(gX + tx + (i & 3), gY + ty + (i >> 2)) : 0u;
            }
        }
    }
    if (kKeep) {
        if (!kSatd) {
            [[unroll]] for (int k = 0; k < kLumaPer; ++k) {
                int i = gLane + k * kSubgroup;
                gSrcY[k] = i < kBlkX * kBlkY ? SrcSample(gX + i % kBlkX, gY + i / kBlkX) : 0u;
            }
        }
        [[unroll]] for (int k = 0; k < kChromaPer; ++k) {
            int i = gLane + k * kSubgroup;
            bool live = kChromaSad && i < kBlkCX * kBlkCY;
            uvec2 c = live ? SrcChromaUV(gXc + i % kBlkCX, gYc + i / kBlkCX) : uvec2(0u);
            gSrcU[k] = c.x;
            gSrcV[k] = c.y;
        }
    }

    // The vectors the padded planes hold the block for (mvu's search boundaries)
    int paddedW = pc.aw + 2 * pc.pad, paddedH = pc.ah + 2 * pc.padY;
    gBounds = ivec4(-gX * kPel, -gY * kPel, (paddedW - gX - kBlkX) * kPel, (paddedH - gY - kBlkY) * kPel);
    gPred = Predictor(bx, by);
    gLambda = by == 0 ? 0l : int64_t(pc.lambda);

    u64vec2 s = Sads(gPred.x, gPred.y);
    gBest = gPred;
    gBestSad = s.x + s.y;
    gMinCost = int64_t(gBestSad);
    if (gBestSad > Thsad()) {
        // mvu's search, the walk's batches checked here, the one place Check is called
        StartWalk();
        while (gWalk != kWalkDone) {
            for (int k = 0; k < gCount; ++k) {
                ivec2 v;
                int flags, val;
                WalkCandidate(k, v, flags, val);
                Check(v.x, v.y, flags, val);
            }
            NextBatch();
        }
    }
    // (the record's SAD is 32 bits: a float SAD past them, of samples far outside their range, saturates)
    if (subgroupElect())
        outRec[by * pc.recStride + bx] = ivec4(gBest, int(uint(min(gBestSad, 0xFFFFFFFFul))), 0);
}
