#version 460
#extension GL_GOOGLE_include_directive : require
#define NO_BLOCK_CACHE
#include "pyr_common.glsl"

layout(local_size_x_id = 2) in;

// The median of level pc.level's vectors, as Sim::Median takes it (the value at index count / 2 of
// the sorted values), times medianScale, into the field's medianSlot; x, then y. One workgroup of
// up to 1024 lanes (specialization constant 2), in two rounds of a histogram in shared memory: the
// first counts the values by (value + kOffset) >> 4, the second the values of the bin the median
// fell in by their low 4 bits. In each, each lane sums a run of bins, a scan over the lanes finds the
// run the median falls in, and that lane walks it. Vectors stay within +-kOffset (Analyse.cpp checks
// the levels' sizes, SuperLayout's maxCoarseVector), and the histogram fits the 32 KB of shared
// memory Vulkan guarantees. One workgroup per field of the batch; dispatched as (1, 1, fields).
const int kBins = 8128, kOffset = kBins * 16 / 2;
shared uint sHist[kBins];
shared uint sTotals[32]; // per subgroup: at most 1024 lanes in subgroups of at least 32
shared uint sFound[2];   // the round's bin the median falls in, and the values in the bins before it

// The bin of histogram bins (bins of them) the k-th value falls in, and the values before it, into
// sFound; every lane of the workgroup must call it, after the histogram is complete
void FindBin(int bins, uint k) {
    int lanes = int(gl_WorkGroupSize.x), t = int(WorkgroupLane());
    int run = (bins + lanes - 1) / lanes;
    uint sum = 0u;
    for (int i = t * run; i < min(t * run + run, bins); ++i)
        sum += sHist[i];
    uint inSubgroup = subgroupInclusiveAdd(sum);
    if (gl_SubgroupInvocationID == gl_SubgroupSize - 1u)
        sTotals[gl_SubgroupID] = inSubgroup;
    barrier();
    uint after = inSubgroup;
    for (uint s = 0u; s < gl_SubgroupID; ++s)
        after += sTotals[s];
    uint before = after - sum;
    if (before <= k && k < after) {
        uint seen = before;
        for (int i = t * run; i < min(t * run + run, bins); ++i) {
            if (seen + sHist[i] > k) {
                sFound[0] = uint(i);
                sFound[1] = seen;
                break;
            }
            seen += sHist[i];
        }
    }
    barrier();
}

void main() {
    Level lv = levels[pc.level];
    SetupField(int(gl_WorkGroupID.z));
    int lanes = int(gl_WorkGroupSize.x);
    int t = int(WorkgroupLane());
    int count = lv.nbx * lv.nby;
    uint k = uint(count) / 2u;
    for (int comp = 0; comp < 2; ++comp) {
        // the values' high bits
        for (int i = t; i < kBins; i += lanes)
            sHist[i] = 0u;
        barrier();
        for (int b = t; b < count; b += lanes) {
            ivec2 v = levelVec[gFieldBase + lv.fieldOff + b];
            atomicAdd(sHist[((comp == 0 ? v.x : v.y) + kOffset) >> 4], 1u);
        }
        barrier();
        FindBin(kBins, k);
        uint high = sFound[0], before = sFound[1];
        barrier();
        // the low bits of the values in that bin
        if (t < 16)
            sHist[t] = 0u;
        barrier();
        for (int b = t; b < count; b += lanes) {
            ivec2 v = levelVec[gFieldBase + lv.fieldOff + b];
            int u = (comp == 0 ? v.x : v.y) + kOffset;
            if (uint(u >> 4) == high)
                atomicAdd(sHist[u & 15], 1u);
        }
        barrier();
        FindBin(16, k - before);
        if (t == 0) {
            int value = (int(high << 4u | sFound[0]) - kOffset) * pc.medianScale;
            if (comp == 0)
                medians[gMedianBase + pc.medianSlot].x = value;
            else
                medians[gMedianBase + pc.medianSlot].y = value;
        }
        barrier();
    }
}
