#version 460
#extension GL_GOOGLE_include_directive : require
#define NO_BLOCK_CACHE
#define PYRAMID_BUILD
#include "pyr_common.glsl"

layout(local_size_x = 64) in;

// One level of a frame's pyramid from the level below it, with mvu.Super's default filter
// (RB2BilinearFiltered, the CPU reference's Reduce): 1/8, 3/8, 3/8, 1/8 vertically, then the same
// horizontally, a plain average of two at the edges. Level 1 reads the frame's super planes
// (bindings 0 and 2, their full-pel planes inside the padding), later levels the pyramid itself.
// The border is part of the output: a border pixel gets the value of the nearest edge pixel,
// computed again at that position, which is what SmallPlane::At's clamping reads there. One lane
// per pixel, border included, 64 pixels of a row per workgroup, the plane (Y, U, V) in z;
// dispatched as ((w + 2 * borderY + 63) / 64, h + 2 * borderY, 3) with w x h the level's luma size.
// (Four pixels per lane written as one word was slower: the reads dominate, and fewer lanes hide
// less of their latency.)

int gPlane, gW, gH, gBase, gStride; // the source plane

int Src(int x, int y) {
    int i = gBase + clamp(y, 0, gH - 1) * gStride + clamp(x, 0, gW - 1);
    if (pc.level > 1)
        return int(pyr[i]);
    return int(gPlane == 0 ? curY[i] : curC[i]);
}

// The vertical filter at source column x for destination row y of a plane dh rows high
int Column(int x, int y, int dh) {
    if (y == 0 || y == dh - 1)
        return (Src(x, 2 * y) + Src(x, 2 * y + 1) + 1) >> 1;
    return (Src(x, 2 * y - 1) + (Src(x, 2 * y) + Src(x, 2 * y + 1)) * 3 + Src(x, 2 * y + 2) + 4) >> 3;
}

void main() {
    gPlane = int(gl_WorkGroupID.z);
    if (pc.level == 1) {
        if (gPlane == 0) {
            gW = pc.w;
            gH = pc.h;
            gStride = pc.wp;
            gBase = pc.pad * pc.wp + pc.pad;
        } else {
            gW = pc.w / 2;
            gH = pc.h / 2;
            gStride = pc.wc;
            gBase = (gPlane - 1) * 4 * pc.wc * pc.hc + pc.padc * pc.wc + pc.padc;
        }
    } else {
        Level s = levels[pc.level - 1];
        gW = gPlane == 0 ? s.w : s.wc;
        gH = gPlane == 0 ? s.h : s.hc;
        gStride = gPlane == 0 ? s.strideY : s.strideC;
        gBase = gPlane == 0 ? s.offY : gPlane == 1 ? s.offU : s.offV;
    }
    Level d = levels[pc.level];
    int dw = gPlane == 0 ? d.w : d.wc, dh = gPlane == 0 ? d.h : d.hc;
    int border = gPlane == 0 ? d.borderY : d.borderC, stride = gPlane == 0 ? d.strideY : d.strideC;
    int xp = int(gl_GlobalInvocationID.x) - border, yp = int(gl_WorkGroupID.y) - border;
    if (xp >= dw + border || yp >= dh + border)
        return;
    int x = clamp(xp, 0, dw - 1), y = clamp(yp, 0, dh - 1);
    int v;
    if (x == 0)
        v = (Column(0, y, dh) + Column(1, y, dh) + 1) >> 1;
    else if (x == dw - 1)
        v = (Column(2 * x, y, dh) + Column(2 * x + 1, y, dh) + 1) >> 1;
    else
        v = (Column(2 * x - 1, y, dh) + (Column(2 * x, y, dh) + Column(2 * x + 1, y, dh)) * 3 + Column(2 * x + 2, y, dh) + 4) >> 3;
    int off = gPlane == 0 ? d.offY : gPlane == 1 ? d.offU : d.offV;
    pyr[off + yp * stride + xp] = uint8_t(v);
}
