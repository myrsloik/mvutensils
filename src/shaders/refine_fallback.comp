#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_ballot : require
#define BLOCKS_PER_WORKGROUP 1
#include "refine_common.glsl"

// kFallbackSubgroups subgroups per block (specialization constant 4 sizes the workgroup)
layout(local_size_x_id = 4) in;

layout(std430, set = 0, binding = 15) readonly buffer Flagged { uint dispatchX; uint dispatchY; uint dispatchZ; uint flagged[]; };

// The blocks refine_flag.comp listed, whose SAD is still above badSad, try every position
// fallbackStep px apart within fallbackRadius px of their predictor, then the positions up to
// fallbackStep - 1 px around the best, every position's SAD with pnew's penalty. One listed block per workgroup of one or more subgroups,
// its positions spread over all the lanes; each step's best is one 64-bit minimum of cost and
// position in scan order, so the first of the cheapest wins, as on the CPU. The flagged blocks are
// few, so more lanes per block keep more of the GPU busy. Reads field A, which no lane changes;
// the result goes to entry i of field B, i the block's place in the list, and refine_apply.comp
// copies it to A once every block is searched.
//
// The wide search is a branch and bound, exact: a position can only win if it costs less than the
// block's current vector and no more than every position measured so far, and its cost only grows
// as its SAD adds up (the penalty with it). The phases' lists keep each position's SAD so far, of
// which its cost follows. So a position whose partial cost passes that bound is dropped; the winner
// never is, since the bound never falls below its cost. The SAD adds up in kUnits equal units,
// unit u being luma rows 2u and 2u + 1 and the chroma rows beside them (U and V), row u where
// chroma is subsampled vertically (4:2:0, 4:4:0), 2u and 2u + 1 where it isn't (4:2:2, 4:4:4), or
// the luma rows alone without chroma; with kSatd luma rows 4u to 4u + 3, a band of luma's SATD tiles,
// and the chroma rows beside them. In three phases: every position's first units, then the next
// for the positions still within the bound, then the rest for those still within it, each phase's
// survivors gathered into a list so that every lane stays busy.
// Measured on the CPU at 16x16, 8-24% of the positions survive five units.
// (Dropping each position at whichever unit passes the bound, every lane moving on by itself,
// saved more units but was slower: the lanes then diverge at every step.)

const int kUnitRows = kSatd ? 4 : 2;
const int kUnits = kBlkY / kUnitRows;
// Units in the first phase: 4 of 16, 2 of 8, 1 of 4 or fewer; and up to 10, 5 and 2 after the second
const int kPhase1 = kUnits / 4 > 1 ? kUnits / 4 : 1;
const int kPhase2 = kUnits * 5 / 8 > kPhase1 ? kUnits * 5 / 8 : kPhase1;
const int kPerLane = 4; // positions per lane in a batch
// Blocks of 8x8 pixels or fewer, or fewer than 8 rows, take their positions' whole SADs at once, and so
// do float samples, whose SADs mvu sums in an order that doesn't add up unit by unit (LaneSadF)
// (selects rather than ||, as the core's compiler needs: refine_common.glsl's kCurWords)
const bool kWhole = (kFloatS ? 1 : (kBlkY < 8 ? 1 : (kBlkX * kBlkY <= 64 ? 1 : 0))) != 0;

shared uint64_t sKey[8];              // per subgroup: its least key
shared uint sPartial[8];              // per subgroup: its part of the block's pixel sum
shared uint sUnitSum[kUnits];         // the block's pixel sum per unit
shared uint sUnitBefore[kUnits + 1];  // and the sum of the units before each, the last the whole block's
shared uint sBound;                   // a position costing more can't win
shared uint sCount[2];                // entries in sList[0] and sList[1]
// The survivors of phase 0 and of phase 1: column | row << 16, and the SAD so far; one entry each
// where the search doesn't run in phases (kWhole; shared memory counts even when unused)
shared uvec2 sList[2][kWhole ? 1 : kPerLane * gl_WorkGroupSize.x];

// The least of every lane's key; every lane of the workgroup must call it
uint64_t WorkgroupMin(uint64_t key) {
    key = subgroupMin(key);
    if (subgroupElect())
        sKey[gl_SubgroupID] = key;
    barrier();
    uint64_t least = sKey[0];
    for (uint i = 1u; i < gl_NumSubgroups; ++i)
        least = min(least, sKey[i]);
    barrier();
    return least;
}

// Appends (pos, sad) to sList[list] where keep is set; every active lane of the subgroup must call it
void Append(int list, bool keep, uint pos, uint sad) {
    uvec4 ballot = subgroupBallot(keep);
    uint base = 0u;
    if (subgroupElect())
        base = atomicAdd(sCount[list], subgroupBallotBitCount(ballot));
    base = subgroupBroadcastFirst(base);
    if (keep)
        sList[list][base + subgroupBallotExclusiveBitCount(ballot)] = uvec2(pos, sad);
}

// The lane's position: its SAD's word addresses and shifts as LaneSad computes them (or its chroma
// rows' sample address in the quarter-pel image), its lambda term (saturated to 32 bits: anything
// that large passes every bound), and the partial sums of the units measured
int64_t gLam;
uint gW, gShift, gWC, gShiftC, gSa, gSm;

void Setup(ivec2 v, ivec2 p, int64_t lambda) {
    // The search's positions are whole pels (at pel 4 on the full-pel grid, ClampFull); at pel 2 a
    // clamped one near it may not be
    uint a = LumaAddr(kPel * (gX + pc.pad) + v.x, kPel * (gY + pc.padY) + v.y);
    gW = WordOf(a);
    gShift = ShiftOf(a);
    ivec2 vc = ChromaVector(v);
    int Xc = kPel * ((gX >> kLogCX) + pc.padc) + vc.x, Yc = kPel * ((gY >> kLogCY) + pc.padcY) + vc.y;
    uint ac = ChromaAddr(Xc, Yc);
    if (kImage) {
        gWC = ac;
    } else {
        gWC = WordOf(ac);
        gShiftC = ShiftOf(ac);
    }
    int dx = v.x - p.x, dy = v.y - p.y;
    gLam = (lambda * int64_t(dx * dx + dy * dy)) >> 8;
    gSa = 0u;
    gSm = 0u;
}

// The cost of the lane's position (Setup) with SAD sad: its lambda term, the SAD and pnew's penalty
int64_t PositionCost(uint sad) {
    return gLam + int64_t(sad) + Penalty(sad, PNew());
}

// The bound's cap: a cost within it plus the block's largest SAD stays within 32 bits; and it stays
// below 2^32 - 2^20 (2^32 - 2^28 for 16-bit samples) as long as that does
uint BoundCap() {
    return min(kWide ? 0xF0000000u : 0xFFF00000u, 0xFFFFFFFFu - uint(kBlockPixels) * (kWide ? 65535u : 255u));
}

// Adds unit u of the lane's position to its partial sums (luma's SATD to gSa with kSatd)
void Unit(int u) {
    uint stride = uint(pc.wp) >> uint(kLogSPW), strideC = uint(2 * pc.wc) >> uint(kLogSPW);
    if (kSatd) {
        gSa += BandSatd(gW, gShift, stride, 4 * u, 0);
    } else {
        [[unroll]] for (int jj = 0; jj < 2; ++jj) {
            int j = 2 * u + jj;
            uint wj = gW + uint(j) * stride;
            uint lo = RefYWord(wj);
            [[unroll]] for (int i = 0; i < kRowWords; ++i) {
                uint hi = RefYWord(wj + uint(i) + 1u);
                PackedStep(Bytes4(lo, hi, gShift), j * kRowWords + i, gSa, gSm);
                lo = hi;
            }
        }
    }
    if (!kChroma)
        return;
    int curC = kLumaWords;
    // chroma rows kUnitRows * u >> kLogCY up to before kUnitRows * (u + 1) >> kLogCY, U and V
    // interleaved
    [[unroll]] for (int jj = 0; jj < (kUnitRows >> kLogCY); ++jj) {
        int jc = ((kUnitRows * u) >> kLogCY) + jj;
        if (kImage) {
            uint a = gWC + uint(jc * ChromaRow());
            [[unroll]] for (int i = 0; i < kRowWordsC; ++i)
                PackedStep(StridedWord(a + uint(4 * kSPW * i)), curC + jc * kRowWordsC + i, gSa, gSm);
            continue;
        }
        uint r = gWC + uint(jc) * strideC;
        uint lo = RefCWord(r);
        [[unroll]] for (int i = 0; i < kRowWordsC; ++i) {
            uint hi = RefCWord(r + uint(i) + 1u);
            PackedStep(Bytes4(lo, hi, gShiftC), curC + jc * kRowWordsC + i, gSa, gSm);
            lo = hi;
        }
    }
}

// The SAD of units ua .. ub - 1, measured since Setup (16-bit samples sum the SAD itself)
uint UnitsSad(int ua, int ub) {
    return kWide ? gSa : gSa + (sUnitBefore[ub] - sUnitBefore[ua]) - 2u * gSm;
}

void main() {
    int lanes = int(gl_WorkGroupSize.x), lane = int(WorkgroupLane());
    int entry = int(gl_WorkGroupID.x);
    int b = int(flagged[entry]);
    int bx = b % pc.nbx, by = b / pc.nbx;
    // The block's current pixels as LoadBlock lays them out, loaded by all the lanes, their sum and
    // their sum per unit (with kSatd chroma's alone, as LoadBlock's)
    gGroup = 0;
    gX = bx * pc.step;
    gY = by * pc.stepY;
    if (lane < kUnits)
        sUnitSum[lane] = 0u;
    barrier();
    uint partial = 0u;
    for (int k = lane; k < (kFloatS ? 0 : kBlockWords); k += lanes) {
        uint px[4] = uint[4](0u, 0u, 0u, 0u);
        for (int i = 0; i < kSPW; ++i)
            px[i] = CurSample(k, i);
        int unit = k < kLumaWords ? k / kRowWords / kUnitRows : (((k - kLumaWords) / kRowWordsC) << kLogCY) / kUnitRows;
        uint sum = (kSatd ? k >= kLumaWords : true) ? px[0] + px[1] + px[2] + px[3] : 0u;
        partial += sum;
        atomicAdd(sUnitSum[unit], sum);
        StoreWord(k, px[0], px[1], px[2], px[3]);
    }
    partial = subgroupAdd(partial);
    if (subgroupElect())
        sPartial[gl_SubgroupID] = partial;
    barrier();
    gSumCur = 0u;
    for (uint i = 0u; i < gl_NumSubgroups; ++i)
        gSumCur += sPartial[i];

    ivec2 p;
    int64_t lambda;
    Context(b, p, lambda);
    ivec2 best = vecA[b];
    uint bestSad = sadA[b];
    int64_t bestCost = Cost(bestSad, best, p, lambda);
    if (lane == 0) {
        uint before = 0u;
        for (int u = 0; u < kUnits; ++u) {
            sUnitBefore[u] = before;
            before += sUnitSum[u];
        }
        sUnitBefore[kUnits] = before;
        // capped (BoundCap); the positions searched cost far less but for the largest blocks at 16
        // bits, which take their whole SADs at once where their cost passes the cap (below)
        sBound = uint(clamp(bestCost - 1, int64_t(0), int64_t(BoundCap())));
    }
    barrier();

    // On the full-pel grid: the predictor rounded down to it, the positions every fallbackStep px
    // from the window's first full-pel position
    int R = pc.fallbackRadius, stepH = kPel * pc.fallbackStep;
    ivec2 c0 = ivec2(p.x & ~(kPel - 1), p.y & ~(kPel - 1));
    ivec2 lo = ClampFull(c0 - ivec2(kPel * R)), hi = ClampFull(c0 + ivec2(kPel * R));
    int x0 = (lo.x + kPel - 1) & ~(kPel - 1), y0 = (lo.y + kPel - 1) & ~(kPel - 1);
    int nx = hi.x >= x0 ? (hi.x - x0) / stepH + 1 : 0, ny = hi.y >= y0 ? (hi.y - y0) / stepH + 1 : 0;
    int total = nx * ny;
    // cost << 24 | position: fewer than 2^24 positions, costs far below 2^40
    uint64_t mine = kNoKey;
    int batch = kPerLane * lanes;
    int dc = nx > 0 ? lanes % nx : 0, dr = nx > 0 ? lanes / nx : 0;
    // Small blocks' units are too small to pay for the phases' bookkeeping: every position gets its
    // whole SAD at once, as LaneSad measures it; so does a block whose cost passes the bound's cap,
    // which the phases' 32-bit costs couldn't bound exactly (the same in every lane)
    if (kWhole || bestCost - 1 > int64_t(BoundCap())) {
        for (int k = lane; k < total; k += lanes) {
            ivec2 v = ivec2(x0 + (k % nx) * stepH, y0 + (k / nx) * stepH);
            uint s = LaneSad(v);
            mine = min(mine, (uint64_t(Cost(s, v, p, lambda) + Penalty(s, PNew())) << 24) | uint64_t(k));
        }
    } else for (int base = 0; base < total; base += batch) {
        int count = min(batch, total - base);
        if (lane < 2)
            sCount[lane] = 0u;
        barrier();
        // Phase 0: the batch's positions, kPhase1 units each
        uint bound = sBound;
        int col = (base + lane) % nx, row = (base + lane) / nx;
        for (int idx = lane; idx < count; idx += lanes) {
            bool keep = false;
            uint sad = 0u;
            Setup(ivec2(x0 + col * stepH, y0 + row * stepH), p, lambda);
            if (gLam <= int64_t(bound)) {
                for (int u = 0; u < kPhase1; ++u)
                    Unit(u);
                sad = UnitsSad(0, kPhase1);
                keep = PositionCost(sad) <= int64_t(bound);
            }
            Append(0, keep, uint(col) | (uint(row) << 16u), sad);
            col += dc;
            row += dr;
            if (col >= nx) {
                col -= nx;
                ++row;
            }
        }
        // Phase 1: the survivors' next units; phase 2: the rest
        for (int phase = 1; phase <= 2; ++phase) {
            barrier();
            bound = sBound;
            int n = int(sCount[phase - 1]);
            int ua = phase == 1 ? kPhase1 : kPhase2, ub = phase == 1 ? kPhase2 : kUnits;
            for (int e = lane; e < n; e += lanes) {
                bool keep = false;
                uint sad = 0u;
                uvec2 entry = sList[phase - 1][e];
                int pc0 = int(entry.x & 0xFFFFu), pr0 = int(entry.x >> 16u);
                Setup(ivec2(x0 + pc0 * stepH, y0 + pr0 * stepH), p, lambda);
                if (PositionCost(entry.y) <= int64_t(bound)) {
                    for (int u = ua; u < ub; ++u)
                        Unit(u);
                    sad = entry.y + UnitsSad(ua, ub);
                    int64_t c = PositionCost(sad);
                    if (c <= int64_t(bound)) {
                        if (phase == 2) {
                            mine = min(mine, (uint64_t(c) << 24) | uint64_t(pr0 * nx + pc0));
                            atomicMin(sBound, uint(c));
                            bound = uint(c);
                        } else {
                            keep = true;
                        }
                    }
                }
                if (phase == 1)
                    Append(1, keep, entry.x, sad);
            }
        }
        barrier();
    }
    // A winner's SAD follows from its cost less its lambda term, so it needn't be measured again
    uint64_t found = WorkgroupMin(mine);
    if (total > 0 && int64_t(found >> 24) < bestCost) {
        int k = int(found & 0xFFFFFFul);
        best = ivec2(x0 + (k % nx) * stepH, y0 + (k / nx) * stepH);
        bestCost = int64_t(found >> 24);
        bestSad = SadOfPenalized(bestCost - Cost(0u, best, p, lambda), PNew());
    }
    if (pc.fallbackStep > 1) {
        // The positions up to fallbackStep - 1 px around the best in the CPU's order; one equal to
        // the best, which the CPU skips, has its cost and can't win either. Cost << 8 | position:
        // fallbackStep stays below 9. 8 lanes measure a position together, kUnits / 8 units each
        // (with fewer than 16 rows some lanes one unit, the others idle), so that its SAD takes one
        // round of loads instead of all of them.
        // At pel 4 around the best rounded down to the full-pel grid: the block's own vector, kept
        // when nothing in the window beat it, may be on the half-pel grid
        ivec2 cc = kPel == 4 ? ivec2(best.x & ~3, best.y & ~3) : best;
        int r1 = pc.fallbackStep - 1, side = 2 * r1 + 1, around = side * side;
        int sub = lane & 7, slot = lane >> 3, perRound = lanes >> 3;
        uint64_t near = kNoKey;
        // (float samples: a position's whole SAD in one lane)
        for (int k = lane; k < (kFloatS ? around : 0); k += lanes) {
            ivec2 v = ClampFull(cc + kPel * ivec2(k % side - r1, k / side - r1));
            if (v != cc) {
                uint sad = LaneSad(v);
                near = min(near, (uint64_t(Cost(sad, v, p, lambda) + Penalty(sad, PNew())) << 8) | uint64_t(k));
            }
        }
        for (int k0 = 0; k0 < (kFloatS ? 0 : around); k0 += perRound) {
            int k = k0 + slot;
            ivec2 v = ClampFull(cc + kPel * ivec2(k % side - r1, k / side - r1));
            bool live = k < around && v != cc;
            uint part = 0u;
            int ua = sub * kUnits / 8, ub = (sub + 1) * kUnits / 8;
            if (live && ua < ub) {
                Setup(v, p, lambda);
                for (int u = ua; u < ub; ++u)
                    Unit(u);
                part = UnitsSad(ua, ub);
            }
            uint sad = subgroupClusteredAdd(part, 8u);
            if (live && sub == 0)
                near = min(near, (uint64_t(Cost(sad, v, p, lambda) + Penalty(sad, PNew())) << 8) | uint64_t(k));
        }
        near = WorkgroupMin(near);
        if (near != kNoKey && int64_t(near >> 8) < bestCost) {
            int k = int(near & 0xFFul);
            best = ClampFull(cc + kPel * ivec2(k % side - r1, k / side - r1));
            bestSad = SadOfPenalized(int64_t(near >> 8) - Cost(0u, best, p, lambda), PNew());
        }
    }
    if (lane == 0) {
        if (best != vecA[b])
            lastChange[b] = pc.stamp;
        vecB[entry] = best;
        sadB[entry] = bestSad;
    }
}
