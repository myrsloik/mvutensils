#version 460
#extension GL_GOOGLE_include_directive : require
#include "flow_common.glsl"

layout(local_size_x = 64) in;

// The FlowParams slots compensate.comp gives its own meaning (Compensate.cpp): the SAD under which a
// block takes its vector (thsad, scaled), the grid's step and overlap, the clip's largest value, and
// where the plane's overlap windows are in taps[]
#define kThSad pc.thscd1
#define kStep pc.time4096FX
#define kOverlap pc.time4096FY
#define kPixelMax pc.time4096BX
#define kWinOff pc.colOff
#define kQuad pc.time4096BY // four pixels per lane (Main4)

// The reference super's planes and the output as words, for Main4
layout(std430, set = 0, binding = 2) readonly buffer RefLuma32 { uint refY32[]; };
layout(std430, set = 0, binding = 3) readonly buffer RefChroma32 { uint refC32[]; };
layout(std430, set = 0, binding = 12) writeonly buffer Out32 { uint outPx32[]; };

// C++'s a / 256, truncated toward zero
int Div256(int a) {
    return a >= 0 ? a >> 8 : -(-a >> 8);
}

// Where block (bx, by)'s pixel at the plane's (x, y) comes from: true with its position (X, Y), 1 / pel
// pixels of the plane, in the reference frame's super (bound as ref) when the block's SAD is under
// thsad, at its vector scaled to the time (Compensate.cpp's blx, bly, chroma's the luma position
// shifted by the subsampling); else false, the clip's own pixel
bool Source(int bx, int by, int x, int y, int Sx, int Sy, out int X, out int Y) {
    ivec4 r = vecF[by * pc.recStride + bx];
    if (r.z >= kThSad)
        return false;
    int blx = bx * kStep * kPel + Div256(r.x * pc.time256), bly = by * kStep * kPel + Div256(r.y * pc.time256);
    if (pc.plane != 0) {
        blx >>= kLogX;
        bly >>= kLogY;
    }
    X = blx + (x - bx * Sx) * kPel;
    Y = bly + (y - by * Sy) * kPel;
    return true;
}

// The four bytes from byte a on, of words w0 (holding byte a) and w1
uint Funnel4(uint w0, uint w1, uint a) {
    uint s = (a & 3u) * 8u;
    return s == 0u ? w0 : (w0 >> s) | (w1 << (32u - s));
}
uvec4 Unpack4(uint w) {
    return uvec4(w & 0xFFu, (w >> 8u) & 0xFFu, (w >> 16u) & 0xFFu, w >> 24u);
}

// Sample()'s four samples at (X, Y), (X + kPel, Y), ..., 8-bit at pel 1 or 2: where none of them is
// clamped they are four bytes in a row of one plane, read as words (the super's spare rows keep the
// word after the last pixel inside it); else one at a time
uvec4 Sample4(int X, int Y) {
    bool luma = pc.plane == 0;
    int stride = luma ? pc.wp : pc.wc, rows = luma ? pc.hp : pc.hc;
    int Xp = X + kPel * (luma ? pc.pad : pc.padc), Yp = Y + kPel * (luma ? pc.padY : pc.padcY);
    if (Xp >= 0 && Xp + 3 * kPel <= kPel * stride - 1 && Yp >= 0 && Yp <= kPel * rows - 1) {
        uint base = pc.plane == 2 ? uint(kChromaPlanes * pc.wc * pc.hc) : 0u;
        uint a = base + (kPel == 1 ? uint(Yp * stride + Xp) : HalfAddr(Xp, Yp, stride, rows)), i = a >> 2u;
        return Unpack4(luma ? Funnel4(refY32[i], refY32[i + 1u], a) : Funnel4(refC32[i], refC32[i + 1u], a));
    }
    return uvec4(Sample(true, X, Y), Sample(true, X + kPel, Y), Sample(true, X + 2 * kPel, Y), Sample(true, X + 3 * kPel, Y));
}

// main's arithmetic for four adjacent pixels per lane, 8-bit samples at pel 1 or 2, where the
// plane's step and overlap are multiples of 4 (Compensate.cpp sets kQuad): the four lie in the same
// blocks, their reference samples kPel apart in one row of one plane. Dispatched as
// ((width + 255) / 256, height) workgroups per plane.
void Main4() {
    int x = 4 * int(gl_GlobalInvocationID.x), y = int(gl_WorkGroupID.y);
    if (x >= pc.width)
        return;
    int inside = min(4, pc.width - x); // the group's pixels inside the plane
    uint at = uint(y * pc.outStride + x), c = uint(y * pc.clipStride + x);
    uvec4 own = uvec4(0u);             // the clip's pixels, read a byte at a time: a plane's last row may end its buffer
    [[unroll]] for (int i = 0; i < 4; ++i)
        if (i < inside)
            own[i] = uint(clipSrc[c + uint(i)]);
    uvec4 res;
    if (counts[0] > uint(pc.scdLimit)) {
        res = own;
    } else {
        bool luma = pc.plane == 0;
        int lx = luma ? 0 : kLogX, ly = luma ? 0 : kLogY;
        int Bx = (kStep + kOverlap) >> lx, By = (kStep + kOverlap) >> ly;
        int Sx = kStep >> lx, Sy = kStep >> ly;
        int Ox = kOverlap >> lx, Oy = kOverlap >> ly;
        int bxA = min(x / Sx, pc.nbx - 1), byA = min(y / Sy, pc.nby - 1);
        bool hasLeft = bxA >= 1 && x < bxA * Sx + Ox, hasUp = byA >= 1 && y < byA * Sy + Oy;
        uvec4 acc = uvec4(0u);
        for (int k = 3; k >= 0; --k) {
            if (((k & 1) != 0 && !hasLeft) || ((k & 2) != 0 && !hasUp))
                continue;
            int bx = (k & 1) != 0 ? bxA - 1 : bxA, by = (k & 2) != 0 ? byA - 1 : byA;
            int X, Y;
            uvec4 v = Source(bx, by, x, y, Sx, Sy, X, Y) ? Sample4(X, Y) : own;
            if (kOverlap == 0) {
                acc = v;
            } else {
                int wbx = bx == pc.nbx - 1 ? 2 : (bx == 0 ? 0 : 1);
                int wby = by == 0 ? 0 : (by == pc.nby - 1 ? 6 : 3);
                int t = kWinOff + ((wby + wbx) * By + y - by * Sy) * Bx + x - bx * Sx;
                acc += (v * uvec4(uint(taps[t]), uint(taps[t + 1]), uint(taps[t + 2]), uint(taps[t + 3]))) >> 6u;
            }
        }
        res = kOverlap == 0 ? acc : min((acc + 16u) >> 5u, uvec4(uint(kPixelMax)));
    }
    if (inside == 4 && (at & 3u) == 0u) {
        outPx32[at >> 2u] = res.x | (res.y << 8u) | (res.z << 16u) | (res.w << 24u);
    } else {
        [[unroll]] for (int i = 0; i < 4; ++i)
            if (i < inside)
                outPx[at + uint(i)] = uint8_t(res[i]);
    }
}

// mvu.Compensate's pixel of the plane: every block covering it, one or, inside the overlaps, two or
// four, gives it its motion compensated pixel (Source), weighted by the block's overlap window (mvu's
// OverlapWindows, the 9 of them for the frame's edges and corners, values to 2048), each product >> 6
// and added up in mvu's order, the row above before the block's own and the left column first, then
// (sum + 16) >> 5, clamped to the clip's largest value; without overlap the one block's pixel. Float
// clips take mvu's float arithmetic (overlaps_c, ToPixels): products / 64 added up from zero in the
// same order, then / 32, unclamped. Where the vectors are at a scene change (counts[0] above the
// limit), the clip's pixel. Dispatched as ((width + 63) / 64, height) workgroups per plane.
void main() {
    if (kQuad != 0) {
        Main4();
        return;
    }
    int x = int(gl_GlobalInvocationID.x), y = int(gl_WorkGroupID.y);
    if (x >= pc.width)
        return;
    uint at = uint(y * pc.outStride + x), c = uint(y * pc.clipStride + x);
    if (counts[0] > uint(pc.scdLimit)) {
        if (kFloat)
            outPxF[at] = clipSrcF[c];
        else if (kWide)
            outPx16[at] = clipSrc16[c];
        else
            outPx[at] = clipSrc[c];
        return;
    }
    bool luma = pc.plane == 0;
    int lx = luma ? 0 : kLogX, ly = luma ? 0 : kLogY;
    int Bx = (kStep + kOverlap) >> lx, By = (kStep + kOverlap) >> ly; // the plane's block size,
    int Sx = kStep >> lx, Sy = kStep >> ly;                           // step
    int Ox = kOverlap >> lx, Oy = kOverlap >> ly;                     // and overlap
    int bxA = min(x / Sx, pc.nbx - 1), byA = min(y / Sy, pc.nby - 1);
    bool hasLeft = bxA >= 1 && x < bxA * Sx + Ox, hasUp = byA >= 1 && y < byA * Sy + Oy;

    uint acc = 0u;
    float accF = 0.0;
    for (int k = 3; k >= 0; --k) {
        if (((k & 1) != 0 && !hasLeft) || ((k & 2) != 0 && !hasUp))
            continue;
        int bx = (k & 1) != 0 ? bxA - 1 : bxA, by = (k & 2) != 0 ? byA - 1 : byA;
        int X, Y;
        bool moved = Source(bx, by, x, y, Sx, Sy, X, Y);
        int win = 2048;
        if (kOverlap != 0) {
            int wbx = bx == pc.nbx - 1 ? 2 : (bx == 0 ? 0 : 1);
            int wby = by == 0 ? 0 : (by == pc.nby - 1 ? 6 : 3);
            win = taps[kWinOff + ((wby + wbx) * By + y - by * Sy) * Bx + x - bx * Sx];
        }
        if (kFloat) {
            float v = moved ? SampleF(true, X, Y) : clipSrcF[c];
            if (kOverlap == 0) {
                accF = v;
            } else {
                precise float t = v * float(win);
                precise float u = t * (1.0 / 64.0);
                precise float a = accF + u;
                accF = a;
            }
        } else {
            uint v = moved ? Sample(true, X, Y) : (kWide ? uint(clipSrc16[c]) : uint(clipSrc[c]));
            if (kOverlap == 0)
                acc = v;
            else
                acc += (v * uint(win)) >> 6u;
        }
    }
    if (kFloat) {
        precise float v = kOverlap == 0 ? accF : accF * (1.0 / 32.0);
        outPxF[at] = v;
    } else {
        uint v = kOverlap == 0 ? acc : min((acc + 16u) >> 5u, uint(kPixelMax));
        if (kWide)
            outPx16[at] = uint16_t(v);
        else
            outPx[at] = uint8_t(v);
    }
}
