#version 460
#extension GL_GOOGLE_include_directive : require
#include "flow_common.glsl"

layout(local_size_x = 64) in;

// mvu.Flow's pixel of the plane (FlowShared.h's FlowFetch): the reference frame's sample, from its
// super bound as ref, at the pixel's vector scaled to pc.time256 and rounded, the vectors resized to
// the plane as for FlowInter; or the clip's pixel where the vectors are at a scene change (counts[0]
// above the limit). Chroma's lanes make U and V together, from the same vector. Dispatched as
// ((width + 63) / 64, height) workgroups per plane, luma and chroma.
void main() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_WorkGroupID.y);
    if (x >= pc.width)
        return;
    bool chroma = pc.plane != 0;
    uint at = uint(y * pc.outStride + x);
    if (counts[0] > uint(pc.scdLimit)) {
        uint c = uint(y * pc.clipStride + x);
        if (kFloat) {
            outPxF[at] = clipSrcF[c];
            if (chroma)
                outPxVF[at] = clipSrcVF[c];
        } else {
            Store(at, ClipPx(false, c));
            if (chroma)
                StoreV(at, ClipPxV(false, c));
        }
        return;
    }
    Weights(x, y);
    ivec2 v = VectorAt(0);
    int t = pc.time256;
    int X = x * kPel + ((v.x * t + 128) >> 8), Y = y * kPel + ((v.y * t + 128) >> 8);
    if (kFloat) {
        if (chroma) {
            vec2 s = SampleUVF(true, X, Y);
            outPxF[at] = s.x;
            outPxVF[at] = s.y;
        } else {
            outPxF[at] = SampleF(true, X, Y);
        }
    } else if (chroma) {
        uvec2 s = SampleUV(true, X, Y);
        Store(at, s.x);
        StoreV(at, s.y);
    } else {
        Store(at, Sample(true, X, Y));
    }
}
