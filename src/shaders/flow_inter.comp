#version 460
#extension GL_GOOGLE_include_directive : require
#include "flow_common.glsl"

layout(local_size_x = 64) in;

// An occlusion mask at the pixel, 0 .. 255: F's (base 0) or B's
int MaskAt(int base) {
    return Interpolate(int(masks[base + gJa * pc.nbx + gIa]), int(masks[base + gJa * pc.nbx + gIb]),
                       int(masks[base + gJb * pc.nbx + gIa]), int(masks[base + gJb * pc.nbx + gIb]));
}

// mvu.FlowInter's and mvu.FlowFPS's pixel of the plane at pc.time256 between the frames: where F
// and B have vectors and neither is at a scene change, FlowInter (the two compensations blended
// through the occlusion masks), or FlowInterExtra (the medians with the extra frames' compensations
// instead) where FF and BB serve too; else the clip's frames blended by the time, or the frame
// before. FlowInter's inner products reach 256 * 65535 * 256 at 16 bits, past int's range though
// within uint's (mvu takes int64), so they are unsigned. Dispatched as ((width + 63) / 64, height)
// workgroups per plane.
// main()'s pixel of a float clip, mvu's float arithmetic operation for operation: on x86 with
// AVX-512, where the computation is the most exact, mvu.FlowInter and FlowFPS run FlowInter and
// FlowInterExtra as the scalar code compiled with AVX-512, its contractible products fused, each
// (a * b) + c the compiler meets with the left product fused (fma here; precise, so nothing else
// is), and Blend unfused (SSE2 code). / 256 is exact; the integer path's - 1 isn't taken.
void MainFloat(int x, int y) {
    int t = pc.time256;
    uint limit = uint(pc.scdLimit);
    bool fb = (pc.flags & kHaveFB) != 0 && counts[0] <= limit && counts[1] <= limit;
    float result;
    if (!fb) {
        float s = clipSrcF[y * pc.clipStride + x];
        if ((pc.flags & kBlend) != 0) {
            precise float a = s * float(256 - t);
            precise float b = clipRefF[y * pc.clipStride + x] * float(t);
            precise float sum = a + b;
            result = sum * (1.0 / 256.0);
        } else {
            result = s;
        }
    } else {
        bool extra = (pc.flags & kHaveExtra) != 0 && counts[2] <= limit && counts[3] <= limit;
        Weights(x, y);
        ivec2 vF = VectorAt(0), vB = VectorAt(1);
        int mFi = MaskAt(0), mBi = MaskAt(pc.nbx * pc.nby);
        float mF = float(mFi), mB = float(mBi), iF = float(256 - mFi), iB = float(256 - mBi);
        int xBase = x * kPel, yBase = y * kPel;
        int vxF = (vF.x * t) >> 8, vyF = (vF.y * t) >> 8;
        int vxB = (vB.x * (256 - t)) >> 8, vyB = (vB.y * (256 - t)) >> 8;
        float dF = SampleF(false, xBase + vxF, yBase + vyF), dB = SampleF(true, xBase + vxB, yBase + vyB);
        if (extra) {
            ivec2 vFF = VectorAt(2), vBB = VectorAt(3);
            int vxFF = (vFF.x * t) >> 8, vyFF = (vFF.y * t) >> 8;
            int vxBB = (vBB.x * (256 - t)) >> 8, vyBB = (vBB.y * (256 - t)) >> 8;
            float dFF = SampleF(false, xBase + vxFF, yBase + vyFF), dBB = SampleF(true, xBase + vxBB, yBase + vyBB);
            // std::min and std::max: the first argument on ties
            float minfb = dF < dB ? dF : dB, maxfb = dB < dF ? dF : dB;
            float lowBB = maxfb < dBB ? maxfb : dBB, lowFF = maxfb < dFF ? maxfb : dFF;
            float medianBB = minfb < lowBB ? lowBB : minfb, medianFF = minfb < lowFF ? lowFF : minfb;
            precise float rF = dF * iF;
            precise float t1 = fma(medianBB, mF, rF) * (1.0 / 256.0);
            precise float rB = dB * iB;
            precise float t2 = fma(medianFF, mB, rB) * (1.0 / 256.0);
            precise float r2 = t2 * float(t);
            result = fma(t1, float(256 - t), r2) * (1.0 / 256.0);
        } else {
            float dF0 = SampleF(false, xBase, yBase), dB0 = SampleF(true, xBase, yBase);
            precise float pF0 = mB * dF0;
            precise float innerF = fma(dB, iB, pF0);
            precise float partF = (mF * innerF) * (1.0 / 256.0);
            precise float occF = fma(dF, iF, partF) * (1.0 / 256.0);
            precise float pB0 = mF * dB0;
            precise float innerB = fma(dF, iF, pB0);
            precise float partB = (mB * innerB) * (1.0 / 256.0);
            precise float occB = fma(dB, iB, partB) * (1.0 / 256.0);
            precise float rB = occB * float(t);
            result = fma(occF, float(256 - t), rB) * (1.0 / 256.0);
        }
    }
    outPxF[y * pc.outStride + x] = result;
}

void main() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_WorkGroupID.y);
    if (x >= pc.width)
        return;
    if (kFloat) {
        MainFloat(x, y);
        return;
    }
    int t = pc.time256;
    uint limit = uint(pc.scdLimit);
    bool fb = (pc.flags & kHaveFB) != 0 && counts[0] <= limit && counts[1] <= limit;
    uint result;
    if (!fb) {
        uint s = ClipPx(false, uint(y * pc.clipStride + x));
        result = (pc.flags & kBlend) != 0 ? (s * uint(256 - t) + ClipPx(true, uint(y * pc.clipStride + x)) * uint(t)) >> 8u : s;
    } else {
        bool extra = (pc.flags & kHaveExtra) != 0 && counts[2] <= limit && counts[3] <= limit;
        Weights(x, y);
        ivec2 vF = VectorAt(0), vB = VectorAt(1);
        int mF = MaskAt(0), mB = MaskAt(pc.nbx * pc.nby);
        int xBase = x * kPel, yBase = y * kPel;
        int vxF = (vF.x * t) >> 8, vyF = (vF.y * t) >> 8;
        int vxB = (vB.x * (256 - t)) >> 8, vyB = (vB.y * (256 - t)) >> 8;
        int dF = int(Sample(false, xBase + vxF, yBase + vyF)), dB = int(Sample(true, xBase + vxB, yBase + vyB));
        int blended;
        if (extra) {
            ivec2 vFF = VectorAt(2), vBB = VectorAt(3);
            int vxFF = (vFF.x * t) >> 8, vyFF = (vFF.y * t) >> 8;
            int vxBB = (vBB.x * (256 - t)) >> 8, vyBB = (vBB.y * (256 - t)) >> 8;
            int dFF = int(Sample(false, xBase + vxFF, yBase + vyFF)), dBB = int(Sample(true, xBase + vxBB, yBase + vyBB));
            int minfb = min(dB, dF), maxfb = max(dB, dF);
            int medianBB = max(minfb, min(dBB, maxfb)), medianFF = max(minfb, min(dFF, maxfb));
            blended = ((((medianBB * mF + dF * (256 - mF)) + 256) >> 8) * (256 - t) + (((medianFF * mB + dB * (256 - mB)) + 256) >> 8) * t) >> 8;
        } else {
            int dF0 = int(Sample(false, xBase, yBase)), dB0 = int(Sample(true, xBase, yBase));
            int occF = (dF * (256 - mF) + int((uint(mF) * uint(dB * (256 - mB) + mB * dF0) + 256u) >> 8u) + 256) >> 8;
            int occB = (dB * (256 - mB) + int((uint(mB) * uint(dF * (256 - mF) + mF * dB0) + 256u) >> 8u) + 256) >> 8;
            blended = (occF * (256 - t) + occB * t) >> 8;
        }
        result = uint(blended - 1);
    }
    if (kWide)
        outPx16[y * pc.outStride + x] = uint16_t(result);
    else
        outPx[y * pc.outStride + x] = uint8_t(result);
}
