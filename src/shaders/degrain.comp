#version 460
#extension GL_GOOGLE_include_directive : require
#include "degrain_common.glsl"

layout(local_size_x = 64) in;

// The same planes as words, for Main4's and Main4UV's four bytes at a time
layout(std430, set = 0, binding = 0) readonly buffer CurLuma32 { uint curY32[]; };
layout(std430, set = 0, binding = 1) readonly buffer CurChroma32 { uint curC32[]; };
layout(std430, set = 0, binding = 5) writeonly buffer Out32 { uint px[]; } outPlane32[3];
layout(std430, set = 0, binding = 6) readonly buffer RefLuma32 { uint px[]; } refY32[kMaxRefs];
layout(std430, set = 0, binding = 7) readonly buffer RefChroma32 { uint px[]; } refC32[kMaxRefs];

// The rounded average mvu.Super's quarter planes take of two samples
uint Avg(uint a, uint b) {
    return (a + b + 1u) >> 1u;
}

// A sample of the centre's luma or chroma planes, or of reference r's, bytes or 16 bits (kWide)
uint CurLumaAt(uint i) {
    return kWide ? uint(curY16[i]) : uint(curY[i]);
}
uint CurChromaAt(uint i) {
    return kWide ? uint(curC16[i]) : uint(curC[i]);
}
uint RefLumaAt(int r, uint i) {
    return kWide ? uint(refY16[r].px[i]) : uint(refY[r].px[i]);
}
uint RefChromaAt(int r, uint i) {
    return kWide ? uint(refC16[r].px[i]) : uint(refC[r].px[i]);
}

// mvu.Super's float AveragePixels, (a + b) * 0.5
float AvgF(float a, float b) {
    precise float s = a + b;
    return s * 0.5;
}

// The address of sample (Xh, Yh) of the half-pel grid of a plane with rows stride samples apart,
// its four half-pel planes rows rows each
uint HalfAddrOf(int Xh, int Yh, int stride, int rows) {
    return uint((Xh & 1) | ((Yh & 1) << 1)) * uint(stride * rows) + uint((Yh >> 1) * stride + (Xh >> 1));
}

// Luma's, in its padded planes
uint HalfAddr(int Xh, int Yh) {
    return HalfAddrOf(Xh, Yh, pc.wp, pc.hp);
}

// Chroma holds U and V interleaved, sample by sample (SuperLayout.h): U's address of chroma
// position (Xc, Yc), 1 / pel pixels of the padded plane, V's the next: in the quarter-pel image
// (subsampled at pel 4), else in one of the four half-pel planes, the position on the half-pel grid
// (4:4:4 at pel 4 is read between those as luma is: ChromaHalfAddr), or at pel 1 in the full-pel
// plane
uint ChromaAddr(int Xc, int Yc) {
    if (kPel == 1)
        return uint(2 * (Yc * pc.wc + Xc));
    if (kImage)
        return uint(2 * (Yc * 4 * pc.wc + Xc));
    return 2u * HalfAddrOf(Xc, Yc, pc.wc, pc.hc);
}
// U's address of sample (Xh, Yh) of chroma's half-pel grid
uint ChromaHalfAddr(int Xh, int Yh) {
    return 2u * HalfAddrOf(Xh, Yh, pc.wc, pc.hc);
}

// Samples from a chroma pixel to the one below it: a row of the full-pel plane, four of the image
int ChromaRow() {
    return kImage ? 32 * pc.wc : 2 * pc.wc;
}

// U's address of the centre's full-pel chroma pixel (x, y) of the plane, inside the padding: in the
// full-pel plane, or every fourth sample of every fourth row of the image
uint ChromaCentre(int x, int y) {
    return kImage ? uint(2 * (16 * (pc.padcY + y) * pc.wc + 4 * (pc.padc + x))) : uint(2 * ((pc.padcY + y) * pc.wc + pc.padc + x));
}

// The chroma planes a dispatch makes (pc.plane, Degrain.cpp): U, V, or both
bool DoU() {
    return (pc.plane & 1) != 0;
}
bool DoV() {
    return (pc.plane & 2) != 0;
}

// The plane's block size, luma's or chroma's: the grid's step and overlap from the push constants, at
// run time, rather than the specialization constants kBlkX and kBlkY. Given those, the driver compiled
// the lanes to code that ran slower (MainLuma, 16-bit 4:2:0 at 4K, 16x16 blocks: 22% slower on an
// RX 6900 XT).
int BlockW(bool chroma) {
    return (pc.step + pc.overlap) >> (chroma ? kLogX : 0);
}
int BlockH(bool chroma) {
    return (pc.stepY + pc.overlapY) >> (chroma ? kLogY : 0);
}

// Rows a lane holds at once: a 32-row block's cell row goes in two, which keeps the registers 16 x 16
// blocks take; and making U and V at once, half as many
const int kChunk = kBlkY > 16 ? 16 : kBlkY;
const int kChunkUV = kChunk > 8 ? 8 : kChunk;

// The range ValidateVectors accepts for block (bx, by)'s vector, the block inside the padded planes
// of the super's block-aligned frame; vectors from mvgpu.Analyse are always inside it, so this only
// guards the reads
ivec2 ClampVec(ivec2 v, int bx, int by) {
    int gX = bx * pc.step, gY = by * pc.stepY;
    return ivec2(clamp(v.x, -kPel * (gX + pc.pad), kPel * (pc.aw - kBlkX + pc.pad - gX) - 1),
                 clamp(v.y, -kPel * (gY + pc.padY), kPel * (pc.ah - kBlkY + pc.padY - gY) - 1));
}

// Four pixels per lane where they share their blocks: 8-bit samples at pel 1 or 2, the plane's step
// and overlap multiples of 4 (Main4, Main4UV; Degrain.cpp sizes the dispatch for it alike)
bool Quad() {
    int lx = pc.plane == 0 ? 0 : kLogX;
    return !kWide && !kFloat && kPel != 4 && ((pc.step >> lx) & 3) == 0 && ((pc.overlap >> lx) & 3) == 0;
}

// Where block (bx, by)'s overlap window weight at (dx, dy) in it is in tables[], of the plane's
// windows (Bx x By): mvu's OverlapWindows, the 9 of them for the frame's edges and corners; the weight
// a row below is Bx entries on. (Taken once per block: a lookup in each row's branch is computed
// again in every one.)
int WindowAt(int bx, int by, int Bx, int By, int dx, int dy) {
    int wbx = bx == pc.nbx - 1 ? 2 : (bx == 0 ? 0 : 1);
    int wby = by == 0 ? 0 : (by == pc.nby - 1 ? 6 : 3);
    return pc.winOff + ((wby + wbx) * By + dy) * Bx + dx;
}

// mvu's LimitChanges of an integer pixel: within limit of the centre's, and of the sample type's range;
// of four 8-bit pixels at once (Main4, Main4UV)
uint Limit(uint p, uint centre) {
    return uint(clamp(int(p), max(int(centre) - pc.limit, 0), min(int(centre) + pc.limit, kWide ? 65535 : 255)));
}
uvec4 Limit4(uvec4 p, uvec4 centre) {
    ivec4 c = ivec4(centre);
    return uvec4(clamp(ivec4(p), max(c - pc.limit, ivec4(0)), min(c + pc.limit, ivec4(255))));
}
// And mvu's LimitChanges_C of a float pixel: within limitF of the centre's (std::clamp)
float LimitF(float v, float centre) {
    precise float lo = centre - pc.limitF;
    precise float hi = centre + pc.limitF;
    return v < lo ? lo : (hi < v ? hi : v);
}

// mvu.Degrain. A lane is one pixel column of a cell row of a plane: the rows between two block
// rows, step of them (chroma's subsampling halving it), the last cell row also the rows below it its
// blocks reach. Every pixel of it lies in the same block columns, one or, inside the overlap, two,
// and in the same two block rows, the upper one covering only the first overlap rows. Each block
// gives the pixel mvu's degrained value, (128 + centre * its weight + the sum of each reference's
// motion compensated pixel * its weight) >> 8, and the pixel adds those up weighted by the blocks'
// overlap windows (values to 2048, each product >> 6), then (sum + 16) >> 5, clamped to the clip's
// largest value; without overlap a pixel's one block gives it its value. limit then keeps it within
// that of the centre's pixel, and within the sample type's range (mvu's LimitChanges: 255 or 65535,
// whatever the bit depth).
//
// The motion compensated pixel is read from the reference's super where its vector puts the block,
// mvu's GetPointer: luma at pel 1 from its full-pel plane, at pel 2 from its half-pel plane; at pel 4
// computed from the half-pel planes exactly as mvu.Super's quarter planes hold it
// (refine_qpel.comp); chroma at the luma position shifted by its subsampling, rounded down:
// subsampled from its half-pel planes or quarter-pel image, 4:4:4 as luma is. A chroma lane makes U
// and V together (MainUV, Main4UV, MainFloatUV): their blocks, vectors, weights and windows are the
// same, and the super holds their samples side by side.
//
// Float clips take mvu's float arithmetic operation for operation (Degrain_F32, overlaps_c,
// ToPixels, LimitChanges_C; precise, so nothing is fused): a block's value the centre's pixel times
// its weight plus each reference's times its own, in order, then / 256; the windows' products / 64
// added up in mvu's order, the row above before the block's own and the left column first; then
// / 32, unclamped. A reference without vectors, out of the clip or at a scene change gives the
// centre's pixel with weight 0, and none is skipped: a zero product can still turn a sum's sign.
// Each path is dispatched as ((width + 63) / 64, nby) workgroups, the four pixel ones as
// ((width + 255) / 256, nby).

// Luma, float samples. A lane holds kChunk rows at a time.
void MainFloat() {
    int Bx = BlockW(false), By = BlockH(false);
    int x = int(gl_GlobalInvocationID.x), cy = int(gl_WorkGroupID.y);
    int y0 = cy * pc.stepY;
    int rows = min(cy == pc.nby - 1 ? By : pc.stepY, pc.height - y0);
    if (x >= pc.width || rows <= 0)
        return;
    uint cur = uint((pc.padY + y0) * pc.wp + pc.pad + x);
    uint out0 = uint(y0 * pc.outStride + x);
    int bxA = min(x / pc.step, pc.nbx - 1);
    bool hasLeft = bxA >= 1 && x < bxA * pc.step + pc.overlap;

    for (int j0 = 0; j0 < rows; j0 += kChunk) {
        int n = min(kChunk, rows - j0);
        float centre[kChunk], acc[kChunk];
        [[unroll]] for (int j = 0; j < kChunk; ++j) {
            centre[j] = j < n ? curYF[cur + uint((j0 + j) * pc.wp)] : 0.0;
            acc[j] = 0.0;
        }
        for (int k = 3; k >= 0; --k) {
            int bx = (k & 1) != 0 ? bxA - 1 : bxA, by = (k & 2) != 0 ? cy - 1 : cy;
            int jEnd = (k & 2) != 0 ? clamp(pc.overlapY - j0, 0, n) : n;
            if (!(((k & 1) == 0 || hasLeft) && ((k & 2) == 0 || cy >= 1) && jEnd > 0))
                continue;
            int b = by * pc.nbx + bx;
            float wc = float(meta[b] & 0xFFFFu);
            float sum[kChunk];
            [[unroll]] for (int j = 0; j < kChunk; ++j) {
                precise float s = centre[j] * wc;
                sum[j] = s;
            }
            int dx = x - bx * pc.step, dy = y0 + j0 - by * pc.stepY;
            int w0 = WindowAt(bx, by, Bx, By, dx, dy);
            for (int r = 0; r < pc.refs; ++r) {
                float w = float(meta[(1 + r) * Blocks() + b] & 0xFFFFu);
                float px[kChunk];
                [[unroll]] for (int j = 0; j < kChunk; ++j)
                    px[j] = centre[j];
                if (Usable(r) && counts[r] <= uint(pc.scdLimit)) {
                    ivec2 v = ClampVec(Record(r, bx, by).xy, bx, by);
                    int X = kPel * (bx * pc.step + pc.pad + dx) + v.x, Y = kPel * (by * pc.stepY + pc.padY + dy) + v.y;
                    if (kPel == 4) {
                        int Xa = X >> 1, Xb = Xa + (X & 1), Ya = Y >> 1, Yb = Ya + (Y & 1);
                        uint aa = HalfAddr(Xa, Ya), ab = HalfAddr(Xa, Yb), ba = HalfAddr(Xb, Ya), bb = HalfAddr(Xb, Yb);
                        [[unroll]] for (int j = 0; j < kChunk; ++j) {
                            uint o = uint(j * pc.wp);
                            if (j < jEnd)
                                px[j] = AvgF(AvgF(refYF[r].px[aa + o], refYF[r].px[ab + o]), AvgF(refYF[r].px[ba + o], refYF[r].px[bb + o]));
                        }
                    } else {
                        uint a = kPel == 1 ? uint(Y * pc.wp + X) : HalfAddr(X, Y);
                        [[unroll]] for (int j = 0; j < kChunk; ++j)
                            if (j < jEnd)
                                px[j] = refYF[r].px[a + uint(j * pc.wp)];
                    }
                }
                [[unroll]] for (int j = 0; j < kChunk; ++j) {
                    precise float t = px[j] * w;
                    precise float s = sum[j] + t;
                    sum[j] = s;
                }
            }
            [[unroll]] for (int j = 0; j < kChunk; ++j) {
                if (j < jEnd) {
                    precise float value = sum[j] * (1.0 / 256.0);
                    if ((pc.overlap | pc.overlapY) == 0) {
                        acc[j] = value;
                    } else {
                        float win = float(tables[w0 + j * Bx]);
                        precise float t = value * win;
                        precise float u = t * (1.0 / 64.0);
                        precise float a = acc[j] + u;
                        acc[j] = a;
                    }
                }
            }
        }

        [[unroll]] for (int j = 0; j < kChunk; ++j) {
            if (j < n) {
                precise float v = (pc.overlap | pc.overlapY) == 0 ? acc[j] : acc[j] * (1.0 / 32.0);
                if (pc.limit >= 0)
                    v = LimitF(v, centre[j]);
                outPlaneF[0].px[out0 + uint((j0 + j) * pc.outStride)] = v;
            }
        }
    }
}

// Chroma, float samples: MainFloat's arithmetic for U and V at once. A lane holds kChunkUV rows at a
// time.
void MainFloatUV() {
    int Bx = BlockW(true), By = BlockH(true);
    int Sx = pc.step >> kLogX, Sy = pc.stepY >> kLogY;
    int Ox = pc.overlap >> kLogX, Oy = pc.overlapY >> kLogY;
    int x = int(gl_GlobalInvocationID.x), cy = int(gl_WorkGroupID.y);
    int y0 = cy * Sy;
    int rows = min(cy == pc.nby - 1 ? By : Sy, pc.height - y0);
    if (x >= pc.width || rows <= 0)
        return;
    uint cur = ChromaCentre(x, y0), rowC = uint(ChromaRow());
    uint out0 = uint(y0 * pc.outStride + x);
    int bxA = min(x / Sx, pc.nbx - 1);
    bool hasLeft = bxA >= 1 && x < bxA * Sx + Ox;

    for (int j0 = 0; j0 < rows; j0 += kChunkUV) {
        int n = min(kChunkUV, rows - j0);
        float cu[kChunkUV], cv[kChunkUV], au[kChunkUV], av[kChunkUV];
        [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
            uint a = cur + uint(j0 + j) * rowC;
            cu[j] = j < n ? curCF[a] : 0.0;
            cv[j] = j < n ? curCF[a + 1u] : 0.0;
            au[j] = 0.0;
            av[j] = 0.0;
        }
        for (int k = 3; k >= 0; --k) {
            int bx = (k & 1) != 0 ? bxA - 1 : bxA, by = (k & 2) != 0 ? cy - 1 : cy;
            int jEnd = (k & 2) != 0 ? clamp(Oy - j0, 0, n) : n;
            if (!(((k & 1) == 0 || hasLeft) && ((k & 2) == 0 || cy >= 1) && jEnd > 0))
                continue;
            int b = by * pc.nbx + bx;
            float wc = float(meta[b] >> 16u);
            float su[kChunkUV], sv[kChunkUV];
            [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
                precise float s = cu[j] * wc;
                precise float t = cv[j] * wc;
                su[j] = s;
                sv[j] = t;
            }
            int dx = x - bx * Sx, dy = y0 + j0 - by * Sy;
            int w0 = WindowAt(bx, by, Bx, By, dx, dy);
            for (int r = 0; r < pc.refs; ++r) {
                float w = float(meta[(1 + r) * Blocks() + b] >> 16u);
                float pu[kChunkUV], pv[kChunkUV];
                [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
                    pu[j] = cu[j];
                    pv[j] = cv[j];
                }
                if (Usable(r) && counts[r] <= uint(pc.scdLimit)) {
                    ivec2 v = ClampVec(Record(r, bx, by).xy, bx, by);
                    int Xc = kPel * (pc.padc + dx) + ((kPel * bx * pc.step + v.x) >> kLogX);
                    int Yc = kPel * (pc.padcY + dy) + ((kPel * by * pc.stepY + v.y) >> kLogY);
                    if (kPel == 4 && !kImage) {
                        int Xa = Xc >> 1, Xb = Xa + (Xc & 1), Ya = Yc >> 1, Yb = Ya + (Yc & 1);
                        uint aa = ChromaHalfAddr(Xa, Ya), ab = ChromaHalfAddr(Xa, Yb), ba = ChromaHalfAddr(Xb, Ya), bb = ChromaHalfAddr(Xb, Yb);
                        [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
                            uint o = uint(j) * rowC;
                            if (j < jEnd) {
                                pu[j] = AvgF(AvgF(refCF[r].px[aa + o], refCF[r].px[ab + o]), AvgF(refCF[r].px[ba + o], refCF[r].px[bb + o]));
                                pv[j] = AvgF(AvgF(refCF[r].px[aa + o + 1u], refCF[r].px[ab + o + 1u]), AvgF(refCF[r].px[ba + o + 1u], refCF[r].px[bb + o + 1u]));
                            }
                        }
                    } else {
                        uint a = ChromaAddr(Xc, Yc);
                        [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
                            if (j < jEnd) {
                                pu[j] = refCF[r].px[a + uint(j) * rowC];
                                pv[j] = refCF[r].px[a + uint(j) * rowC + 1u];
                            }
                        }
                    }
                }
                [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
                    precise float tu = pu[j] * w;
                    precise float su2 = su[j] + tu;
                    su[j] = su2;
                    precise float tv = pv[j] * w;
                    precise float sv2 = sv[j] + tv;
                    sv[j] = sv2;
                }
            }
            [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
                if (j < jEnd) {
                    precise float valueU = su[j] * (1.0 / 256.0);
                    precise float valueV = sv[j] * (1.0 / 256.0);
                    if ((pc.overlap | pc.overlapY) == 0) {
                        au[j] = valueU;
                        av[j] = valueV;
                    } else {
                        float win = float(tables[w0 + j * Bx]);
                        precise float tu = valueU * win;
                        precise float uu = tu * (1.0 / 64.0);
                        precise float au2 = au[j] + uu;
                        au[j] = au2;
                        precise float tv = valueV * win;
                        precise float uv = tv * (1.0 / 64.0);
                        precise float av2 = av[j] + uv;
                        av[j] = av2;
                    }
                }
            }
        }

        [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
            if (j < n) {
                precise float u = (pc.overlap | pc.overlapY) == 0 ? au[j] : au[j] * (1.0 / 32.0);
                precise float v = (pc.overlap | pc.overlapY) == 0 ? av[j] : av[j] * (1.0 / 32.0);
                if (pc.limit >= 0) {
                    u = LimitF(u, cu[j]);
                    v = LimitF(v, cv[j]);
                }
                uint o = out0 + uint((j0 + j) * pc.outStride);
                if (DoU())
                    outPlaneF[1].px[o] = u;
                if (DoV())
                    outPlaneF[2].px[o] = v;
            }
        }
    }
}

// Four bytes from byte a on, of words w0 (holding byte a) and w1 (the next): funnel shifted
uint Bytes4At(uint w0, uint w1, uint a) {
    uint s = (a & 3u) * 8u;
    return s == 0u ? w0 : (w0 >> s) | (w1 << (32u - s));
}
uvec4 Unpack4(uint w) {
    return uvec4(w & 0xFFu, (w >> 8u) & 0xFFu, (w >> 16u) & 0xFFu, w >> 24u);
}
uint Pack4(uvec4 p) {
    return p.x | (p.y << 8u) | (p.z << 16u) | (p.w << 24u);
}
// Four bytes of the centre's or reference r's luma from byte a; the planes' spare rows (SuperLayout.h)
// keep the word after the last pixel inside the buffer
uint CurLuma4(uint a) {
    uint i = a >> 2u;
    return Bytes4At(curY32[i], curY32[i + 1u], a);
}
uint RefLuma4(int r, uint a) {
    uint i = a >> 2u;
    return Bytes4At(refY32[r].px[i], refY32[r].px[i + 1u], a);
}
// Four chroma pixels' U and V bytes, the eight from byte a (even) on, U's and V's alternating: the
// centre's packed as words, a reference's one per component; the spare row keeps the third word
// inside the buffer
void CurChromaUV4(uint a, out uint u, out uint v) {
    uint i = a >> 2u, w1 = curC32[i + 1u];
    uint lo = Bytes4At(curC32[i], w1, a), hi = Bytes4At(w1, curC32[i + 2u], a);
    u = (lo & 0xFFu) | ((lo >> 8u) & 0xFF00u) | ((hi & 0xFFu) << 16u) | ((hi << 8u) & 0xFF000000u);
    v = ((lo >> 8u) & 0xFFu) | ((lo >> 16u) & 0xFF00u) | ((hi & 0xFF00u) << 8u) | (hi & 0xFF000000u);
}
void RefChromaUV4(int r, uint a, out uvec4 u, out uvec4 v) {
    uint i = a >> 2u, w1 = refC32[r].px[i + 1u];
    uint lo = Bytes4At(refC32[r].px[i], w1, a), hi = Bytes4At(w1, refC32[r].px[i + 2u], a);
    u = uvec4(lo & 0xFFu, (lo >> 16u) & 0xFFu, hi & 0xFFu, (hi >> 16u) & 0xFFu);
    v = uvec4((lo >> 8u) & 0xFFu, lo >> 24u, (hi >> 8u) & 0xFFu, hi >> 24u);
}

// Rows a lane of Main4 holds at once, and of Main4UV, which holds U's and V's: as many registers,
// and 4:2:0's chroma cell rows at 16x16/8 in one go (8 rows of both ran 13-77% slower)
const int kChunk4 = 8;
const int kChunk4UV = 4;

// Luma, four adjacent pixels per lane: MainLuma's arithmetic, 8-bit samples at pel 1 or 2, where the
// step and overlap are multiples of 4 (Quad): the four then lie in the same blocks, their reference
// pixels four bytes in a row of one plane, read as words.
void Main4() {
    int Bx = BlockW(false), By = BlockH(false);
    int x = 4 * int(gl_GlobalInvocationID.x), cy = int(gl_WorkGroupID.y);
    int y0 = cy * pc.stepY;
    int rows = min(cy == pc.nby - 1 ? By : pc.stepY, pc.height - y0);
    if (x >= pc.width || rows <= 0)
        return;
    int inside = min(4, pc.width - x); // the group's pixels inside the plane
    uint cur = uint((pc.padY + y0) * pc.wp + pc.pad + x);
    uint out0 = uint(y0 * pc.outStride + x);
    int bxA = min(x / pc.step, pc.nbx - 1);
    bool hasLeft = bxA >= 1 && x < bxA * pc.step + pc.overlap;

    for (int j0 = 0; j0 < rows; j0 += kChunk4) {
        int n = min(kChunk4, rows - j0);
        uint centre[kChunk4];
        uvec4 acc[kChunk4];
        [[unroll]] for (int j = 0; j < kChunk4; ++j) {
            centre[j] = j < n ? CurLuma4(cur + uint((j0 + j) * pc.wp)) : 0u;
            acc[j] = uvec4(0u);
        }

        for (int k = 0; k < 4; ++k) {
            int bx = (k & 1) != 0 ? bxA - 1 : bxA, by = (k & 2) != 0 ? cy - 1 : cy;
            int jEnd = (k & 2) != 0 ? clamp(pc.overlapY - j0, 0, n) : n;
            bool valid = ((k & 1) == 0 || hasLeft) && ((k & 2) == 0 || cy >= 1) && jEnd > 0;
            int b = valid ? by * pc.nbx + bx : 0;
            uvec4 sum[kChunk4];
            uint wc = valid ? meta[b] & 0xFFFFu : 0u;
            [[unroll]] for (int j = 0; j < kChunk4; ++j)
                sum[j] = uvec4(128u) + Unpack4(centre[j]) * wc;
            int dx = x - bx * pc.step, dy = y0 + j0 - by * pc.stepY;

            for (int r = 0; r < pc.refs; ++r) {
                uint w = valid ? meta[(1 + r) * Blocks() + b] & 0xFFFFu : 0u;
                if (w == 0u)
                    continue;
                ivec2 v = ClampVec(Record(r, bx, by).xy, bx, by);
                int X = kPel * (bx * pc.step + pc.pad + dx) + v.x, Y = kPel * (by * pc.stepY + pc.padY + dy) + v.y;
                uint a = kPel == 1 ? uint(Y * pc.wp + X) : HalfAddr(X, Y);
                [[unroll]] for (int j = 0; j < kChunk4; ++j)
                    if (j < jEnd)
                        sum[j] += Unpack4(RefLuma4(r, a + uint(j * pc.wp))) * w;
            }

            if (valid) {
                if ((pc.overlap | pc.overlapY) == 0) {
                    [[unroll]] for (int j = 0; j < kChunk4; ++j)
                        acc[j] = sum[j] >> 8u;
                } else {
                    int w0 = WindowAt(bx, by, Bx, By, dx, dy);
                    [[unroll]] for (int j = 0; j < kChunk4; ++j) {
                        if (j < jEnd) {
                            int t = w0 + j * Bx;
                            uvec4 w4 = uvec4(uint(tables[t]), uint(tables[t + 1]), uint(tables[t + 2]), uint(tables[t + 3]));
                            acc[j] += ((sum[j] >> 8u) * w4) >> 6u;
                        }
                    }
                }
            }
        }

        [[unroll]] for (int j = 0; j < kChunk4; ++j) {
            if (j < n) {
                uvec4 p = (pc.overlap | pc.overlapY) == 0 ? acc[j] : min((acc[j] + 16u) >> 5u, uvec4(uint(pc.pixelMax)));
                if (pc.limit >= 0)
                    p = Limit4(p, Unpack4(centre[j]));
                uint o = out0 + uint((j0 + j) * pc.outStride);
                if (inside == 4 && (o & 3u) == 0u) {
                    outPlane32[0].px[o >> 2u] = Pack4(p);
                } else {
                    [[unroll]] for (int i = 0; i < 4; ++i)
                        if (i < inside)
                            outPlane[0].px[o + uint(i)] = uint8_t(p[i]);
                }
            }
        }
    }
}

// The output of a four pixel group of 8-bit chroma, U's or V's: a word where the group is whole and
// aligned, else a byte at a time
void Store4(int plane, uint o, int inside, uvec4 p) {
    if (inside == 4 && (o & 3u) == 0u) {
        outPlane32[plane].px[o >> 2u] = Pack4(p);
    } else {
        [[unroll]] for (int i = 0; i < 4; ++i)
            if (i < inside)
                outPlane[plane].px[o + uint(i)] = uint8_t(p[i]);
    }
}

// Chroma, four adjacent pixels per lane, U and V together: Main4's arithmetic, where chroma's step
// and overlap are multiples of 4 (Quad); a row's four pixels of U and of V are eight bytes in a row
// of one plane, read as three words. A lane holds kChunk4UV rows at a time.
void Main4UV() {
    int Bx = BlockW(true), By = BlockH(true);
    int Sx = pc.step >> kLogX, Sy = pc.stepY >> kLogY;
    int Ox = pc.overlap >> kLogX, Oy = pc.overlapY >> kLogY;
    int x = 4 * int(gl_GlobalInvocationID.x), cy = int(gl_WorkGroupID.y);
    int y0 = cy * Sy;
    int rows = min(cy == pc.nby - 1 ? By : Sy, pc.height - y0);
    if (x >= pc.width || rows <= 0)
        return;
    int inside = min(4, pc.width - x); // the group's pixels inside the plane
    uint cur = ChromaCentre(x, y0), rowC = uint(ChromaRow());
    uint out0 = uint(y0 * pc.outStride + x);
    int bxA = min(x / Sx, pc.nbx - 1);
    bool hasLeft = bxA >= 1 && x < bxA * Sx + Ox;

    for (int j0 = 0; j0 < rows; j0 += kChunk4UV) {
        int n = min(kChunk4UV, rows - j0);
        uint cu[kChunk4UV], cv[kChunk4UV];
        uvec4 au[kChunk4UV], av[kChunk4UV];
        [[unroll]] for (int j = 0; j < kChunk4UV; ++j) {
            cu[j] = 0u;
            cv[j] = 0u;
            if (j < n)
                CurChromaUV4(cur + uint(j0 + j) * rowC, cu[j], cv[j]);
            au[j] = uvec4(0u);
            av[j] = uvec4(0u);
        }

        for (int k = 0; k < 4; ++k) {
            int bx = (k & 1) != 0 ? bxA - 1 : bxA, by = (k & 2) != 0 ? cy - 1 : cy;
            int jEnd = (k & 2) != 0 ? clamp(Oy - j0, 0, n) : n;
            bool valid = ((k & 1) == 0 || hasLeft) && ((k & 2) == 0 || cy >= 1) && jEnd > 0;
            int b = valid ? by * pc.nbx + bx : 0;
            uvec4 su[kChunk4UV], sv[kChunk4UV];
            uint wc = valid ? meta[b] >> 16u : 0u;
            [[unroll]] for (int j = 0; j < kChunk4UV; ++j) {
                su[j] = uvec4(128u) + Unpack4(cu[j]) * wc;
                sv[j] = uvec4(128u) + Unpack4(cv[j]) * wc;
            }
            int dx = x - bx * Sx, dy = y0 + j0 - by * Sy;

            for (int r = 0; r < pc.refs; ++r) {
                uint w = valid ? meta[(1 + r) * Blocks() + b] >> 16u : 0u;
                if (w == 0u)
                    continue;
                ivec2 v = ClampVec(Record(r, bx, by).xy, bx, by);
                int Xc = kPel * (pc.padc + dx) + ((kPel * bx * pc.step + v.x) >> kLogX);
                int Yc = kPel * (pc.padcY + dy) + ((kPel * by * pc.stepY + v.y) >> kLogY);
                uint a = ChromaAddr(Xc, Yc);
                [[unroll]] for (int j = 0; j < kChunk4UV; ++j) {
                    if (j < jEnd) {
                        uvec4 pu, pv;
                        RefChromaUV4(r, a + uint(j) * rowC, pu, pv);
                        su[j] += pu * w;
                        sv[j] += pv * w;
                    }
                }
            }

            if (valid) {
                if ((pc.overlap | pc.overlapY) == 0) {
                    [[unroll]] for (int j = 0; j < kChunk4UV; ++j) {
                        au[j] = su[j] >> 8u;
                        av[j] = sv[j] >> 8u;
                    }
                } else {
                    int w0 = WindowAt(bx, by, Bx, By, dx, dy);
                    [[unroll]] for (int j = 0; j < kChunk4UV; ++j) {
                        if (j < jEnd) {
                            int t = w0 + j * Bx;
                            uvec4 w4 = uvec4(uint(tables[t]), uint(tables[t + 1]), uint(tables[t + 2]), uint(tables[t + 3]));
                            au[j] += ((su[j] >> 8u) * w4) >> 6u;
                            av[j] += ((sv[j] >> 8u) * w4) >> 6u;
                        }
                    }
                }
            }
        }

        [[unroll]] for (int j = 0; j < kChunk4UV; ++j) {
            if (j < n) {
                bool ov = (pc.overlap | pc.overlapY) != 0;
                uvec4 pu = ov ? min((au[j] + 16u) >> 5u, uvec4(uint(pc.pixelMax))) : au[j];
                uvec4 pv = ov ? min((av[j] + 16u) >> 5u, uvec4(uint(pc.pixelMax))) : av[j];
                if (pc.limit >= 0) {
                    pu = Limit4(pu, Unpack4(cu[j]));
                    pv = Limit4(pv, Unpack4(cv[j]));
                }
                uint o = out0 + uint((j0 + j) * pc.outStride);
                if (DoU())
                    Store4(1, o, inside, pu);
                if (DoV())
                    Store4(2, o, inside, pv);
            }
        }
    }
}

// Luma, integer samples, one pixel per lane. A lane holds kChunk rows at a time.
void MainLuma() {
    int Bx = BlockW(false), By = BlockH(false);
    int x = int(gl_GlobalInvocationID.x), cy = int(gl_WorkGroupID.y);
    int y0 = cy * pc.stepY;
    int rows = min(cy == pc.nby - 1 ? By : pc.stepY, pc.height - y0);
    if (x >= pc.width || rows <= 0)
        return;
    uint cur = uint((pc.padY + y0) * pc.wp + pc.pad + x);
    uint out0 = uint(y0 * pc.outStride + x);
    int bxA = min(x / pc.step, pc.nbx - 1);
    bool hasLeft = bxA >= 1 && x < bxA * pc.step + pc.overlap;

    // The rows kChunk at a time
    for (int j0 = 0; j0 < rows; j0 += kChunk) {
        int n = min(kChunk, rows - j0);
        uint centre[kChunk], acc[kChunk];
        [[unroll]] for (int j = 0; j < kChunk; ++j) {
            centre[j] = j < n ? CurLumaAt(cur + uint((j0 + j) * pc.wp)) : 0u;
            acc[j] = 0u;
        }

        // The (up to) four blocks: k & 1 the column to the left, k & 2 the row above, which covers
        // only the cell row's first overlap rows
        for (int k = 0; k < 4; ++k) {
            int bx = (k & 1) != 0 ? bxA - 1 : bxA, by = (k & 2) != 0 ? cy - 1 : cy;
            int jEnd = (k & 2) != 0 ? clamp(pc.overlapY - j0, 0, n) : n;
            bool valid = ((k & 1) == 0 || hasLeft) && ((k & 2) == 0 || cy >= 1) && jEnd > 0;
            int b = valid ? by * pc.nbx + bx : 0;
            uint sum[kChunk];
            uint wc = valid ? meta[b] & 0xFFFFu : 0u;
            [[unroll]] for (int j = 0; j < kChunk; ++j)
                sum[j] = 128u + centre[j] * wc;
            int dx = x - bx * pc.step, dy = y0 + j0 - by * pc.stepY; // the lane's place in the block at the chunk's first row

            for (int r = 0; r < pc.refs; ++r) {
                uint w = valid ? meta[(1 + r) * Blocks() + b] & 0xFFFFu : 0u;
                if (w == 0u)
                    continue;
                ivec2 v = ClampVec(Record(r, bx, by).xy, bx, by);
                int X = kPel * (bx * pc.step + pc.pad + dx) + v.x, Y = kPel * (by * pc.stepY + pc.padY + dy) + v.y;
                if (kPel == 4) {
                    int Xa = X >> 1, Xb = Xa + (X & 1), Ya = Y >> 1, Yb = Ya + (Y & 1);
                    uint aa = HalfAddr(Xa, Ya), ab = HalfAddr(Xa, Yb), ba = HalfAddr(Xb, Ya), bb = HalfAddr(Xb, Yb);
                    [[unroll]] for (int j = 0; j < kChunk; ++j) {
                        if (j < jEnd) {
                            uint o = uint(j * pc.wp);
                            uint p = Avg(Avg(RefLumaAt(r, aa + o), RefLumaAt(r, ab + o)), Avg(RefLumaAt(r, ba + o), RefLumaAt(r, bb + o)));
                            sum[j] += p * w;
                        }
                    }
                } else {
                    uint a = kPel == 1 ? uint(Y * pc.wp + X) : HalfAddr(X, Y);
                    [[unroll]] for (int j = 0; j < kChunk; ++j)
                        if (j < jEnd)
                            sum[j] += RefLumaAt(r, a + uint(j * pc.wp)) * w;
                }
            }

            if (valid) {
                if ((pc.overlap | pc.overlapY) == 0) {
                    [[unroll]] for (int j = 0; j < kChunk; ++j)
                        acc[j] = sum[j] >> 8u;
                } else {
                    int w0 = WindowAt(bx, by, Bx, By, dx, dy);
                    [[unroll]] for (int j = 0; j < kChunk; ++j)
                        if (j < jEnd)
                            acc[j] += ((sum[j] >> 8u) * uint(tables[w0 + j * Bx])) >> 6u;
                }
            }
        }

        [[unroll]] for (int j = 0; j < kChunk; ++j) {
            if (j < n) {
                uint p = (pc.overlap | pc.overlapY) == 0 ? acc[j] : min((acc[j] + 16u) >> 5u, uint(pc.pixelMax));
                if (pc.limit >= 0)
                    p = Limit(p, centre[j]);
                uint o = out0 + uint((j0 + j) * pc.outStride);
                if (kWide)
                    outPlane16[0].px[o] = uint16_t(p);
                else
                    outPlane[0].px[o] = uint8_t(p);
            }
        }
    }
}

// Chroma, integer samples, one pixel per lane, U and V together: MainLuma's arithmetic, at any pel (at
// pel 4, 4:4:4 between its half-pel samples as luma, subsampled from its quarter-pel image). A lane
// holds kChunkUV rows at a time.
void MainUV() {
    int Bx = BlockW(true), By = BlockH(true);
    int Sx = pc.step >> kLogX, Sy = pc.stepY >> kLogY;
    int Ox = pc.overlap >> kLogX, Oy = pc.overlapY >> kLogY;
    int x = int(gl_GlobalInvocationID.x), cy = int(gl_WorkGroupID.y);
    int y0 = cy * Sy;
    int rows = min(cy == pc.nby - 1 ? By : Sy, pc.height - y0);
    if (x >= pc.width || rows <= 0)
        return;
    uint cur = ChromaCentre(x, y0), rowC = uint(ChromaRow());
    uint out0 = uint(y0 * pc.outStride + x);
    int bxA = min(x / Sx, pc.nbx - 1);
    bool hasLeft = bxA >= 1 && x < bxA * Sx + Ox;

    for (int j0 = 0; j0 < rows; j0 += kChunkUV) {
        int n = min(kChunkUV, rows - j0);
        uint cu[kChunkUV], cv[kChunkUV], au[kChunkUV], av[kChunkUV];
        [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
            uint a = cur + uint(j0 + j) * rowC;
            cu[j] = j < n ? CurChromaAt(a) : 0u;
            cv[j] = j < n ? CurChromaAt(a + 1u) : 0u;
            au[j] = 0u;
            av[j] = 0u;
        }

        for (int k = 0; k < 4; ++k) {
            int bx = (k & 1) != 0 ? bxA - 1 : bxA, by = (k & 2) != 0 ? cy - 1 : cy;
            int jEnd = (k & 2) != 0 ? clamp(Oy - j0, 0, n) : n;
            bool valid = ((k & 1) == 0 || hasLeft) && ((k & 2) == 0 || cy >= 1) && jEnd > 0;
            int b = valid ? by * pc.nbx + bx : 0;
            uint su[kChunkUV], sv[kChunkUV];
            uint wc = valid ? meta[b] >> 16u : 0u;
            [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
                su[j] = 128u + cu[j] * wc;
                sv[j] = 128u + cv[j] * wc;
            }
            int dx = x - bx * Sx, dy = y0 + j0 - by * Sy;

            for (int r = 0; r < pc.refs; ++r) {
                uint w = valid ? meta[(1 + r) * Blocks() + b] >> 16u : 0u;
                if (w == 0u)
                    continue;
                ivec2 v = ClampVec(Record(r, bx, by).xy, bx, by);
                // At the luma position shifted by the subsampling, rounded down (GetPointer(blx >>
                // xSubUV, bly >> ySubUV))
                int Xc = kPel * (pc.padc + dx) + ((kPel * bx * pc.step + v.x) >> kLogX);
                int Yc = kPel * (pc.padcY + dy) + ((kPel * by * pc.stepY + v.y) >> kLogY);
                if (kPel == 4 && !kImage) {
                    // 4:4:4 at pel 4: from the half-pel planes, as luma
                    int Xa = Xc >> 1, Xb = Xa + (Xc & 1), Ya = Yc >> 1, Yb = Ya + (Yc & 1);
                    uint aa = ChromaHalfAddr(Xa, Ya), ab = ChromaHalfAddr(Xa, Yb), ba = ChromaHalfAddr(Xb, Ya), bb = ChromaHalfAddr(Xb, Yb);
                    [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
                        if (j < jEnd) {
                            uint o = uint(j) * rowC;
                            su[j] += Avg(Avg(RefChromaAt(r, aa + o), RefChromaAt(r, ab + o)), Avg(RefChromaAt(r, ba + o), RefChromaAt(r, bb + o))) * w;
                            o += 1u;
                            sv[j] += Avg(Avg(RefChromaAt(r, aa + o), RefChromaAt(r, ab + o)), Avg(RefChromaAt(r, ba + o), RefChromaAt(r, bb + o))) * w;
                        }
                    }
                } else {
                    uint a = ChromaAddr(Xc, Yc);
                    [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
                        if (j < jEnd) {
                            uint o = a + uint(j) * rowC;
                            su[j] += RefChromaAt(r, o) * w;
                            sv[j] += RefChromaAt(r, o + 1u) * w;
                        }
                    }
                }
            }

            if (valid) {
                if ((pc.overlap | pc.overlapY) == 0) {
                    [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
                        au[j] = su[j] >> 8u;
                        av[j] = sv[j] >> 8u;
                    }
                } else {
                    int w0 = WindowAt(bx, by, Bx, By, dx, dy);
                    [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
                        if (j < jEnd) {
                            uint t = uint(tables[w0 + j * Bx]);
                            au[j] += ((su[j] >> 8u) * t) >> 6u;
                            av[j] += ((sv[j] >> 8u) * t) >> 6u;
                        }
                    }
                }
            }
        }

        [[unroll]] for (int j = 0; j < kChunkUV; ++j) {
            if (j < n) {
                bool ov = (pc.overlap | pc.overlapY) != 0;
                uint pu = ov ? min((au[j] + 16u) >> 5u, uint(pc.pixelMax)) : au[j];
                uint pv = ov ? min((av[j] + 16u) >> 5u, uint(pc.pixelMax)) : av[j];
                if (pc.limit >= 0) {
                    pu = Limit(pu, cu[j]);
                    pv = Limit(pv, cv[j]);
                }
                uint o = out0 + uint((j0 + j) * pc.outStride);
                if (kWide) {
                    if (DoU())
                        outPlane16[1].px[o] = uint16_t(pu);
                    if (DoV())
                        outPlane16[2].px[o] = uint16_t(pv);
                } else {
                    if (DoU())
                        outPlane[1].px[o] = uint8_t(pu);
                    if (DoV())
                        outPlane[2].px[o] = uint8_t(pv);
                }
            }
        }
    }
}

// pc.plane 0 makes luma, else the chroma planes its bits say (Degrain.cpp)
void main() {
    if (pc.plane != 0) {
        if (kFloat)
            MainFloatUV();
        else if (Quad())
            Main4UV();
        else
            MainUV();
        return;
    }
    if (kFloat)
        MainFloat();
    else if (Quad())
        Main4();
    else
        MainLuma();
}
