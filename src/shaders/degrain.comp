#version 460
#extension GL_GOOGLE_include_directive : require
#include "degrain_common.glsl"

layout(local_size_x = 64) in;

// The same planes as words, for Main4's four bytes at a time
layout(std430, set = 0, binding = 0) readonly buffer CurLuma32 { uint curY32[]; };
layout(std430, set = 0, binding = 1) readonly buffer CurChroma32 { uint curC32[]; };
layout(std430, set = 0, binding = 5) writeonly buffer Out32 { uint px[]; } outPlane32[3];
layout(std430, set = 0, binding = 6) readonly buffer RefLuma32 { uint px[]; } refY32[kMaxRefs];
layout(std430, set = 0, binding = 7) readonly buffer RefChroma32 { uint px[]; } refC32[kMaxRefs];

// The rounded average mvu.Super's quarter planes take of two samples
uint Avg(uint a, uint b) {
    return (a + b + 1u) >> 1u;
}

// A sample of the centre's luma or chroma planes, or of reference r's, bytes or 16 bits (kWide)
uint CurLumaAt(uint i) {
    return kWide ? uint(curY16[i]) : uint(curY[i]);
}
uint CurChromaAt(uint i) {
    return kWide ? uint(curC16[i]) : uint(curC[i]);
}
uint RefLumaAt(int r, uint i) {
    return kWide ? uint(refY16[r].px[i]) : uint(refY[r].px[i]);
}
uint RefChromaAt(int r, uint i) {
    return kWide ? uint(refC16[r].px[i]) : uint(refC[r].px[i]);
}

// mvu.Super's float AveragePixels, (a + b) * 0.5
float AvgF(float a, float b) {
    precise float s = a + b;
    return s * 0.5;
}

// The address of sample (Xh, Yh) of the half-pel grid of a plane with rows stride samples apart,
// its four half-pel planes rows rows each
uint HalfAddrOf(int Xh, int Yh, int stride, int rows) {
    return uint((Xh & 1) | ((Yh & 1) << 1)) * uint(stride * rows) + uint((Yh >> 1) * stride + (Xh >> 1));
}

// Luma's, in its padded planes
uint HalfAddr(int Xh, int Yh) {
    return HalfAddrOf(Xh, Yh, pc.wp, pc.hp);
}

// U's address of chroma position (Xc, Yc), 1 / pel pixels of the padded plane: in its quarter-pel
// image (subsampled at pel 4, SuperLayout.h), else in one of its four half-pel planes, the position
// on the half-pel grid (4:4:4 at pel 4 is read between those as luma is), or at pel 1 in its
// full-pel plane; V's is kChromaPlanes plane sizes on
uint ChromaAddr(int Xc, int Yc) {
    if (kPel == 1)
        return uint(Yc * pc.wc + Xc);
    if (kImage)
        return uint(Yc * 4 * pc.wc + Xc);
    return HalfAddrOf(Xc, Yc, pc.wc, pc.hc);
}

// Samples from a chroma pixel to the one below it: a row of the full-pel plane, four of the image
int ChromaRow() {
    return kImage ? 16 * pc.wc : pc.wc;
}

// Rows a lane holds at once: a 32-row block's cell row goes in two, which keeps the registers 16 x 16
// blocks take
const int kChunk = kBlk > 16 ? 16 : kBlk;

// The range ValidateVectors accepts for block (bx, by)'s vector, the block inside the padded planes;
// vectors from mvgpu.Analyse are always inside it, so this only guards the reads
ivec2 ClampVec(ivec2 v, int bx, int by) {
    int gX = bx * pc.step, gY = by * pc.step;
    return ivec2(clamp(v.x, -kPel * (gX + pc.pad), kPel * ((pc.nbx - 1) * pc.step + pc.pad - gX) - 1),
                 clamp(v.y, -kPel * (gY + pc.pad), kPel * ((pc.nby - 1) * pc.step + pc.pad - gY) - 1));
}

// mvu.Degrain for one plane. A lane is one pixel column of a cell row: the rows between two
// block rows, step of them (chroma's subsampling halving it), the last cell row also the rows below
// it its blocks reach. Every pixel of it lies in the same block columns, one or, inside the overlap,
// two, and in the same two block rows, the upper one covering only the first overlap rows. Each
// block gives the pixel mvu's degrained value, (128 + centre * its weight + the sum of each
// reference's motion compensated pixel * its weight) >> 8, and the pixel adds those up weighted by
// the blocks' overlap windows (mvu's OverlapWindows, the 9 of them for the frame's edges and corners,
// values to 2048, each product >> 6), then (sum + 16) >> 5, clamped to the clip's largest value;
// without overlap a pixel's one block gives it its value. limit then keeps it within that of the
// centre's pixel, and within the sample type's range (mvu's LimitChanges: 255 or 65535, whatever the
// bit depth).
//
// The motion compensated pixel is read from the reference's super where its vector puts the block,
// mvu's GetPointer: luma at pel 1 from its full-pel plane, at pel 2 from its half-pel plane; at pel 4
// computed from the half-pel planes
// exactly as mvu.Super's quarter planes hold it (refine_qpel.comp); chroma at the luma position
// shifted by its subsampling, rounded down: subsampled from its half-pel planes or quarter-pel image,
// 4:4:4 as luma is. A lane holds kChunk rows at a time. Dispatched as ((width + 63) / 64, nby)
// workgroups.
//
// Float clips take mvu's float arithmetic operation for operation (Degrain_F32, overlaps_c,
// ToPixels, LimitChanges_C; precise, so nothing is fused): a block's value the centre's pixel times
// its weight plus each reference's times its own, in order, then / 256; the windows' products / 64
// added up in mvu's order, the row above before the block's own and the left column first; then
// / 32, unclamped. A reference without vectors, out of the clip or at a scene change gives the
// centre's pixel with weight 0, and none is skipped: a zero product can still turn a sum's sign.
void MainFloat() {
    bool luma = pc.plane == 0;
    int lx = luma ? 0 : kLogX, ly = luma ? 0 : kLogY;
    int Bx = kBlk >> lx, By = kBlk >> ly;
    int Sx = pc.step >> lx, Sy = pc.step >> ly;
    int Ox = pc.overlap >> lx, Oy = pc.overlap >> ly;
    int x = int(gl_GlobalInvocationID.x), cy = int(gl_WorkGroupID.y);
    int y0 = cy * Sy;
    int rows = min(cy == pc.nby - 1 ? By : Sy, pc.height - y0);
    if (x >= pc.width || rows <= 0)
        return;
    uint vOffset = pc.plane == 2 ? uint(kChromaPlanes * pc.wc * pc.hc) : 0u;
    uint curC0 = kImage ? uint(16 * (pc.padc + y0) * pc.wc + 4 * (pc.padc + x)) : uint((pc.padc + y0) * pc.wc + pc.padc + x);
    uint cur = luma ? uint((pc.pad + y0) * pc.wp + pc.pad + x) : curC0 + vOffset;
    uint curStride = uint(luma ? pc.wp : ChromaRow());
    uint out0 = uint(y0 * pc.outStride + x);
    int bxA = min(x / Sx, pc.nbx - 1);
    bool hasLeft = bxA >= 1 && x < bxA * Sx + Ox;

    for (int j0 = 0; j0 < rows; j0 += kChunk) {
        int n = min(kChunk, rows - j0);
        float centre[kChunk], acc[kChunk];
        [[unroll]] for (int j = 0; j < kChunk; ++j) {
            centre[j] = j < n ? (luma ? curYF[cur + uint(j0 + j) * curStride] : curCF[cur + uint(j0 + j) * curStride]) : 0.0;
            acc[j] = 0.0;
        }
        for (int k = 3; k >= 0; --k) {
            int bx = (k & 1) != 0 ? bxA - 1 : bxA, by = (k & 2) != 0 ? cy - 1 : cy;
            int jEnd = (k & 2) != 0 ? clamp(Oy - j0, 0, n) : n;
            if (!(((k & 1) == 0 || hasLeft) && ((k & 2) == 0 || cy >= 1) && jEnd > 0))
                continue;
            int b = by * pc.nbx + bx;
            uint shift = luma ? 0u : 16u;
            float wc = float((meta[b] >> shift) & 0xFFFFu);
            float sum[kChunk];
            [[unroll]] for (int j = 0; j < kChunk; ++j) {
                precise float s = centre[j] * wc;
                sum[j] = s;
            }
            int dx = x - bx * Sx, dy = y0 + j0 - by * Sy;
            for (int r = 0; r < pc.refs; ++r) {
                float w = float((meta[(1 + r) * pc.nb + b] >> shift) & 0xFFFFu);
                float px[kChunk];
                [[unroll]] for (int j = 0; j < kChunk; ++j)
                    px[j] = centre[j];
                if (Usable(r) && counts[r] <= uint(pc.scdLimit)) {
                    ivec2 v = ClampVec(Record(r, bx, by).xy, bx, by);
                    if (luma && kPel == 4) {
                        int X = 4 * (bx * Sx + pc.pad + dx) + v.x, Y = 4 * (by * Sy + pc.pad + dy) + v.y;
                        int Xa = X >> 1, Xb = Xa + (X & 1), Ya = Y >> 1, Yb = Ya + (Y & 1);
                        uint aa = HalfAddr(Xa, Ya), ab = HalfAddr(Xa, Yb), ba = HalfAddr(Xb, Ya), bb = HalfAddr(Xb, Yb);
                        [[unroll]] for (int j = 0; j < kChunk; ++j) {
                            uint o = uint(j * pc.wp);
                            if (j < jEnd)
                                px[j] = AvgF(AvgF(refYF[r].px[aa + o], refYF[r].px[ab + o]), AvgF(refYF[r].px[ba + o], refYF[r].px[bb + o]));
                        }
                    } else if (luma) {
                        int X = kPel * (bx * Sx + pc.pad + dx) + v.x, Y = kPel * (by * Sy + pc.pad + dy) + v.y;
                        uint a = kPel == 1 ? uint(Y * pc.wp + X) : HalfAddr(X, Y);
                        [[unroll]] for (int j = 0; j < kChunk; ++j)
                            if (j < jEnd)
                                px[j] = refYF[r].px[a + uint(j * pc.wp)];
                    } else {
                        int Xc = kPel * (pc.padc + dx) + ((kPel * bx * pc.step + v.x) >> kLogX);
                        int Yc = kPel * (pc.padc + dy) + ((kPel * by * pc.step + v.y) >> kLogY);
                        if (kPel == 4 && !kImage) {
                            int Xa = Xc >> 1, Xb = Xa + (Xc & 1), Ya = Yc >> 1, Yb = Ya + (Yc & 1);
                            uint aa = HalfAddrOf(Xa, Ya, pc.wc, pc.hc) + vOffset, ab = HalfAddrOf(Xa, Yb, pc.wc, pc.hc) + vOffset;
                            uint ba = HalfAddrOf(Xb, Ya, pc.wc, pc.hc) + vOffset, bb = HalfAddrOf(Xb, Yb, pc.wc, pc.hc) + vOffset;
                            [[unroll]] for (int j = 0; j < kChunk; ++j) {
                                uint o = uint(j * pc.wc);
                                if (j < jEnd)
                                    px[j] = AvgF(AvgF(refCF[r].px[aa + o], refCF[r].px[ab + o]), AvgF(refCF[r].px[ba + o], refCF[r].px[bb + o]));
                            }
                        } else {
                            uint a = ChromaAddr(Xc, Yc) + vOffset;
                            [[unroll]] for (int j = 0; j < kChunk; ++j)
                                if (j < jEnd)
                                    px[j] = refCF[r].px[a + uint(j * ChromaRow())];
                        }
                    }
                }
                [[unroll]] for (int j = 0; j < kChunk; ++j) {
                    precise float t = px[j] * w;
                    precise float s = sum[j] + t;
                    sum[j] = s;
                }
            }
            [[unroll]] for (int j = 0; j < kChunk; ++j) {
                if (j < jEnd) {
                    precise float value = sum[j] * (1.0 / 256.0);
                    if (pc.overlap == 0) {
                        acc[j] = value;
                    } else {
                        int wbx = bx == pc.nbx - 1 ? 2 : (bx == 0 ? 0 : 1);
                        int wby = by == 0 ? 0 : (by == pc.nby - 1 ? 6 : 3);
                        float win = float(tables[pc.winOff + ((wby + wbx) * By + dy + j) * Bx + dx]);
                        precise float t = value * win;
                        precise float u = t * (1.0 / 64.0);
                        precise float a = acc[j] + u;
                        acc[j] = a;
                    }
                }
            }
        }

        [[unroll]] for (int j = 0; j < kChunk; ++j) {
            if (j < n) {
                precise float v = pc.overlap == 0 ? acc[j] : acc[j] * (1.0 / 32.0);
                if (pc.limit >= 0) {
                    precise float lo = centre[j] - pc.limitF;
                    precise float hi = centre[j] + pc.limitF;
                    v = v < lo ? lo : (hi < v ? hi : v); // std::clamp
                }
                outPlaneF[pc.plane].px[out0 + uint((j0 + j) * pc.outStride)] = v;
            }
        }
    }
}

// Four bytes from byte a on, of words w0 (holding byte a) and w1 (the next): funnel shifted
uint Bytes4At(uint w0, uint w1, uint a) {
    uint s = (a & 3u) * 8u;
    return s == 0u ? w0 : (w0 >> s) | (w1 << (32u - s));
}
uvec4 Unpack4(uint w) {
    return uvec4(w & 0xFFu, (w >> 8u) & 0xFFu, (w >> 16u) & 0xFFu, w >> 24u);
}
// Four bytes of the centre's or reference r's luma or chroma from byte a; the planes' spare rows
// (SuperLayout.h) keep the word after the last pixel inside the buffer
uint CurLuma4(uint a) {
    uint i = a >> 2u;
    return Bytes4At(curY32[i], curY32[i + 1u], a);
}
uint CurChroma4(uint a) {
    uint i = a >> 2u;
    return Bytes4At(curC32[i], curC32[i + 1u], a);
}
uint RefLuma4(int r, uint a) {
    uint i = a >> 2u;
    return Bytes4At(refY32[r].px[i], refY32[r].px[i + 1u], a);
}
uint RefChroma4(int r, uint a) {
    uint i = a >> 2u;
    return Bytes4At(refC32[r].px[i], refC32[r].px[i + 1u], a);
}

// Rows a lane of Main4 holds at once
const int kChunk4 = 8;

// main's arithmetic for four adjacent pixels per lane, 8-bit samples at pel 1 or 2, where the
// plane's step and overlap are multiples of 4 (Degrain.cpp sets pc.quad): the four then lie in
// the same blocks, their reference pixels four bytes in a row of one plane, read as words.
// Dispatched as ((width + 255) / 256, nby) workgroups.
void Main4() {
    bool luma = pc.plane == 0;
    int lx = luma ? 0 : kLogX, ly = luma ? 0 : kLogY;
    int Bx = kBlk >> lx, By = kBlk >> ly;
    int Sx = pc.step >> lx, Sy = pc.step >> ly;
    int Ox = pc.overlap >> lx, Oy = pc.overlap >> ly;
    int x = 4 * int(gl_GlobalInvocationID.x), cy = int(gl_WorkGroupID.y);
    int y0 = cy * Sy;
    int rows = min(cy == pc.nby - 1 ? By : Sy, pc.height - y0);
    if (x >= pc.width || rows <= 0)
        return;
    int inside = min(4, pc.width - x); // the group's pixels inside the plane
    uint vOffset = pc.plane == 2 ? uint(kChromaPlanes * pc.wc * pc.hc) : 0u;
    uint cur = luma ? uint((pc.pad + y0) * pc.wp + pc.pad + x) : uint((pc.padc + y0) * pc.wc + pc.padc + x) + vOffset;
    uint curStride = uint(luma ? pc.wp : pc.wc);
    uint out0 = uint(y0 * pc.outStride + x);
    int bxA = min(x / Sx, pc.nbx - 1);
    bool hasLeft = bxA >= 1 && x < bxA * Sx + Ox;

    for (int j0 = 0; j0 < rows; j0 += kChunk4) {
        int n = min(kChunk4, rows - j0);
        uint centre[kChunk4];
        uvec4 acc[kChunk4];
        [[unroll]] for (int j = 0; j < kChunk4; ++j) {
            uint a = cur + uint(j0 + j) * curStride;
            centre[j] = j < n ? (luma ? CurLuma4(a) : CurChroma4(a)) : 0u;
            acc[j] = uvec4(0u);
        }

        for (int k = 0; k < 4; ++k) {
            int bx = (k & 1) != 0 ? bxA - 1 : bxA, by = (k & 2) != 0 ? cy - 1 : cy;
            int jEnd = (k & 2) != 0 ? clamp(Oy - j0, 0, n) : n;
            bool valid = ((k & 1) == 0 || hasLeft) && ((k & 2) == 0 || cy >= 1) && jEnd > 0;
            int b = valid ? by * pc.nbx + bx : 0;
            uint shift = luma ? 0u : 16u;
            uvec4 sum[kChunk4];
            uint wc = valid ? (meta[b] >> shift) & 0xFFFFu : 0u;
            [[unroll]] for (int j = 0; j < kChunk4; ++j)
                sum[j] = uvec4(128u) + Unpack4(centre[j]) * wc;
            int dx = x - bx * Sx, dy = y0 + j0 - by * Sy;

            for (int r = 0; r < pc.refs; ++r) {
                uint w = valid ? (meta[(1 + r) * pc.nb + b] >> shift) & 0xFFFFu : 0u;
                if (w == 0u)
                    continue;
                ivec2 v = ClampVec(Record(r, bx, by).xy, bx, by);
                if (luma) {
                    int X = kPel * (bx * Sx + pc.pad + dx) + v.x, Y = kPel * (by * Sy + pc.pad + dy) + v.y;
                    uint a = kPel == 1 ? uint(Y * pc.wp + X) : HalfAddr(X, Y);
                    [[unroll]] for (int j = 0; j < kChunk4; ++j)
                        if (j < jEnd)
                            sum[j] += Unpack4(RefLuma4(r, a + uint(j * pc.wp))) * w;
                } else {
                    int Xc = kPel * (pc.padc + dx) + ((kPel * bx * pc.step + v.x) >> kLogX);
                    int Yc = kPel * (pc.padc + dy) + ((kPel * by * pc.step + v.y) >> kLogY);
                    uint a = ChromaAddr(Xc, Yc) + vOffset;
                    [[unroll]] for (int j = 0; j < kChunk4; ++j)
                        if (j < jEnd)
                            sum[j] += Unpack4(RefChroma4(r, a + uint(j * pc.wc))) * w;
                }
            }

            if (valid) {
                if (pc.overlap == 0) {
                    [[unroll]] for (int j = 0; j < kChunk4; ++j)
                        acc[j] = sum[j] >> 8u;
                } else {
                    int wbx = bx == pc.nbx - 1 ? 2 : (bx == 0 ? 0 : 1);
                    int wby = by == 0 ? 0 : (by == pc.nby - 1 ? 6 : 3);
                    int win = pc.winOff + ((wby + wbx) * By + dy) * Bx + dx;
                    [[unroll]] for (int j = 0; j < kChunk4; ++j) {
                        if (j < jEnd) {
                            int t = win + j * Bx;
                            uvec4 w4 = uvec4(uint(tables[t]), uint(tables[t + 1]), uint(tables[t + 2]), uint(tables[t + 3]));
                            acc[j] += ((sum[j] >> 8u) * w4) >> 6u;
                        }
                    }
                }
            }
        }

        [[unroll]] for (int j = 0; j < kChunk4; ++j) {
            if (j < n) {
                uvec4 p = pc.overlap == 0 ? acc[j] : min((acc[j] + 16u) >> 5u, uvec4(uint(pc.pixelMax)));
                if (pc.limit >= 0) {
                    ivec4 c = ivec4(Unpack4(centre[j]));
                    p = uvec4(clamp(ivec4(p), max(c - pc.limit, ivec4(0)), min(c + pc.limit, ivec4(255))));
                }
                uint o = out0 + uint((j0 + j) * pc.outStride);
                if (inside == 4 && (o & 3u) == 0u) {
                    outPlane32[pc.plane].px[o >> 2u] = p.x | (p.y << 8u) | (p.z << 16u) | (p.w << 24u);
                } else {
                    [[unroll]] for (int i = 0; i < 4; ++i)
                        if (i < inside)
                            outPlane[pc.plane].px[o + uint(i)] = uint8_t(p[i]);
                }
            }
        }
    }
}

void main() {
    if (kFloat) {
        MainFloat();
        return;
    }
    if (pc.quad != 0) {
        Main4();
        return;
    }
    bool luma = pc.plane == 0;
    int lx = luma ? 0 : kLogX, ly = luma ? 0 : kLogY;
    int Bx = kBlk >> lx, By = kBlk >> ly;                     // the plane's block size,
    int Sx = pc.step >> lx, Sy = pc.step >> ly;               // step
    int Ox = pc.overlap >> lx, Oy = pc.overlap >> ly;         // and overlap
    int x = int(gl_GlobalInvocationID.x), cy = int(gl_WorkGroupID.y);
    int y0 = cy * Sy;
    int rows = min(cy == pc.nby - 1 ? By : Sy, pc.height - y0);
    if (x >= pc.width || rows <= 0)
        return;
    uint vOffset = pc.plane == 2 ? uint(kChromaPlanes * pc.wc * pc.hc) : 0u;

    // The centre's pixels, from the centre super's full-pel samples (subsampled chroma at pel 4:
    // every fourth of every fourth row of its image)
    uint curC0 = kImage ? uint(16 * (pc.padc + y0) * pc.wc + 4 * (pc.padc + x)) : uint((pc.padc + y0) * pc.wc + pc.padc + x);
    uint cur = luma ? uint((pc.pad + y0) * pc.wp + pc.pad + x) : curC0 + vOffset;
    uint curStride = uint(luma ? pc.wp : ChromaRow());
    uint out0 = uint(y0 * pc.outStride + x);
    int bxA = min(x / Sx, pc.nbx - 1);
    bool hasLeft = bxA >= 1 && x < bxA * Sx + Ox;

    // The rows kChunk at a time
    for (int j0 = 0; j0 < rows; j0 += kChunk) {
        int n = min(kChunk, rows - j0);
        uint centre[kChunk], acc[kChunk];
        [[unroll]] for (int j = 0; j < kChunk; ++j) {
            centre[j] = j < n ? (luma ? CurLumaAt(cur + uint(j0 + j) * curStride) : CurChromaAt(cur + uint(j0 + j) * curStride)) : 0u;
            acc[j] = 0u;
        }

        // The (up to) four blocks: k & 1 the column to the left, k & 2 the row above, which covers
        // only the cell row's first overlap rows
        for (int k = 0; k < 4; ++k) {
            int bx = (k & 1) != 0 ? bxA - 1 : bxA, by = (k & 2) != 0 ? cy - 1 : cy;
            int jEnd = (k & 2) != 0 ? clamp(Oy - j0, 0, n) : n;
            bool valid = ((k & 1) == 0 || hasLeft) && ((k & 2) == 0 || cy >= 1) && jEnd > 0;
            int b = valid ? by * pc.nbx + bx : 0;
            uint shift = luma ? 0u : 16u;
            uint sum[kChunk];
            uint wc = valid ? (meta[b] >> shift) & 0xFFFFu : 0u;
            [[unroll]] for (int j = 0; j < kChunk; ++j)
                sum[j] = 128u + centre[j] * wc;
            int dx = x - bx * Sx, dy = y0 + j0 - by * Sy; // the lane's place in the block at the chunk's first row

            for (int r = 0; r < pc.refs; ++r) {
                uint w = valid ? (meta[(1 + r) * pc.nb + b] >> shift) & 0xFFFFu : 0u;
                if (w == 0u)
                    continue;
                ivec2 v = ClampVec(Record(r, bx, by).xy, bx, by);
                if (luma && kPel == 4) {
                    int X = 4 * (bx * Sx + pc.pad + dx) + v.x, Y = 4 * (by * Sy + pc.pad + dy) + v.y;
                    int Xa = X >> 1, Xb = Xa + (X & 1), Ya = Y >> 1, Yb = Ya + (Y & 1);
                    uint aa = HalfAddr(Xa, Ya), ab = HalfAddr(Xa, Yb), ba = HalfAddr(Xb, Ya), bb = HalfAddr(Xb, Yb);
                    [[unroll]] for (int j = 0; j < kChunk; ++j) {
                        if (j < jEnd) {
                            uint o = uint(j * pc.wp);
                            uint p = Avg(Avg(RefLumaAt(r, aa + o), RefLumaAt(r, ab + o)), Avg(RefLumaAt(r, ba + o), RefLumaAt(r, bb + o)));
                            sum[j] += p * w;
                        }
                    }
                } else if (luma) {
                    int X = kPel * (bx * Sx + pc.pad + dx) + v.x, Y = kPel * (by * Sy + pc.pad + dy) + v.y;
                    uint a = kPel == 1 ? uint(Y * pc.wp + X) : HalfAddr(X, Y);
                    [[unroll]] for (int j = 0; j < kChunk; ++j)
                        if (j < jEnd)
                            sum[j] += RefLumaAt(r, a + uint(j * pc.wp)) * w;
                } else {
                    // Chroma at the luma position shifted by the subsampling, rounded down
                    // (GetPointer(blx >> xSubUV, bly >> ySubUV))
                    int Xc = kPel * (pc.padc + dx) + ((kPel * bx * pc.step + v.x) >> kLogX);
                    int Yc = kPel * (pc.padc + dy) + ((kPel * by * pc.step + v.y) >> kLogY);
                    if (kPel == 4 && !kImage) {
                        // 4:4:4 at pel 4: from the half-pel planes, as luma
                        int Xa = Xc >> 1, Xb = Xa + (Xc & 1), Ya = Yc >> 1, Yb = Ya + (Yc & 1);
                        uint aa = HalfAddrOf(Xa, Ya, pc.wc, pc.hc) + vOffset, ab = HalfAddrOf(Xa, Yb, pc.wc, pc.hc) + vOffset;
                        uint ba = HalfAddrOf(Xb, Ya, pc.wc, pc.hc) + vOffset, bb = HalfAddrOf(Xb, Yb, pc.wc, pc.hc) + vOffset;
                        [[unroll]] for (int j = 0; j < kChunk; ++j) {
                            if (j < jEnd) {
                                uint o = uint(j * pc.wc);
                                uint p = Avg(Avg(RefChromaAt(r, aa + o), RefChromaAt(r, ab + o)), Avg(RefChromaAt(r, ba + o), RefChromaAt(r, bb + o)));
                                sum[j] += p * w;
                            }
                        }
                    } else {
                        uint a = ChromaAddr(Xc, Yc) + vOffset;
                        [[unroll]] for (int j = 0; j < kChunk; ++j)
                            if (j < jEnd)
                                sum[j] += RefChromaAt(r, a + uint(j * ChromaRow())) * w;
                    }
                }
            }

            if (valid) {
                if (pc.overlap == 0) {
                    [[unroll]] for (int j = 0; j < kChunk; ++j)
                        acc[j] = sum[j] >> 8u;
                } else {
                    int wbx = bx == pc.nbx - 1 ? 2 : (bx == 0 ? 0 : 1);
                    int wby = by == 0 ? 0 : (by == pc.nby - 1 ? 6 : 3);
                    int win = pc.winOff + ((wby + wbx) * By + dy) * Bx + dx;
                    [[unroll]] for (int j = 0; j < kChunk; ++j)
                        if (j < jEnd)
                            acc[j] += ((sum[j] >> 8u) * uint(tables[win + j * Bx])) >> 6u;
                }
            }
        }

        [[unroll]] for (int j = 0; j < kChunk; ++j) {
            if (j < n) {
                uint p = pc.overlap == 0 ? acc[j] : min((acc[j] + 16u) >> 5u, uint(pc.pixelMax));
                if (pc.limit >= 0)
                    p = uint(clamp(int(p), max(int(centre[j]) - pc.limit, 0), min(int(centre[j]) + pc.limit, kWide ? 65535 : 255)));
                uint o = out0 + uint((j0 + j) * pc.outStride);
                if (kWide)
                    outPlane16[pc.plane].px[o] = uint16_t(p);
                else
                    outPlane[pc.plane].px[o] = uint8_t(p);
            }
        }
    }
}
