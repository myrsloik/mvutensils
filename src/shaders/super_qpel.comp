#version 460
#extension GL_GOOGLE_include_directive : require
#include "super_common.glsl"

layout(local_size_x = 64) in;

// pel 4, subsampled chroma: the planes' quarter-pel image (SuperLayout.h), whole, from the frame,
// holding exactly mvu.Super's sixteen planes of U and of V (SuperPyramid.cpp's CopyAndPadPlane,
// GeneratePelPlanes and GeneratePelQuarters, whatever sharp): the padded full-pel samples, the
// half-pel ones by the sharp filter as super.comp makes luma's (the diagonal from the y + 1/2
// samples, or bilinear from the full-pel ones), and every quarter sample the rounded average of two
// neighbours on the half-pel grid, the diagonal ones of two vertical averages. Written at binding 2,
// U and V interleaved sample by sample, rows 8 pc.wc samples apart (4 pc.wc places), 4 pc.hc rows.
// This chroma is materialized at pel 4 while luma isn't: with the luma vectors on the half-pel grid
// until the quarter-pel step, chroma, at half the resolution, lands between that grid's samples
// wherever a luma vector has a half pel, and computing those in every pass cost more than storing
// them. The last column's x + 3/4 samples and the last row's y + 3/4 samples, which mvu leaves
// unset, get what the clamped reads give; no vector reaches them.
//
// A workgroup makes a row y of 256 pixels: it reads the padded full-pel rows y - 2 .. y + 3 of U and
// of V around them from the frame into shared memory, makes row y's y + 1/2 samples there, and each
// lane makes the sixteen samples of U and of V of 4 pixels 64 apart, writing the image's 4 rows of
// them whole, two groups of four per pixel and row (U's and V's samples alternating), so that the
// lanes read neighbouring shared samples and write neighbouring groups. It reads only the frame, so
// nothing it writes is read meanwhile. Dispatched as ((W + 255) / 256, H) with W x H the padded
// chroma size.

const int kCols = 264;          // the shared columns: x0 - 4 .. x0 + 259, the row's 256 pixels and the filters' reach
shared uint sFull[2][6][kCols]; // U's and V's padded full-pel rows y - 2 .. y + 3, clamped to the plane, as sample bits
shared uint sHalf[2][kCols];    // and their row y's y + 1/2 samples

int gW, gH; // the padded plane

// Shared row r of plane p (0 U, 1 V), sFull's 0 .. 5 (y - 2 .. y + 3) or sHalf as 6, at shared column i
int SI(int p, int r, int i) {
    return int(r == 6 ? sHalf[p][i] : sFull[p][r][i]);
}
float SF(int p, int r, int i) {
    return uintBitsToFloat(r == 6 ? sHalf[p][i] : sFull[p][r][i]);
}

// The horizontal filter of shared row r at shared column i, plane column c
int HorizontalI(int p, int r, int i, int c) {
    int mode = Mode(c, gW);
    if (mode == 0)
        return SI(p, r, i);
    if (mode == 1)
        return AvgI(SI(p, r, i), SI(p, r, i + 1));
    if (pc.sharp == 1)
        return BicubicI(SI(p, r, i - 1), SI(p, r, i), SI(p, r, i + 1), SI(p, r, i + 2));
    return WienerI(SI(p, r, i - 2), SI(p, r, i - 1), SI(p, r, i), SI(p, r, i + 1), SI(p, r, i + 2), SI(p, r, i + 3));
}
float HorizontalF(int p, int r, int i, int c) {
    int mode = Mode(c, gW);
    if (mode == 0)
        return SF(p, r, i);
    if (mode == 1)
        return AvgF(SF(p, r, i), SF(p, r, i + 1));
    if (pc.sharp == 1)
        return BicubicF(SF(p, r, i - 1), SF(p, r, i), SF(p, r, i + 1), SF(p, r, i + 2));
    return WienerF(SF(p, r, i - 2), SF(p, r, i - 1), SF(p, r, i), SF(p, r, i + 1), SF(p, r, i + 2), SF(p, r, i + 3));
}

// The vertical one at shared column i for row y
int VerticalI(int p, int i, int y) {
    int mode = Mode(y, gH);
    if (mode == 0)
        return SI(p, 2, i);
    if (mode == 1)
        return AvgI(SI(p, 2, i), SI(p, 3, i));
    if (pc.sharp == 1)
        return BicubicI(SI(p, 1, i), SI(p, 2, i), SI(p, 3, i), SI(p, 4, i));
    return WienerI(SI(p, 0, i), SI(p, 1, i), SI(p, 2, i), SI(p, 3, i), SI(p, 4, i), SI(p, 5, i));
}
float VerticalF(int p, int i, int y) {
    int mode = Mode(y, gH);
    if (mode == 0)
        return SF(p, 2, i);
    if (mode == 1)
        return AvgF(SF(p, 2, i), SF(p, 3, i));
    if (pc.sharp == 1)
        return BicubicF(SF(p, 1, i), SF(p, 2, i), SF(p, 3, i), SF(p, 4, i));
    return WienerF(SF(p, 0, i), SF(p, 1, i), SF(p, 2, i), SF(p, 3, i), SF(p, 4, i), SF(p, 5, i));
}

// DiagonalBilinear (sharp 0) at shared column i, plane column c, of row y: the average of four, of
// two along the last column and the last row, the last sample copied
int DiagonalI(int p, int i, int c, int y) {
    bool right = c >= gW - 1, bottom = y == gH - 1;
    int s = SI(p, 2, i), sx = SI(p, 2, i + 1), t = SI(p, 3, i), tx = SI(p, 3, i + 1);
    if (right && bottom)
        return s;
    if (bottom)
        return AvgI(s, sx);
    if (right)
        return AvgI(s, t);
    return Avg4I(s, sx, t, tx);
}
float DiagonalF(int p, int i, int c, int y) {
    bool right = c >= gW - 1, bottom = y == gH - 1;
    float s = SF(p, 2, i), sx = SF(p, 2, i + 1), t = SF(p, 3, i), tx = SF(p, 3, i + 1);
    if (right && bottom)
        return s;
    if (bottom)
        return AvgF(s, sx);
    if (right)
        return AvgF(s, t);
    return Avg4F(s, sx, t, tx);
}

// Plane p's sixteen samples of the pixel at shared column i, plane column c, of row y: q[fy] its
// phases fx = 0 .. 3 of quarter row fy, from its half-pel samples (p0 full-pel, p2 x + 1/2, p8
// y + 1/2, p10 both), the next row's (n, its row clamped) and the next pixel's (x)
void QuartersI(int p, int i, int c, int y, out ivec4 q[4]) {
    int p0 = SI(p, 2, i), p2 = HorizontalI(p, 2, i, c), p8 = SI(p, 6, i), p10 = pc.sharp == 0 ? DiagonalI(p, i, c, y) : HorizontalI(p, 6, i, c);
    int p0n = SI(p, 3, i), p2n = HorizontalI(p, 3, i, c), p0x = SI(p, 2, i + 1), p8x = SI(p, 6, i + 1), p0nx = SI(p, 3, i + 1);
    int d4 = AvgI(p0, p8), d6 = AvgI(p2, p10), d4x = AvgI(p0x, p8x);
    int d12 = AvgI(p0n, p8), d14 = AvgI(p2n, p10), d12x = AvgI(p0nx, p8x);
    q[0] = ivec4(p0, AvgI(p0, p2), p2, AvgI(p0x, p2));
    q[1] = ivec4(d4, AvgI(d4, d6), d6, AvgI(d4x, d6));
    q[2] = ivec4(p8, AvgI(p8, p10), p10, AvgI(p8x, p10));
    q[3] = ivec4(d12, AvgI(d12, d14), d14, AvgI(d12x, d14));
}
void QuartersF(int p, int i, int c, int y, out vec4 q[4]) {
    float p0 = SF(p, 2, i), p2 = HorizontalF(p, 2, i, c), p8 = SF(p, 6, i), p10 = pc.sharp == 0 ? DiagonalF(p, i, c, y) : HorizontalF(p, 6, i, c);
    float p0n = SF(p, 3, i), p2n = HorizontalF(p, 3, i, c), p0x = SF(p, 2, i + 1), p8x = SF(p, 6, i + 1), p0nx = SF(p, 3, i + 1);
    float d4 = AvgF(p0, p8), d6 = AvgF(p2, p10), d4x = AvgF(p0x, p8x);
    float d12 = AvgF(p0n, p8), d14 = AvgF(p2n, p10), d12x = AvgF(p0nx, p8x);
    q[0] = vec4(p0, AvgF(p0, p2), p2, AvgF(p0x, p2));
    q[1] = vec4(d4, AvgF(d4, d6), d6, AvgF(d4x, d6));
    q[2] = vec4(p8, AvgF(p8, p10), p10, AvgF(p8x, p10));
    q[3] = vec4(d12, AvgF(d12, d14), d14, AvgF(d12x, d14));
}

// The first of the two groups of quarter samples (0 .. 3, fy) of pixel x of row y, U's and V's
// alternating
uint Row(int fy, int x, int y) {
    return uint((4 * y + fy) * 8 * pc.wc + 8 * x) >> 2u;
}

void main() {
    int lane = int(gl_LocalInvocationID.x);
    gW = pc.aw / pc.xr + 2 * pc.padcX;
    gH = pc.ah / pc.yr + 2 * pc.padcY;
    int x0 = int(gl_WorkGroupID.x) * 256, y = int(gl_WorkGroupID.y);
    // The padded full-pel rows, as super.comp's step 0 makes them: the frame's samples these
    // positions repeat (columns past the plane's get its last, and the filters never use them)
    int realW = pc.w / pc.xr, realH = pc.h / pc.yr;
    for (int t = lane; t < 2 * 6 * kCols; t += 64) {
        int p = t / (6 * kCols), r = (t / kCols) % 6, i = t % kCols;
        int sy = clamp(clamp(y - 2 + r, 0, gH - 1) - pc.padcY, 0, realH - 1), sx = clamp(x0 - 4 + i - pc.padcX, 0, realW - 1);
        uint at = uint(sy * pc.srcStrideC + sx);
        int raw = p == 0 ? kRawU : kRawV;
        sFull[p][r][i] = kFloat ? floatBitsToUint(GetF(raw, at)) : uint(GetI(raw, at));
    }
    barrier();
    for (int t = lane; t < 2 * kCols; t += 64) {
        int p = t / kCols, i = t % kCols;
        sHalf[p][i] = kFloat ? floatBitsToUint(VerticalF(p, i, y)) : uint(VerticalI(p, i, y));
    }
    barrier();
    if (y >= gH)
        return;
    [[unroll]] for (int k = 0; k < 4; ++k) {
        int c = x0 + lane + 64 * k, i = 4 + lane + 64 * k;
        if (c >= gW)
            continue;
        if (kFloat) {
            vec4 u[4], v[4];
            QuartersF(0, i, c, y, u);
            QuartersF(1, i, c, y, v);
            [[unroll]] for (int fy = 0; fy < 4; ++fy) {
                uint g = Row(fy, c, y);
                Put4F(kChroma, g, vec4(u[fy].x, v[fy].x, u[fy].y, v[fy].y));
                Put4F(kChroma, g + 1u, vec4(u[fy].z, v[fy].z, u[fy].w, v[fy].w));
            }
        } else {
            ivec4 u[4], v[4];
            QuartersI(0, i, c, y, u);
            QuartersI(1, i, c, y, v);
            [[unroll]] for (int fy = 0; fy < 4; ++fy) {
                uint g = Row(fy, c, y);
                Put4I(kChroma, g, ivec4(u[fy].x, v[fy].x, u[fy].y, v[fy].y));
                Put4I(kChroma, g + 1u, ivec4(u[fy].z, v[fy].z, u[fy].w, v[fy].w));
            }
        }
    }
}
